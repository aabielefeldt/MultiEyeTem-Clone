#%%
# if qt is used as backend the kernel crashes
mne.viz.set_browser_backend('matplotlib')

#%%
df = pd.read_csv('../data/csv_files/df.csv')
good_partis = df['subID'].unique()

#%%
# create figures folder
figures_folder = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/figures"
data_foldername1 = f'pupil_size'
data_foldername2 = f'baseline_pupil_size'
csv_path1 = os.path.join(figures_folder, data_foldername1)
csv_path2 = os.path.join(figures_folder, data_foldername2)
os.makedirs(csv_path1, exist_ok=True)
