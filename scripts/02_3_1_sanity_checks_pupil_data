# plotting epochs per participant without averaging epochs per subID
# plotting all trials of all participants as lineplots to look at outliers and blinks and such
# for combined and uncombined pupils
# using plt (and not seaborn) because seaborn fills in brakes in the individual lines, basically interpolating missing data


# %% Load Metadata

df = pd.read_csv('../data/csv_files/df.csv')
good_partis = df['subID'].unique()


# not working with evokeds but only with epochs in here?
