# %%
# Importsconda
import mne
import pandas as pd

# %% Load Metadata

df = pd.read_csv('../data/csv_files/df.csv')
good_partis = df['subID'].unique()

# %% 
# if qt is used as backend the kernel crashes
mne.viz.set_browser_backend('matplotlib')

# %%
# appending all epochs into one dataframe and combining both pupil channels

evoked_df_test_onset = pd.DataFrame()

for i in good_partis:
    
    # reading epochs per participant
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Epochs_test_onset"
    epoch_file = folder_path + "/" + i + "-epo.fif"
    pupil_epoch = mne.read_epochs(epoch_file, preload=True, verbose=None)
    
    # combining channels
    pupil_ix = mne.pick_channels(pupil_epoch.info["ch_names"], include=['pupil_left', 'pupil_right'])
    roi_dict = dict(pupils=pupil_ix)
    pupil_epochs_combined = mne.channels.combine_channels(pupil_epoch, roi_dict, method="mean")

    # applying baseline
    pupil_epochs_combined_bl = pupil_epochs_combined.apply_baseline(baseline=(-6.5, -6))
    baseline = pupil_epochs_combined_bl.baseline

    # seperating per load condition
    con1_epochs = pupil_epochs_combined_bl["items_presented == 1"]
    con2_epochs = pupil_epochs_combined_bl["items_presented == 2"]
    con3_epochs = pupil_epochs_combined_bl["items_presented == 3"]

    # averaging per load condition
    con1_ave = con1_epochs.average()
    con2_ave = con2_epochs.average()
    con3_ave = con3_epochs.average()
    
    # adding individual averaged data to dataframe including load and subID
    con1_ave_df = con1_ave.to_data_frame()
    con1_ave_df['Load'] = 1
    con1_ave_df['subID'] = i
    con2_ave_df = con2_ave.to_data_frame()
    con2_ave_df['Load'] = 2
    con2_ave_df['subID'] = i
    con3_ave_df = con3_ave.to_data_frame()
    con3_ave_df['Load'] = 3
    con3_ave_df['subID'] = i

    # concatenating to evoked_df_test_onset
    evoked_df_test_onset = pd.concat([evoked_df_test_onset, con1_ave_df])
    evoked_df_test_onset = pd.concat([evoked_df_test_onset, con2_ave_df])
    evoked_df_test_onset = pd.concat([evoked_df_test_onset, con3_ave_df])
    evoked_df_test_onset['baseline_start'] = baseline[0]
    evoked_df_test_onset['baseline_end'] = baseline[1]

evoked_df_test_onset = evoked_df_test_onset.reset_index()

evoked_df_test_onset.to_csv('../data/csv_files/evoked_df_test_onset.csv', index=False)
