# %%
# Importsconda
import mne
import numpy as np
import pandas as pd
from datetime import datetime
import pingouin as pg
import seaborn as sns
import matplotlib.pyplot as plt

# %% Load Metadata

df = pd.read_csv('../data/df.csv')
good_partis = df['subID'].unique()
new_partis = np.delete(good_partis, np.where(good_partis == ['KJN4WD']))

# %%
# if qt is used as backend the kernel crashes
# this can probably be deleted once run, but might just keep in in to be safe
mne.viz.set_browser_backend('matplotlib')

# %%

# appending all epochs into one list and combining both pupil channels
con1_evoked_all_pp = []
con2_evoked_all_pp = []
con3_evoked_all_pp = []
con1_evoked_all_pp_list = []
con2_evoked_all_pp_list = []
con3_evoked_all_pp_list = []

all_con_evoked_pos1 = pd.DataFrame()

for i in good_partis:
    
    # /mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Epochs_data_2024-03-20_14:25 -- is the new path after changing the epochs baseline to None, 
    # ran epochs with 011_Epoching
    # differently sampled subID epochs are removed in this folder too (but kept in the copy of that folder)
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Epochs_pos1"

    epoch_file = folder_path + "/" + i + "_pos1-epo.fif"

    pupil_epoch = mne.read_epochs(epoch_file, preload=True, verbose=None)
    pupil_ix = mne.pick_channels(pupil_epoch.info["ch_names"], include=['pupil_left', 'pupil_right'])

    roi_dict = dict(pupils=pupil_ix)

    pupil_epochs_combined = mne.channels.combine_channels(pupil_epoch, roi_dict, method="mean")


    # APPLYING DIFFERENT BASELINES (SAVE FIG INDIVIDUALLY!!)
    # where do I need to save the fig accordingly?? 

    # can I just apply the same baseline to all? If pos1 is always 0, then the baseline is always -0.1 - 0.0
    pupil_epochs_combined_bl = pupil_epochs_combined.apply_baseline(baseline=(-0.1, 0))
    baseline = pupil_epochs_combined.baseline
    con1_epochs_pos1 = pupil_epochs_combined_bl["items_presented == 1"]
    con2_epochs_pos1 = pupil_epochs_combined_bl["items_presented == 2"]
    con3_epochs_pos1 = pupil_epochs_combined_bl["items_presented == 3"]

    # shortening the epochs based on condition (crop defaults to inclduing tmax)

    con1_epochs_pos1.crop(-0.1, 7)
    con2_epochs_pos1.crop(-0.1, 8)
    con3_epochs_pos1.crop(-0.1, 9)

    con1_ave_pos1 = con1_epochs_pos1.average()
    con2_ave_pos1 = con2_epochs_pos1.average()
    con3_ave_pos1 = con3_epochs_pos1.average()

    con1_evoked_all_pp.append(con1_ave_pos1)
    con2_evoked_all_pp.append(con2_ave_pos1)
    con3_evoked_all_pp.append(con3_ave_pos1)
    
    con1_ave_df_pos1 = con1_ave_pos1.to_data_frame()
    con1_ave_df_pos1['Load'] = 1
    con1_ave_df_pos1['subID'] = i
    con2_ave_df_pos1 = con2_ave_pos1.to_data_frame()
    con2_ave_df_pos1['Load'] = 2
    con2_ave_df_pos1['subID'] = i
    con3_ave_df_pos1 = con3_ave_pos1.to_data_frame()
    con3_ave_df_pos1['Load'] = 3
    con3_ave_df_pos1['subID'] = i

    con1_evoked_all_pp_list.append(con1_ave_df_pos1)
    con2_evoked_all_pp_list.append(con2_ave_df_pos1)
    con3_evoked_all_pp_list.append(con3_ave_df_pos1)
    
    
    # include the baseline in the df to make sure I am plotting correctly?

    all_con_evoked_pos1 = pd.concat([all_con_evoked_pos1, con1_ave_df_pos1])
    all_con_evoked_pos1 = pd.concat([all_con_evoked_pos1, con2_ave_df_pos1])
    all_con_evoked_pos1 = pd.concat([all_con_evoked_pos1, con3_ave_df_pos1])

    # need to change that to fit the individual baselines
    all_con_evoked_pos1['baseline_start'] = baseline[0]
    all_con_evoked_pos1['baseline_end'] = baseline[1]

all_pp_con1_pos1 = all_con_evoked_pos1.loc[all_con_evoked_pos1['Load']==1]
all_pp_con2_pos1 = all_con_evoked_pos1.loc[all_con_evoked_pos1['Load']==2]
all_pp_con3_pos1 = all_con_evoked_pos1.loc[all_con_evoked_pos1['Load']==3]


evoked_dict = {1: [con1_evoked_all_pp_list], 2: [con2_evoked_all_pp_list], 3: [con3_evoked_all_pp_list]}

all_con_evoked_pos1 = all_con_evoked_pos1.reset_index()

all_con_evoked_pos1.to_csv('../data/Tables_and_Dataframes/all_con_evoked_pos1.csv', index=False)

