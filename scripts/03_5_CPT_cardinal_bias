# %%
# Importsconda
import mne
import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt
from pupil_utils import apply_baseline_nan_aware
from scipy.stats import zscore
from mne.stats import permutation_cluster_test, f_oneway, permutation_cluster_1samp_test
from scipy import stats
from scipy.stats import t, ttest_rel, zscore, f
import pingouin as pg
import statsmodels.api as sm
import statsmodels.formula.api as smf

# %% Load Metadata

df = pd.read_csv('../data/csv_files/df.csv')
good_partis = df['subID'].unique()

# %%

evoked_df_everything = pd.read_csv('../data/csv_files/evoked_df_everything.csv')


evoked_df_button_press = pd.read_csv('../data/csv_files/evoked_df_button_press.csv')

#%%
# parameters

seed=42
n_perm=10000

def independent_t(X1, X2):
    t_vals, _ = stats.ttest_ind(X1, X2, axis=0, equal_var=True)  # equal_var=False = Welch’s t-test vs equal_var=True -> pooled-variance t-test (Student’s t), use Welch only when groups are very unequal
    return t_vals



#%%
# Data preparation for tests:

evoked_df_everything_dw = evoked_df_button_press.copy()
#evoked_df_everything_dw['time'] = evoked_df_everything_dw['time'].round(3)

# cropping to delay time window
start_time = 3
end_time = 6.5
# delay_time_window = evoked_df_all_combos_shifted_excluded[(evoked_df_all_combos_shifted_excluded['time'] >= start_time) & (evoked_df_all_combos_shifted_excluded['time'] <= end_time)]
delay_time_window = evoked_df_everything_dw[(evoked_df_everything_dw['time'] >= start_time) & (evoked_df_everything_dw['time'] <= end_time)]

# z-scoring data
delay_time_window = delay_time_window.copy()

# Z-score within each subject (across all times and trials)
delay_time_window['pupils_z'] = delay_time_window.groupby('subID')['pupils'].transform(
    lambda x: zscore(x, nan_policy='omit')
)

#%%
# 1.1 - Pressed away vs Towards trials
# significant for only 11.25, and only collapsed over all loads, no effect within each load -> simpsons paradox possible?


subset = delay_time_window[(delay_time_window['dist_to_cardinal_mem']==11.25)] # & (delay_time_window['items_presented']==3)

# subset = delay_time_window

# df_card = subset[(subset['probe_away_from_cardinal']==0) & (subset['acc_trial_concrete_cued']==0) | (subset['probe_away_from_cardinal']==1) & (subset['acc_trial_concrete_cued']==1)]
# df_obli = subset[(subset['probe_away_from_cardinal']==0) & (subset['acc_trial_concrete_cued']==1) | (subset['probe_away_from_cardinal']==1) & (subset['acc_trial_concrete_cued']==0)]

df_card = subset[(subset['pressed_away_from_cardinal']==0)]
df_obli = subset[(subset['pressed_away_from_cardinal']==1)]
# Use mean to aggregate multiple entries per subID/time
X1_df = df_card.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')
X2_df = df_obli.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')

# Make sure both have the same subjects and times
common_subs = X1_df.index.intersection(X2_df.index)
common_times = X1_df.columns.intersection(X2_df.columns)
times = common_times.to_numpy()

# Align them
# also common subs?
X1 = X1_df.loc[common_subs, common_times].values
X2 = X2_df.loc[common_subs, common_times].values

Xdiff = X2 - X1                       # (n_subjects, n_times)
n_sub = Xdiff.shape[0]
# Because we conduct a two-tailed test, we divide the p-value by 2 (which means
# we're making use of both tails of the distribution).
tcrit = t.ppf(1 - 0.025, df=n_sub - 1)  # two-tailed cluster-forming threshold

T_obs, clusters, cluster_p_values, H0 = permutation_cluster_1samp_test(
    Xdiff,
    n_permutations=n_perm,
    threshold=tcrit,
    tail=0,
    seed=seed,
    out_type="mask",
    verbose=True
)

alpha = 0.05
cluster_summaries = []
cluster_masses = np.array([T_obs[c].sum() for c in clusters])  # signed mass (t_power=1 default)


for i, c in enumerate(clusters):
    p_val = cluster_p_values[i]

    time_inds = c[0]
    t_vals = T_obs[time_inds]
    mean_t = t_vals.mean()

    cluster_summaries.append({
        "cluster_id": i + 1,
        "start_time": times[time_inds][0],
        "end_time": times[time_inds][-1],
        "p_value": p_val,
        "mean_t": mean_t,
        "cluster_mass": float(cluster_masses[i])
    })

# Turn into DataFrame
cluster_results_button_press_card = pd.DataFrame(cluster_summaries)

# Save to CSV
cluster_results_button_press_card.to_csv('../data/csv_files/cluster_results_button_press_card.csv', index=False)

display(cluster_results_button_press_card)

# Plot
plt.figure(figsize=(10, 5))
plt.plot(times, T_obs, label='T-values')
for i_c, c in enumerate(clusters):
    if cluster_p_values[i_c] < 0.05:
        plt.axvspan(times[c][0], times[c][-1], color='red', alpha=0.3)
plt.axhline(0, color='black', linestyle='--')
plt.title(f'Cluster Permutation Test (cardinal vs oblique trials)')
plt.xlabel('Time (s)')
plt.ylabel('T-statistic')
plt.legend()
plt.tight_layout()
plt.show()


times = np.array(common_times)  # make sure it's ordered
X1_mean = X1.mean(axis=0)
X2_mean = X2.mean(axis=0)

plt.plot(times, X1_mean, label='pressed away from cardinal')
plt.plot(times, X2_mean, label='pressed towards cardinal')

# Highlight significant clusters
for i_c, cluster in enumerate(clusters):
    if cluster_p_values[i_c] < 0.05:
        time_mask = cluster
        plt.axvspan(times[time_mask][0], times[time_mask][-1], color='red', alpha=0.3)

plt.legend()
plt.title(f'Cluster Permutation Test Mask Conditions')
plt.xlabel('Time (s)')
plt.ylabel('Pupil size')
plt.show()

#%%
# 1.2 - Pressed away vs Towards trials separated by load and only at 11.25
# significant for only 11.25, and only collapsed over all loads, no effect within each load


# subset = delay_time_window[(delay_time_window['dist_to_cardinal_mem']==11.25)] # & (delay_time_window['items_presented']==3)
cluster_summaries = []
for load in [1,2,3]:

    subset = delay_time_window[(delay_time_window['items_presented']==load) & ((delay_time_window['dist_to_cardinal_mem']==11.25))]

    # df_card = subset[(subset['probe_away_from_cardinal']==0) & (subset['acc_trial_concrete_cued']==0) | (subset['probe_away_from_cardinal']==1) & (subset['acc_trial_concrete_cued']==1)]
    # df_obli = subset[(subset['probe_away_from_cardinal']==0) & (subset['acc_trial_concrete_cued']==1) | (subset['probe_away_from_cardinal']==1) & (subset['acc_trial_concrete_cued']==0)]

    df_card = subset[(subset['pressed_away_from_cardinal']==0)]
    df_obli = subset[(subset['pressed_away_from_cardinal']==1)]

    # Use mean to aggregate multiple entries per subID/time
    X1_df = df_card.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')
    X2_df = df_obli.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')

    # Make sure both have the same subjects and times
    common_subs= X1_df.index.intersection(X2_df.index)
    common_times = X1_df.columns.intersection(X2_df.columns)
    times = common_times.to_numpy()

    # Align them
    # also common subs?
    X1 = X1_df.loc[common_subs, common_times].values
    X2 = X2_df.loc[common_subs, common_times].values

    Xdiff = X2 - X1                       # (n_subjects, n_times)
    n_sub = Xdiff.shape[0]
    # Because we conduct a two-tailed test, we divide the p-value by 2 (which means
    # we're making use of both tails of the distribution).
    tcrit = t.ppf(1 - 0.025, df=n_sub - 1)  # two-tailed cluster-forming threshold

    T_obs, clusters, cluster_p_values, H0 = permutation_cluster_1samp_test(
        Xdiff,
        n_permutations=n_perm,
        threshold=tcrit,
        tail=0,
        seed=seed,
        out_type="mask",
        verbose=True
        )

    alpha = 0.05
    cluster_masses = np.array([T_obs[c].sum() for c in clusters])  # signed mass (t_power=1 default)

    for i, c in enumerate(clusters):
        p_val = cluster_p_values[i]

        time_inds = c[0]
        t_vals = T_obs[time_inds]
        mean_t = t_vals.mean()

        cluster_summaries.append({
            'load': load,
            "cluster_id": i + 1,
            "start_time": times[time_inds][0],
            "end_time": times[time_inds][-1],
            "p_value": p_val,
            "mean_t": mean_t,
            "cluster_mass": float(cluster_masses[i])
        })

    # Turn into DataFrame
    cluster_results_button_press_card_load = pd.DataFrame(cluster_summaries)

    # Save to CSV
    cluster_results_button_press_card_load.to_csv('../data/csv_files/cluster_results_button_press_card_load.csv', index=False)

    display(cluster_results_button_press_card_load)

    # Plot
    plt.figure(figsize=(10, 5))
    plt.plot(times, T_obs, label='T-values')
    for i_c, c in enumerate(clusters):
        if cluster_p_values[i_c] < 0.05:
            plt.axvspan(times[c][0], times[c][-1], color='red', alpha=0.3)
    plt.axhline(0, color='black', linestyle='--')
    plt.title(f'Cluster Permutation Test (cardinal vs oblique trials)')
    plt.xlabel('Time (s)')
    plt.ylabel('T-statistic')
    plt.legend()
    plt.tight_layout()
    plt.show()


    times = np.array(common_times)  # make sure it's ordered
    X1_mean = X1.mean(axis=0)
    X2_mean = X2.mean(axis=0)

    plt.plot(times, X1_mean, label='pressed away from cardinal')
    plt.plot(times, X2_mean, label='pressed towards cardinal')

    # Highlight significant clusters
    for i_c, cluster in enumerate(clusters):
        if cluster_p_values[i_c] < 0.05:
            time_mask = cluster
            plt.axvspan(times[time_mask][0], times[time_mask][-1], color='red', alpha=0.3)

    plt.legend()
    plt.title(f'Cluster Permutation Test Mask Conditions')
    plt.xlabel('Time (s)')
    plt.ylabel('Pupil size')
    plt.show()
# %%
# cardinal bias per subject

# Participants with overall lower bias in cardinal objects, show bigger pupils in trials where they press toward cardinal axes (whether correctly or incorrectly)
# compared to trials where they pressed away from cardinal axes (only in 11.25)
# participants who show high bias overall, do not show this effect (only in 11.25)

# could this be confounded by overall accuracy?
# if looking at the same groups but contrasting accurate vs inaccurate trials, there is a similar effect (but slightly smaller), correct trials are
# associated with bigger pupils
# or by load?, they all have similar accuracies, accross loads also, 
# accuracy is similar in both groups overall (72 in high vs 70 in low)

# how could a low bias lead do bigger pupils when pressing away, maybe those participants had to use more effort to remember the items in cardinal positions
# to not be effected by the bias?
# overall looks like low bias participants pupils react more to orienation differences than high bias participants - maybe some sort of compensatory strategy

# maybe conflicted by the mask? but probably not, differences in cluster test are calculated per subject so mask shouldnt make a difference

# could this be conflated by the evoked being averaged by accuracy, meaning there is a different number of trials per average?

df_cardinal_bias_acc = df.groupby(['subID', 'dist_probe_to_cardinal'])['acc_trial_concrete_cued'].mean().reset_index()
df_cardinal_bias_acc = df_cardinal_bias_acc.sort_values('dist_probe_to_cardinal')
df_cardinal_bias_acc_piv = df_cardinal_bias_acc.pivot(index=['subID'], columns='dist_probe_to_cardinal', values='acc_trial_concrete_cued').reset_index()
df_cardinal_bias_acc_piv['diff_card'] = df_cardinal_bias_acc_piv[3.25] - df_cardinal_bias_acc_piv[19.25]

df_cardinal_bias_acc_piv['diff_obli'] = df_cardinal_bias_acc_piv[25.75] - df_cardinal_bias_acc_piv[41.75]

diff_card_med = df_cardinal_bias_acc_piv['diff_card'].median()

diff_card_med_high = df_cardinal_bias_acc_piv[df_cardinal_bias_acc_piv['diff_card']>= diff_card_med]['subID']
diff_card_med_low = df_cardinal_bias_acc_piv[df_cardinal_bias_acc_piv['diff_card']< diff_card_med]['subID']

df_cardinal_bias_acc_piv['group'] = np.where(
    df_cardinal_bias_acc_piv['diff_card'] >= diff_card_med, 'high', 'low'
)

mask_partis = df[df['mask']==1]['subID'].unique().tolist()
nomask_partis = df[df['mask']==0]['subID'].unique().tolist()
# Adding column for mask
df_cardinal_bias_acc_piv['mask'] = df_cardinal_bias_acc_piv['subID'].apply(
    lambda x: 1 if x in mask_partis else 0)



#%%
# 2.1 comparing pupil when pressed away in high bias and low bias group -> could make this a contrast 
# (but then it would be between groups and within groups somehow? but within group contrast is easy and then contrast those contrasts)

cluster_summaries = []
for group in [diff_card_med_high, diff_card_med_low]:

    subset = delay_time_window[(delay_time_window['subID'].isin(group)) & (delay_time_window['dist_to_cardinal_mem']==11.25)]

    # df_card = subset[(subset['probe_away_from_cardinal']==0) & (subset['acc_trial_concrete_cued']==0) | (subset['probe_away_from_cardinal']==1) & (subset['acc_trial_concrete_cued']==1)]
    # df_obli = subset[(subset['probe_away_from_cardinal']==0) & (subset['acc_trial_concrete_cued']==1) | (subset['probe_away_from_cardinal']==1) & (subset['acc_trial_concrete_cued']==0)]

    df_card = subset[(subset['pressed_away_from_cardinal']==0)]
    df_obli = subset[(subset['pressed_away_from_cardinal']==1)]

    # df_card = subset[subset['dist_to_cardinal_mem']==11.25]
    # df_obli = subset[subset['dist_to_cardinal_mem']==33.75]

    # Use mean to aggregate multiple entries per subID/time
    X1_df = df_card.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')
    X2_df = df_obli.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')

    # Make sure both have the same subjects and times
    common_subs = X1_df.index.intersection(X2_df.index)
    common_times = X1_df.columns.intersection(X2_df.columns)
    times = common_times.to_numpy()

    # Align them
    # also common subs?
    X1 = X1_df.loc[common_subs, common_times].values
    X2 = X2_df.loc[common_subs, common_times].values

    Xdiff = X2 - X1                       # (n_subjects, n_times)
    n_sub = Xdiff.shape[0]
    # Because we conduct a two-tailed test, we divide the p-value by 2 (which means
    # we're making use of both tails of the distribution).
    tcrit = t.ppf(1 - 0.025, df=n_sub - 1)  # two-tailed cluster-forming threshold

    T_obs, clusters, cluster_p_values, H0 = permutation_cluster_1samp_test(
        Xdiff,
        n_permutations=n_perm,
        threshold=tcrit,
        tail=0,
        seed=seed,
        out_type="mask",
        verbose=True
        )

    alpha = 0.05
    cluster_masses = np.array([T_obs[c].sum() for c in clusters])  # signed mass (t_power=1 default)

    for i, c in enumerate(clusters):
        p_val = cluster_p_values[i]

        time_inds = c[0]
        t_vals = T_obs[time_inds]
        mean_t = t_vals.mean()

        cluster_summaries.append({
            'group': group,
            "cluster_id": i + 1,
            "start_time": times[time_inds][0],
            "end_time": times[time_inds][-1],
            "p_value": p_val,
            "mean_t": mean_t,
            "cluster_mass": float(cluster_masses[i])
        })

    # Turn into DataFrame
    cluster_results_bp_groups = pd.DataFrame(cluster_summaries)

    # Save to CSV
    cluster_results_bp_groups.to_csv('../data/csv_files/cluster_results_bp_groups.csv', index=False)

    display(cluster_results_bp_groups)

    # Plot
    plt.figure(figsize=(10, 5))
    plt.plot(times, T_obs, label='T-values')
    for i_c, c in enumerate(clusters):
        if cluster_p_values[i_c] < 0.05:
            plt.axvspan(times[c][0], times[c][-1], color='red', alpha=0.3)
    plt.axhline(0, color='black', linestyle='--')
    plt.title(f'Cluster Permutation Test (cardinal vs oblique trials)')
    plt.xlabel('Time (s)')
    plt.ylabel('T-statistic')
    plt.legend()
    plt.tight_layout()
    plt.show()


    times = np.array(common_times)  # make sure it's ordered
    X1_mean = X1.mean(axis=0)
    X2_mean = X2.mean(axis=0)

    plt.plot(times, X1_mean, label='pressed away from cardinal')
    plt.plot(times, X2_mean, label='pressed towards cardinal')

    # Highlight significant clusters
    for i_c, cluster in enumerate(clusters):
        if cluster_p_values[i_c] < 0.05:
            time_mask = cluster
            plt.axvspan(times[time_mask][0], times[time_mask][-1], color='red', alpha=0.3)

    plt.legend()
    plt.title(f'Cluster Permutation Test Mask Conditions')
    plt.xlabel('Time (s)')
    plt.ylabel('Pupil size')
    plt.show()

#%% 
# 2.2 comparing within groups within load conditions
# difference also significant only for low group, but only in load 2, but similar effect approaching significance in other load conditions so looks stable

cluster_summaries = []
for group in [diff_card_med_high, diff_card_med_low]:
    for load in [1,2,3]:
        subset = delay_time_window[(delay_time_window['subID'].isin(group)) & (delay_time_window['dist_to_cardinal_mem']==11.25) & (delay_time_window['items_presented']==load)]

        # df_card = subset[(subset['probe_away_from_cardinal']==0) & (subset['acc_trial_concrete_cued']==0) | (subset['probe_away_from_cardinal']==1) & (subset['acc_trial_concrete_cued']==1)]
        # df_obli = subset[(subset['probe_away_from_cardinal']==0) & (subset['acc_trial_concrete_cued']==1) | (subset['probe_away_from_cardinal']==1) & (subset['acc_trial_concrete_cued']==0)]

        df_card = subset[(subset['pressed_away_from_cardinal']==0)]
        df_obli = subset[(subset['pressed_away_from_cardinal']==1)]
        # df_card = subset[subset['dist_to_cardinal_mem']==11.25]
        # df_obli = subset[subset['dist_to_cardinal_mem']==33.75]

        # Use mean to aggregate multiple entries per subID/time
        X1_df = df_card.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')
        X2_df = df_obli.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')

        # Make sure both have the same subjects and times
        common_subs = X1_df.index.intersection(X2_df.index)
        common_times = X1_df.columns.intersection(X2_df.columns)
        times = common_times.to_numpy()

        # Align them
        # also common subs?
        X1 = X1_df.loc[common_subs, common_times].values
        X2 = X2_df.loc[common_subs, common_times].values

        Xdiff = X2 - X1                       # (n_subjects, n_times)
        n_sub = Xdiff.shape[0]
        # Because we conduct a two-tailed test, we divide the p-value by 2 (which means
        # we're making use of both tails of the distribution).
        tcrit = t.ppf(1 - 0.025, df=n_sub - 1)  # two-tailed cluster-forming threshold

        T_obs, clusters, cluster_p_values, H0 = permutation_cluster_1samp_test(
            Xdiff,
            n_permutations=n_perm,
            threshold=tcrit,
            tail=0,
            seed=seed,
            out_type="mask",
            verbose=True
            )

        alpha = 0.05
        cluster_masses = np.array([T_obs[c].sum() for c in clusters])  # signed mass (t_power=1 default)

        for i, c in enumerate(clusters):
            p_val = cluster_p_values[i]

            time_inds = c[0]
            t_vals = T_obs[time_inds]
            mean_t = t_vals.mean()

            cluster_summaries.append({
                'group': group,
                'load': load,
                "cluster_id": i + 1,
                "start_time": times[time_inds][0],
                "end_time": times[time_inds][-1],
                "p_value": p_val,
                "mean_t": mean_t,
                "cluster_mass": float(cluster_masses[i])
            })

        # Turn into DataFrame
        cluster_results_bp_groups_load = pd.DataFrame(cluster_summaries)

        # Save to CSV
        cluster_results_bp_groups_load.to_csv('../data/csv_files/cluster_results_bp_groups_load.csv', index=False)

        display(cluster_results_bp_groups_load)

        # Plot
        plt.figure(figsize=(10, 5))
        plt.plot(times, T_obs, label='T-values')
        for i_c, c in enumerate(clusters):
            if cluster_p_values[i_c] < 0.05:
                plt.axvspan(times[c][0], times[c][-1], color='red', alpha=0.3)
        plt.axhline(0, color='black', linestyle='--')
        plt.title(f'Cluster Permutation Test (cardinal vs oblique trials)')
        plt.xlabel('Time (s)')
        plt.ylabel('T-statistic')
        plt.legend()
        plt.tight_layout()
        plt.show()


        times = np.array(common_times)  # make sure it's ordered
        X1_mean = X1.mean(axis=0)
        X2_mean = X2.mean(axis=0)

        plt.plot(times, X1_mean, label='pressed away from cardinal')
        plt.plot(times, X2_mean, label='pressed towards cardinal')

        # Highlight significant clusters
        for i_c, cluster in enumerate(clusters):
            if cluster_p_values[i_c] < 0.05:
                time_mask = cluster
                plt.axvspan(times[time_mask][0], times[time_mask][-1], color='red', alpha=0.3)

        plt.legend()
        plt.title(f'Cluster Permutation Test Mask Conditions')
        plt.xlabel('Time (s)')
        plt.ylabel('Pupil size')
        plt.show()

#%%
# 2.3 comparing groups directly in pupil shape
# seems like the high group has a less big peak in the beginning and a not so dramatic dip in the end of delay,
# both in mask and no mask but shifted towards the end of the delay for mask
df_card = delay_time_window[(delay_time_window['subID'].isin(diff_card_med_high))] # & (delay_time_window['mask']==0)] #  & (delay_time_window['dist_to_cardinal_mem']==11.25)]
df_obli = delay_time_window[(delay_time_window['subID'].isin(diff_card_med_low))] # & (delay_time_window['mask']==0)] #  & (delay_time_window['dist_to_cardinal_mem']==11.25)]

# Use mean to aggregate multiple entries per subID/time
X1_df = df_card.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')
X2_df = df_obli.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')

# Make sure to have the same times - no subjetzt intersection here because between subjects test
# common_subjects = X1_df.index.intersection(X2_df.index)
common_times = X1_df.columns.intersection(X2_df.columns)
times = common_times.to_numpy()

# Align them
# also common subs?
X1 = X1_df[common_times].values
X2 = X2_df[common_times].values

n1 = X1.shape[0]
n2 = X2.shape[0]
# Because we conduct a two-tailed test, we divide the p-value by 2 (which means
# we're making use of both tails of the distribution).
tcrit = t.ppf(1 - 0.025, df = (n1+n2-2))

T_obs, clusters, cluster_p_values, H0 = permutation_cluster_test(
    [X1, X2],
    n_permutations=n_perm,
    threshold=tcrit,
    tail=0,
    seed=seed,
    stat_fun=independent_t,
    out_type="mask",
    verbose=True
    )

alpha = 0.05
cluster_summaries = []
cluster_masses = np.array([T_obs[c].sum() for c in clusters])  # signed mass (t_power=1 default)

for i, c in enumerate(clusters):
    p_val = cluster_p_values[i]

    time_inds = c[0]
    t_vals = T_obs[time_inds]
    mean_t = t_vals.mean()

    cluster_summaries.append({
        "cluster_id": i + 1,
        "start_time": times[time_inds][0],
        "end_time": times[time_inds][-1],
        "p_value": p_val,
        "mean_t": mean_t,
        "cluster_mass": float(cluster_masses[i])
    })

# Turn into DataFrame
cluster_results_mask_vs_nomask = pd.DataFrame(cluster_summaries)

# Save to CSV
cluster_results_mask_vs_nomask.to_csv('../data/csv_files/cluster_results_mask_vs_nomask.csv', index=False)

display(cluster_results_mask_vs_nomask)

# Plot
plt.figure(figsize=(10, 5))
plt.plot(times, T_obs, label='T-values')
for i_c, c in enumerate(clusters):
    if cluster_p_values[i_c] < 0.05:
        plt.axvspan(times[c][0], times[c][-1], color='red', alpha=0.3)
plt.axhline(0, color='black', linestyle='--')
plt.title(f'Cluster Permutation Test (cardinal vs oblique trials)')
plt.xlabel('Time (s)')
plt.ylabel('T-statistic')
plt.legend()
plt.tight_layout()
plt.show()


times = np.array(common_times)  # make sure it's ordered
X1_mean = X1.mean(axis=0)
X2_mean = X2.mean(axis=0)

plt.plot(times, X1_mean, label='high bias group')
plt.plot(times, X2_mean, label='low bias group')

# Highlight significant clusters
for i_c, cluster in enumerate(clusters):
    if cluster_p_values[i_c] < 0.05:
        time_mask = cluster
        plt.axvspan(times[time_mask][0], times[time_mask][-1], color='red', alpha=0.3)

plt.legend()
plt.title(f'Cluster Permutation Test Mask Conditions')
plt.xlabel('Time (s)')
plt.ylabel('Pupil size')
plt.show()

#%%
# 2.4 comparing groups directly in pupil shape but separated by load
# seems like the high group has a less big peak in the beginning and a not so dramatic dip in the end of delay,
# both in mask and no mask but shifted towards the end of the delay for mask
df_card = delay_time_window[(delay_time_window['subID'].isin(diff_card_med_high))] # & (delay_time_window['mask']==0)] #  & (delay_time_window['dist_to_cardinal_mem']==11.25)]
df_obli = delay_time_window[(delay_time_window['subID'].isin(diff_card_med_low))] # & (delay_time_window['mask']==0)] #  & (delay_time_window['dist_to_cardinal_mem']==11.25)]

for load in [1,2,3]:

    df_card_load = df_card[df_card['items_presented']==load]
    df_obli_load = df_obli[df_obli['items_presented']==load]
    # Use mean to aggregate multiple entries per subID/time
    X1_df = df_card_load.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')
    X2_df = df_obli_load.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')

    # Make sure to have the same times - no subjetzt intersection here because between subjects test
    # common_subjects = X1_df.index.intersection(X2_df.index)
    common_times = X1_df.columns.intersection(X2_df.columns)
    times = common_times.to_numpy()

    # Align them
    # also common subs?
    X1 = X1_df[common_times].values
    X2 = X2_df[common_times].values

    n1 = X1.shape[0]
    n2 = X2.shape[0]
    # Because we conduct a two-tailed test, we divide the p-value by 2 (which means
    # we're making use of both tails of the distribution).
    tcrit = t.ppf(1 - 0.025, df = (n1+n2-2))

    T_obs, clusters, cluster_p_values, H0 = permutation_cluster_test(
        [X1, X2],
        n_permutations=n_perm,
        threshold=tcrit,
        tail=0,
        seed=seed,
        stat_fun=independent_t,
        out_type="mask",
        verbose=True
        )

    alpha = 0.05
    cluster_summaries = []
    cluster_masses = np.array([T_obs[c].sum() for c in clusters])  # signed mass (t_power=1 default)

    for i, c in enumerate(clusters):
        p_val = cluster_p_values[i]

        time_inds = c[0]
        t_vals = T_obs[time_inds]
        mean_t = t_vals.mean()

        cluster_summaries.append({
            "cluster_id": i + 1,
            "start_time": times[time_inds][0],
            "end_time": times[time_inds][-1],
            "p_value": p_val,
            "mean_t": mean_t,
            "cluster_mass": float(cluster_masses[i])
        })

    # Turn into DataFrame
    cluster_results_mask_vs_nomask = pd.DataFrame(cluster_summaries)

    # Save to CSV
    cluster_results_mask_vs_nomask.to_csv('../data/csv_files/cluster_results_mask_vs_nomask.csv', index=False)

    display(cluster_results_mask_vs_nomask)

    # Plot
    plt.figure(figsize=(10, 5))
    plt.plot(times, T_obs, label='T-values')
    for i_c, c in enumerate(clusters):
        if cluster_p_values[i_c] < 0.05:
            plt.axvspan(times[c][0], times[c][-1], color='red', alpha=0.3)
    plt.axhline(0, color='black', linestyle='--')
    plt.title(f'Cluster Permutation Test (cardinal vs oblique trials)')
    plt.xlabel('Time (s)')
    plt.ylabel('T-statistic')
    plt.legend()
    plt.tight_layout()
    plt.show()


    times = np.array(common_times)  # make sure it's ordered
    X1_mean = X1.mean(axis=0)
    X2_mean = X2.mean(axis=0)

    plt.plot(times, X1_mean, label='high bias group')
    plt.plot(times, X2_mean, label='low bias group')

    # Highlight significant clusters
    for i_c, cluster in enumerate(clusters):
        if cluster_p_values[i_c] < 0.05:
            time_mask = cluster
            plt.axvspan(times[time_mask][0], times[time_mask][-1], color='red', alpha=0.3)

    plt.legend()
    plt.title(f'Cluster Permutation Test Mask Conditions')
    plt.xlabel('Time (s)')
    plt.ylabel('Pupil size')
    plt.show()

#%%
# 2.5 comparing load effect between the two groups
# not significant (but looks like its not too far off) - means load effect is the same in both groups

df_card = delay_time_window[(delay_time_window['subID'].isin(diff_card_med_high))] # & (delay_time_window['mask']==0)] #  & (delay_time_window['dist_to_cardinal_mem']==11.25)]
df_obli = delay_time_window[(delay_time_window['subID'].isin(diff_card_med_low))] # & (delay_time_window['mask']==0)] #  & (delay_time_window['dist_to_cardinal_mem']==11.25)]

lins = []

for group in [diff_card_med_high, diff_card_med_low]:

    df_m = delay_time_window[(delay_time_window['subID'].isin(group))]
    # Build subject×time tables per load
    P1 = df_m[df_m['items_presented'] == 1].pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')
    P2 = df_m[df_m['items_presented'] == 2].pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')
    P3 = df_m[df_m['items_presented'] == 3].pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')

    # Align subjects and timepoints across ALL three loads (within-subjects!)
    common_subs  = P1.index.intersection(P2.index).intersection(P3.index)
    common_times = P1.columns.intersection(P2.columns).intersection(P3.columns)
    common_times = np.array(sorted(common_times))

    X1 = P1.loc[common_subs, common_times].to_numpy()
    X2 = P2.loc[common_subs, common_times].to_numpy()
    X3 = P3.loc[common_subs, common_times].to_numpy()
    times = common_times

    # X1, X2, X3 already aligned: (subjects × time)
    w = np.array([-1, 0, 1])  # linear contrast weights

    # Compute per-subject contrast time series
    X_lin = w[0]*X1 + w[1]*X2 + w[2]*X3   # shape (n_sub × n_time)

    lins.append(X_lin)


n1 = lins[0].shape[0]
n2 = lins[1].shape[0]
# Because we conduct a two-tailed test, we divide the p-value by 2 (which means
# we're making use of both tails of the distribution).
tcrit = t.ppf(1 - 0.025, df = (n1+n2-2))

T_obs, clusters, cluster_p_values, H0 = permutation_cluster_test(
    [lins[0], lins[1]],
    n_permutations=n_perm,
    threshold=tcrit,
    tail=0,
    seed=seed,
    stat_fun=independent_t,
    out_type="mask",
    verbose=True
    )

alpha = 0.05
cluster_summaries = []
cluster_masses = np.array([T_obs[c].sum() for c in clusters])  # signed mass (t_power=1 default)

for i, c in enumerate(clusters):
    p_val = cluster_p_values[i]

    time_inds = c[0]
    t_vals = T_obs[time_inds]
    mean_t = t_vals.mean()

    cluster_summaries.append({
        "cluster_id": i + 1,
        "start_time": times[time_inds][0],
        "end_time": times[time_inds][-1],
        "p_value": p_val,
        "mean_t": mean_t,
        "cluster_mass": float(cluster_masses[i])
    })

# Turn into DataFrame
cluster_results_mask_vs_nomask = pd.DataFrame(cluster_summaries)

# Save to CSV
cluster_results_mask_vs_nomask.to_csv('../data/csv_files/cluster_results_mask_vs_nomask.csv', index=False)

display(cluster_results_mask_vs_nomask)

# Plot
plt.figure(figsize=(10, 5))
plt.plot(times, T_obs, label='T-values')
for i_c, c in enumerate(clusters):
    if cluster_p_values[i_c] < 0.05:
        plt.axvspan(times[c][0], times[c][-1], color='red', alpha=0.3)
plt.axhline(0, color='black', linestyle='--')
plt.title(f'Cluster Permutation Test (cardinal vs oblique trials)')
plt.xlabel('Time (s)')
plt.ylabel('T-statistic')
plt.legend()
plt.tight_layout()
plt.show()


times = np.array(common_times)  # make sure it's ordered
X1_mean = lins[0].mean(axis=0)
X2_mean = lins[1].mean(axis=0)

plt.plot(times, X1_mean, label='high bias group')
plt.plot(times, X2_mean, label='low bias group')

# Highlight significant clusters
for i_c, cluster in enumerate(clusters):
    if cluster_p_values[i_c] < 0.05:
        time_mask = cluster
        plt.axvspan(times[time_mask][0], times[time_mask][-1], color='red', alpha=0.3)

plt.legend()
plt.title(f'Cluster Permutation Test Mask Conditions')
plt.xlabel('Time (s)')
plt.ylabel('Pupil size')
plt.show()
#%%
# 3.1
# difference between correct and false per load but this time only for dist 11.25
# only done here because no dist in accuracy evoked

####################################################################################
####################################################################################
cluster_results = {}

for load in [1, 2, 3]:
    print(f"\nRunning cluster test for Load {load}...")

    # Subset the data
    df_load = delay_time_window[(delay_time_window['items_presented'] == load) & (delay_time_window['dist_to_cardinal_mem'] == 11.25) ]  #& (delay_time_window['dist_to_cardinal_mem'] == 11.25) 
    df_correct = df_load[df_load['acc_trial_concrete_cued'] == 1]
    df_false = df_load[df_load['acc_trial_concrete_cued'] == 0]

    # Pivot to get subjects x timepoints
    X1_df = df_correct.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')
    X2_df = df_false.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')

    # Align subjects and timepoints
    common_subs = X1_df.index.intersection(X2_df.index)
    common_times = X1_df.columns.intersection(X2_df.columns)
    times = common_times.to_numpy()

    X1 = X1_df.loc[common_subs, common_times].to_numpy()
    X2 = X2_df.loc[common_subs, common_times].to_numpy()

    Xdiff = X2 - X1                       # (n_subjects, n_times)
    n_sub = Xdiff.shape[0]
    # Because we conduct a two-tailed test, we divide the p-value by 2 (which means
    # we're making use of both tails of the distribution).
    tcrit = t.ppf(1 - 0.025, df=n_sub - 1)  # two-tailed cluster-forming threshold

    # Run cluster-based permutation test
    T_obs, clusters, cluster_p_values, H0 = permutation_cluster_1samp_test(
        Xdiff,
        n_permutations=n_perm,
        threshold=tcrit,
        tail=0,
        seed=seed,
        out_type='mask',
        verbose=True
    )
    cluster_masses = np.array([T_obs[c].sum() for c in clusters])  # signed mass (t_power=1 default)
    print(cluster_p_values.round(3))
    # Store results
    cluster_results[load] = {
        "T_obs": T_obs,
        "clusters": clusters,
        "cluster_p_values": cluster_p_values,
        "times": times,
        "cluster_mass": float(cluster_masses[i])
    }
    print(cluster_results[load]['cluster_p_values'])

    # Plot
    plt.figure(figsize=(10, 5))
    plt.plot(times, T_obs, label='T-values')
    for i_c, c in enumerate(clusters):
        if cluster_p_values[i_c] < 0.05:
            plt.axvspan(times[c][0], times[c][-1], color='red', alpha=0.3)
    plt.axhline(0, color='black', linestyle='--')
    plt.title(f'Cluster Permutation Test (Load {load})')
    plt.xlabel('Time (s)')
    plt.ylabel('T-statistic')
    plt.legend()
    plt.tight_layout()
    plt.show()

    times = np.array(common_times)  # make sure it's ordered
    X1_mean = X1.mean(axis=0)
    X2_mean = X2.mean(axis=0)


    plt.plot(times, X1_mean, label='correct')
    plt.plot(times, X2_mean, label='false')


    # Highlight significant clusters
    for i_c, cluster in enumerate(clusters):
        if cluster_p_values[i_c] < 0.05:
            time_mask = cluster
            plt.axvspan(times[time_mask][0], times[time_mask][-1], color='red', alpha=0.3)

    plt.legend()
    plt.title(f'Cluster Permutation Test Accuracy')
    plt.xlabel('Time (s)')
    plt.ylabel('Pupil size')
    plt.show()
