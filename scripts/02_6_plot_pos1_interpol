# %%
# Importsconda
import mne
import numpy as np
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

# %% 
# read evoked dataframe
evoked_df_pos1_interpol = pd.read_csv('../data/csv_files/evoked_df_pos1_interpol.csv')


# %% 

with sns.plotting_context(context='paper', font_scale=1.5): # , font_scale=3.5, rc=None 

    fig, ax = plt.subplots(figsize=(10,8))

    sns.lineplot(data=evoked_df_pos1_interpol, x='time', y='pupils', hue='Load', palette='crest', errorbar='se', ax=ax)

    sns.despine(fig=fig, ax=None, top=True, right=True, left=False, bottom=False, offset=None, trim=False)
    
    ax.axvline(3, color='black', alpha=0.33)
    ax.axvline(2, color='black', alpha=0.66)
    ax.axvline(1, color='black')  
    ax.axvline(0, color='darkblue')  

    # Define y-coordinate for labels (as a fraction of the plot height)
    label_y = 1.05 

    # Add labels above the vertical lines
    ax.text(3, ax.get_ylim()[1] * label_y, "onset delay, condition 3", color='black', alpha=0.33, fontsize=10, ha='center', rotation=45)
    ax.text(2, ax.get_ylim()[1] * label_y, "onset delay, condition 2", color='black', alpha=0.66, fontsize=10, ha='center', rotation=45)
    ax.text(1, ax.get_ylim()[1] * label_y, "onset delay, condition 1", color='black', fontsize=10, ha='center', rotation=45)
    ax.text(0, ax.get_ylim()[1] * label_y, "object position 1, all conditions",  color='darkblue', fontsize=10, ha='center', rotation=45)

    # Highlighting the baseline window
    baseline = (evoked_df_pos1_interpol.at[0, 'baseline_start'], evoked_df_pos1_interpol.at[0, 'baseline_end'])
    baseline_str = '_'.join(map(str, baseline))
    
    # Include window that was used for the baseline
    ax.axvspan(baseline[0], baseline[1], ymin=0, ymax=1, color='blue', alpha=0.4)

    # Set x-axis to show all whole numbers within range
    x_ticks = np.arange(int(evoked_df_pos1_interpol['time'].min()), int(evoked_df_pos1_interpol['time'].max()) + 1, 1)
    ax.set_xticks(x_ticks)
    ax.set_xticklabels(x_ticks)

    # Increase font size of x and y tick labels
    ax.tick_params(axis='x', labelsize=14)
    ax.tick_params(axis='y', labelsize=14)

    # Adding a title
    plt.suptitle('Pupil dilation across conditions', y=1.15, fontsize = 20)
    plt.title(f'Applied baseline {baseline}', y=1.25, color='blue', alpha=0.4)

    # Adding a legend
    ax.legend(title='Load', loc='upper right', fontsize=12)

    # Save the figure
    name=f"pupil_fig_pos1_interpol_bl{baseline_str}.png"
    figures_folder = '/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/figures'
    figure_filepath = os.path.join(figures_folder, name)
    plt.savefig(figure_filepath, bbox_inches = 'tight')
