# now I want to extract all the eventIDs from the trigger matching where there is pos1 in the description


# %%

# !!!!! THE ODERING OF THIS IS DIFFERENT THAN IN THE ORIGINAL USED IN THE EXPERIMENT

# can also write code making the triggers themselves: 
n_objects = ['obj1', 'obj2', 'obj3']
n_positions = ['pos1', 'pos2', 'pos3']
n_orientations = n_orientations = [f'ori{i}' for i in range(1, 17)]

# Generate combinations of the three conditions
combinations = itertools.product(n_positions, n_objects, n_orientations)

# Create a dictionary to store the combinations
trigger_dict = {}

# Populate the dictionary with formatted combinations
for idx, combo in enumerate(combinations, start=1):
    trigger_dict[idx] = '/'.join(combo)

additional_pairs = {
    220: "onset_concrete_cued_left",
    221: "onset_concrete_cued_right",
    241: "left_button_press",
    242: "right_button_press",
    244: "feedback_cued_item",
    245: "mask",
    246: "beginning/end_of_task"
}

trigger_dict.update(additional_pairs)


# # %% 

# # Extract keys with "pos1" in the value
# keys_with_pos1 = [key for key, value in trigger_dict.items() if "pos1" in value]

# # Print the keys
# print("Keys with 'pos1' in the value:", keys_with_pos1)


# %%

# Extract key-value pairs with "pos1" in the value as a dictionary
pos1_pairs = {key: value for key, value in trigger_dict.items() if "pos1" in value}

# Print the dictionary
print("Key-value pairs with 'pos1' in the value:")
print(pos1_pairs)
# %% 
# Dictionary for triggers used for onset of epoch?
# could also be a dict however:

folder_name = f"Epochs_data_first_item"

os.makedirs(folder_name, exist_ok=True)

# test_onset_dict = {"onset_concrete_cued_left": 220,
#     "onset_concrete_cued_right": 221}



conditions = [1, 2, 3]

for condition in conditions:
    for i in good_partis:
        folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/data_eyelink"

        eyelink_file = folder_path + "/" + i + ".asc"
        print(eyelink_file)
        raw = mne.io.read_raw_eyelink(eyelink_file)

        metadata_pp = df.loc[(df['subID'] == i) & (df['items_presented'] == condition)]
        
        events_from_annot, event_dict = mne.events_from_annotations(
            raw, event_id=custom_mapping)

        # Filter events based on the current condition

        # all events per participant
        events_onset = events_from_annot[np.isin(events_from_annot, [220, 221])[:, -1]]

        # need to now filter them to only include those for one condition
        # the metadata is already set to only one condition in this loop and therefore the idea here is to use
        # the index of the metadata for the events

        # make sure the index is really correct
        #events_condition = events_onset[metadata_pp.index, :]

        pupil_epochs = mne.Epochs(
            raw,
            events_condition,
            event_id=pos1_pairs,
            tmin=-6.5,
            tmax=2.5,
            baseline=None,
            metadata=metadata_pp,
            picks=['pupil_left', 'pupil_right'],
            event_repeated='merge',
            preload=True,
            reject_by_annotation=False
        )

        # Save epoch in fif format to a specified folder
        filename = f"{i}-condition-{condition}-epo.fif"
        filepath = os.path.join(folder_name, filename)
        pupil_epochs.save(filepath, overwrite=True, split_size='1.8GB', split_naming='bids', verbose=None)
