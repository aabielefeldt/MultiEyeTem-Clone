# %%
# Importsconda
import mne
import numpy as np
import pandas as pd
import itertools

# %% Load Metadata
df = pd.read_csv('../data/csv_files/df.csv')
good_partis = df['subID'].unique()

# %%
# if qt is used as backend the kernel crashes
mne.viz.set_browser_backend('matplotlib')

# %% 
# Triggers used for onset of epoch
test_onset_dict = {"onset_concrete_cued_left": 220,
    "onset_concrete_cued_right": 221}
# %%
# subID to resample from freqs_df (which has been created in the epochs script)
freqs_df = pd.read_csv('/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/csv_files/freqs_df.csv')
wrong_partis  = freqs_df[freqs_df['frequency'] > 500]['subID'].unique()
print(wrong_partis)

# Creating epochs while downsampling
for i in wrong_partis:

    # read file per differently sampled subID
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/data_eyelink"
    eyelink_file = folder_path + "/" + i + ".asc"
    raw = mne.io.read_raw_eyelink(eyelink_file)
    metadata_pp = df.loc[(df['subID'] == i)]   
    
    # Filtering according to sampling frequency 
    current_sfreq = raw.info["sfreq"]
    desired_sfreq = 500  # Hz
    decim = np.round(current_sfreq / desired_sfreq).astype(int)
    obtained_sfreq = current_sfreq / decim
    lowpass_freq = obtained_sfreq / 3.0
    raw_filtered = raw.copy().filter(l_freq=None, h_freq=lowpass_freq)

    # Create Custom Mapping to map annotations found to event ids that match the triggers used
    annotations = raw_filtered.annotations
    custom_mapping = {}

    # Generate mapping for annotations with integer descriptions
    max_id = 0
    for description in annotations.description:
        if description.isdigit():
            event_id = int(description)
            custom_mapping[description] = event_id
            if event_id > max_id:
                max_id = event_id
    next_event_id = max_id + 1

    # Add non-numeric descriptions with unique event IDs
    for description in annotations.description:
        if not description.isdigit():
            if description not in custom_mapping:  # Ensure each description is only mapped once
                custom_mapping[description] = next_event_id
                next_event_id += 1
    sorted_custom_mapping = dict(sorted(custom_mapping.items(), key=lambda item: int(item[0]) if item[0].isdigit() else float('inf')))

    # Get events from annotations using the custom mapping 
    events_from_annot, event_dict = mne.events_from_annotations(
        raw_filtered, event_id=sorted_custom_mapping)

    pupil_epochs = mne.Epochs(
        raw_filtered, 
        events_from_annot[np.isin(events_from_annot, [220, 221])[:,-1]],
        event_id=test_onset_dict, 
        tmin=-6.5,
        tmax=2.5,
        baseline=None,
        metadata=metadata_pp,
        picks=['pupil_left', 'pupil_right'],
        event_repeated='merge',
        preload=True,
        reject_by_annotation=False,
        decim=decim
    )

    print(
        "desired sampling frequency was {} Hz; decim factor of {} yielded an "
        "actual sampling frequency of {} Hz.".format(
            desired_sfreq, decim, pupil_epochs.info["sfreq"]
        )
    )

    folder_name = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Epochs_test_onset"
    filename = f"{i}_test_onset-epo.fif"
    filepath = os.path.join(folder_name, filename)
    pupil_epochs.save(filepath, overwrite=True, split_size='1.8GB', split_naming='bids', verbose=None)


# %%
