# %%
# Importsconda
import mne
import numpy as np
import pandas as pd
from datetime import datetime
import pingouin as pg
import seaborn as sns
import matplotlib.pyplot as plt

# %% Load Metadata

df = pd.read_csv('../data/df.csv')
good_partis = df['subID'].unique()
new_partis = np.delete(good_partis, np.where(good_partis == ['KJN4WD']))

# %%
# if qt is used as backend the kernel crashes
# this can probably be deleted once run, but might just keep in in to be safe
mne.viz.set_browser_backend('matplotlib')


# %%


 #  JUST FOR NOW - DELETING THE DIFFERENTLY SAMPLED EPOCH FROM THE FOLDER
epochs_list = []

for i in new_partis:
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem//multieyetem/data/Epochs_data_2024-02-29_13:54"

    epoch_file = folder_path + "/" + i + "-epo.fif"

    pupil_epochs = mne.read_epochs(epoch_file, proj=True, preload=True, verbose=None)
    
    epochs_list.append(pupil_epochs)



# %%
# so far this is not plotting the average of all participants but the average of each one individually

# Is this concatenating them after each other? And if yes is this still averaging them on top of each other?
# it probably is because they are still on the same timecourse

# Combine epoched data from all participants
combined_epochs = mne.concatenate_epochs(epochs_list)

# Calculate the average across all participants
average_epochs = combined_epochs.average()

average_epochs.plot()

