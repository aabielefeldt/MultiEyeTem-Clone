# Importsconda
import mne
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
import itertools
import numpy as np
import os

#%%
# if qt is used as backend the kernel crashes
mne.viz.set_browser_backend('matplotlib')

#%%
df = pd.read_csv('../data/csv_files/df.csv')
good_partis = df['subID'].unique()

#%%
# create figures folder
figures_folder = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/figures"
data_foldername1 = f'pupil_size'
data_foldername2 = f'baseline_pupil_size'
csv_path1 = os.path.join(figures_folder, data_foldername1)
csv_path2 = os.path.join(figures_folder, data_foldername2)
os.makedirs(csv_path1, exist_ok=True)
os.makedirs(csv_path2, exist_ok=True)

#%%
# mne code umrechnen der pupille?



# %%
# Histogram pupil size
# probably delete

# gitb es einen ceiling effect bei der pupille?
# wie bei mathot und vilotijevic normalverteilung angucken histogram
# für jeden probanden alle trials hintereinander hängen und dann histogram
# raw data ohne baseline
# dann zentrieren mit allen mit median über alle probanden

raw_df_all = pd.DataFrame()

for i in ['REUNMA']:
# read file per subID
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/data_eyelink"
    eyelink_file = folder_path + "/" + i + ".asc"
    raw = mne.io.read_raw_eyelink(eyelink_file)
    metadata_pp = df.loc[(df['subID'] == i)]

    mne.preprocessing.eyetracking.interpolate_blinks(raw, buffer=[0.05, 0.2], match='BAD_blink', interpolate_gaze=False)

    # combining channels
    pupil_ix = mne.pick_channels(raw.info["ch_names"], include=['pupil_left', 'pupil_right'])
    roi_dict = dict(pupils=pupil_ix)
    raw_combined = mne.channels.combine_channels(raw, roi_dict, method="mean")

    raw_df = raw_combined.to_data_frame()

    raw_df['subID'] = i

    # concatenating to evoked_df_pos1_interpol
    raw_df_all = pd.concat([raw_df_all, raw_df])

    plt.title(f'SubID {i}')
    sns.histplot(data=raw_df_all, x='pupils')

    


# %%
# Histogram of pupil sizes per subID per timepoint during epochs
# Mathot and Vilotijevic use baseline pupil sizes?? But that is answering a different question right?
# for baseline I need the actual epochs..

# this here is still not what the authors do, but probably also makes sense because it ignores all timepoints where participants didn't respond to any tasks
# so this gives me a histogram of the distribution of pupil size per participant 

histo_all = pd.DataFrame()

for i in good_partis:
    
    # reading epochs per participant
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Epochs_pos1"
    epoch_file = folder_path + "/" + i + "_pos1_interpol-epo.fif"
    pupil_epoch = mne.read_epochs(epoch_file, preload=True, verbose=None)

    # combining channels
    pupil_ix = mne.pick_channels(pupil_epoch.info["ch_names"], include=['pupil_left', 'pupil_right'])
    roi_dict = dict(pupils=pupil_ix)
    pupil_epochs_combined = mne.channels.combine_channels(pupil_epoch, roi_dict, method="mean")

    pupil_epochs_combined_df = pupil_epochs_combined.to_data_frame()
    pupil_epochs_combined_df['subID'] = i

    histo_all = pd.concat([histo_all, pupil_epochs_combined_df])

    plt.figure()
    plt.title(f'SubID {i} - distribution of pupil size within epochs')
    sns.histplot(data=pupil_epochs_combined_df, bins=100, stat='density', x='pupils', legend=True)

    # Set fixed axis limits
    plt.xlim(0, 2e9)
    plt.ylim(0, 6e-9)

    # Save the figure
    name=f"pupil_size_histogram_{i}.png"
    figures_folder = '/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/figures/pupil_size'
    figure_filepath = os.path.join(figures_folder, name)

    plt.savefig(figure_filepath, bbox_inches = 'tight')

plt.figure()
plt.title(f'distribution of pupil size within epochs all subIDs')
sns.histplot(data=histo_all, bins=100, stat='density', x='pupils', legend=True)

# %%
# Histogram of pupil sizes per subID per timepoint during baseline period
# do I just plot the size averaged per baseline period per trial?
for i in ['1UVQEK']:
    
    # reading epochs per participant
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Epochs_pos1"
    epoch_file = folder_path + "/" + i + "_pos1_interpol-epo.fif"
    pupil_epoch = mne.read_epochs(epoch_file, preload=True, verbose=None)

    # combining channels
    pupil_ix = mne.pick_channels(pupil_epoch.info["ch_names"], include=['pupil_left', 'pupil_right'])
    roi_dict = dict(pupils=pupil_ix)
    pupil_epochs_combined = mne.channels.combine_channels(pupil_epoch, roi_dict, method="mean")

    pupil_epochs_combined.crop(tmin=-0.1, tmax=0, include_tmax=True)

    # now I have an average per timepoint, I want an average per baseline period
    #ave = pupil_epochs_combined.average()

    pupil_epochs_combined_df = pupil_epochs_combined.to_data_frame()
    pupil_epochs_combined_df['subID'] = i

    #baseline period is between -0.1 and 0
    mean_list = []
    for l, k in enumerate(np.unique(pupil_epochs_combined_df['epoch'])):
        baseline_mean = pupil_epochs_combined_df[pupil_epochs_combined_df['epoch']== l]['pupils'].mean()
        mean_list.append(({'subID': i, 'baseline_mean': baseline_mean, 'epoch': k}))

    baseline_df = pd.DataFrame(mean_list)
    plt.title(f'SubID {i}')
    sns.histplot(data=baseline_df, stat='count', x='baseline_mean', legend=True)

    # Save the figure
    name=f"pupil_size_histogram_during_baseline_{i}.png"
    figures_folder = '/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/figures/baseline_pupil_size'
    figure_filepath = os.path.join(figures_folder, name)

    plt.savefig(figure_filepath, bbox_inches = 'tight')


# %%
# Cropping raw makes it possible to plot using matplotlib
# raw.plot(scalings=1e3, show=True, show_options=True, duration=9.1)

# Make a copy so the original stays unchanged
raw_copy = raw.copy()

# Crop only the copy
# can I also plot an area where no task was performed? are breaks included in the data?
raw_copy.crop(tmin=6424, tmax=6444)

# Filter annotations: keep only those with description "bad blink"
blink_annot = raw.annotations[raw.annotations.description == "blink"]

# Assign filtered annotations to the copied raw object
raw_copy.set_annotations(blink_annot)

raw_copy.plot(scalings=1e3, show=False, show_options=True, duration=9.1, picks= ['pupil_left', 'pupil_right'])

