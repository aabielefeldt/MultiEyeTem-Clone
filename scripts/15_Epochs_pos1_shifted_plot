# time_windows for significance
# time_window_shifted_0 = pd.read_csv('../data/Tables_and_Dataframes/time_window_shifted_0.csv')
# time_window_shifted_1 = pd.read_csv('../data/Tables_and_Dataframes/time_window_shifted_1.csv')
# time_window_shifted_2 = pd.read_csv('../data/Tables_and_Dataframes/time_window_shifted_2.csv')
sig_results_shifted = pd.read_csv('../data/Tables_and_Dataframes/sig_results_shifted.csv')

# %% 

# since changing the errorbar to 'se' it only takes a minute to plot

fig, ax = plt.subplots(figsize=(10,8))

# stefan included get_axes in his code to show axvlines, seems to work without it though and even returns an error 
# ax = fig.get_axes()[0]

sns.lineplot(data=all_con_evoked_pos1_shifted, x='time', y='pupils', hue='Load', palette='crest', errorbar='se', ax=ax)

ax.axvline(1, color='black', alpha=0.33)
ax.axvline(2, color='black', alpha=0.66)
ax.axvline(3, color='black')  
ax.axvline(0, color='darkblue')  
# ax.axvline(6.5, color='blue')  


# Define y-coordinate for labels (as a fraction of the plot height)
label_y = 1.05  # Adjust this value as needed

# Add labels above the vertical lines

# these do not make sense either! 0 is always object position 1 no matter which condition
ax.text(3, ax.get_ylim()[1] * label_y, "onset delay, condition 3", color='black', alpha=0.33, fontsize=10, ha='center', rotation=45)
ax.text(2, ax.get_ylim()[1] * label_y, "onset delay, condition 2", color='black', alpha=0.66, fontsize=10, ha='center', rotation=45)
ax.text(1, ax.get_ylim()[1] * label_y, "onset delay, condition 1", color='black', fontsize=10, ha='center', rotation=45)

# the following two probably do not make sense because onset delay and onset probe are different in this case
ax.text(0, ax.get_ylim()[1] * label_y, "object position 1, all conditions",  color='darkblue', fontsize=10, ha='center', rotation=45)
#ax.text(6.5, ax.get_ylim()[1] * label_y, "onset probe object", color='blue', fontsize=10, ha='center', rotation=45)

# add significance bars

# ax.plot(x[sig], y_sig, ".", label="significant")
# can I just use the sig_results themselves directly?
sig = sig_results_shifted['time'].values
y_sig = [ax.get_ylim()[0]] * len(sig)
ax.plot(sig, y_sig, ".", label="significant")


# automatically changing the name to the set baseline
baseline = (all_con_evoked_pos1_shifted.at[0, 'baseline_start'], all_con_evoked_pos1_shifted.at[0, 'baseline_end'])
baseline_str = '_'.join(map(str, baseline))
name=f"pupil_fig_pos1_bl{baseline_str}.png"

# Include window that was used for the baseline
ax.axvspan(baseline[0], baseline[1], ymin=0, ymax=1, color='blue', alpha=0.4)

plt.suptitle('Pupil dilation across conditions', y=1.1, fontsize = 20)
plt.title(f'Applied baseline {baseline}', y=1.2, color='blue', alpha=0.4)
plt.savefig(name, bbox_inches = 'tight')



# %%
# Extra plot
# plotting the three conditions in three subplots

fig, axs = plt.subplots(3, sharex=True, figsize=(10,8))
all_pp_con1_pos1 = all_con_evoked_pos1_shifted.loc[all_con_evoked_pos1_shifted['Load']==1]
all_pp_con2_pos1 = all_con_evoked_pos1_shifted.loc[all_con_evoked_pos1_shifted['Load']==2]
all_pp_con3_pos1 = all_con_evoked_pos1_shifted.loc[all_con_evoked_pos1_shifted['Load']==3]

# Define y-coordinate for labels (as a fraction of the plot height)
label_y = 1.05

sns.lineplot(ax=axs[0], data=all_pp_con1_pos1, x='time', y='pupils', hue='Load', palette='crest', errorbar='se')

sns.lineplot(ax=axs[1], data=all_pp_con2_pos1, x='time', y='pupils', hue='Load', palette='crest', errorbar='se')

sns.lineplot(ax=axs[2], data=all_pp_con3_pos1, x='time', y='pupils', hue='Load', palette='crest', errorbar='se')


#could also just add them for those load conditions where they are relevant and not to all of them
# these do not make sense either! 0 is always object position 1 no matter which condition
axs[0].text(3, axs[0].get_ylim()[1] * label_y, "onset delay, condition 3", color='black', alpha=0.33, fontsize=10, ha='center', rotation=45)
axs[0].text(2, axs[0].get_ylim()[1] * label_y, "onset delay, condition 2", color='black', alpha=0.66, fontsize=10, ha='center', rotation=45)
axs[0].text(1, axs[0].get_ylim()[1] * label_y, "onset delay, condition 1", color='black', fontsize=10, ha='center', rotation=45)

# the following two probably do not make sense because onset delay and onset probe are different in this case
axs[0].text(0, axs[0].get_ylim()[1] * label_y, "object position 1, all conditions",  color='darkblue', fontsize=10, ha='center', rotation=45)
#ax.text(6.5, ax.get_ylim()[1] * label_y, "onset probe object", color='blue', fontsize=10, ha='center', rotation=45)

for i, ax in enumerate(axs.flat):
    axs[i].axvline(1, color='black', alpha=0.33)
    axs[i].axvline(2, color='black', alpha=0.66)
    axs[i].axvline(3, color='black')  
    axs[i].axvline(0, color='darkblue') 

baseline = (all_con_evoked_pos1_shifted.at[0, 'baseline_start'], all_con_evoked_pos1_shifted.at[0, 'baseline_end'])
baseline_str = '_'.join(map(str, baseline))
name=f"pupil_fig_seperated_pos1_bl{baseline_str}.png"

plt.suptitle('Pupil dilation across conditions', y=1.15,  fontsize = 20)
plt.figtext(0.5, 1.1, f'Applied baseline {baseline}', ha='center', color='blue', alpha=0.4)
plt.savefig(name, bbox_inches = 'tight')


