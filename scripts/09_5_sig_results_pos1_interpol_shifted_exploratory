# %%
# Importsconda
import mne
import numpy as np
import pandas as pd
import pingouin as pg
import seaborn as sns
import matplotlib.pyplot as plt

# %% 
# read evoked dataframe
evoked_df_pos1_interpol_shifted = pd.read_csv('../data/csv_files/evoked_df_pos1_interpol_shifted.csv')
evoked_df_shifted = pd.read_csv('../data/csv_files/evoked_df_shifted.csv')

# %%
# create time window for analysis
start_time = 3
end_time = 6.5
#delay_time_window = evoked_df_pos1_interpol_shifted[(evoked_df_pos1_interpol_shifted['time'] >= start_time) & (evoked_df_pos1_interpol_shifted['time'] <= end_time)]

delay_time_window = evoked_df_shifted[(evoked_df_shifted['time'] >= start_time) & (evoked_df_shifted['time'] <= end_time)]

delay_time_window['time'] = delay_time_window['time'].round(3)
ts = sorted(delay_time_window['time'].unique())

# %%
# run a repeated measures one-way ANOVA over every timepoint
stats_list = []
for it in ts:
    #evoked_it_time = evoked_df_pos1_interpol_shifted.loc[evoked_df_pos1_interpol_shifted['time'] == it]
    evoked_it_time = delay_time_window[delay_time_window['time'] == it].copy()
    stats = pg.rm_anova(data=evoked_it_time, dv='pupils', subject='subID', within='Load')
    stats['time'] = it
    stats_list.append(stats)


# %%
# Concatenate all the results into a single DataFrame
ANOVA_timepoints_results_pos1_shifted_interpol = pd.concat(stats_list, ignore_index=True)
#ANOVA_timepoints_results_pos1_shifted_interpol.to_csv('../data/csv_files/ANOVA_timepoints_results_pos1_shifted_interpol.csv', index=False)

ANOVA_timepoints_results_pos1_shifted_interpol.to_csv('../data/csv_files/ANOVA_timepoints_results_new.csv', index=False)


# Filter the significant results
# sig_results_pos1_interpol_shifted = ANOVA_timepoints_results_pos1_shifted_interpol[ANOVA_timepoints_results_pos1_shifted_interpol['p-unc'] <= 0.05]
# sig_results_pos1_interpol_shifted.to_csv('../data/csv_files/sig_results_pos1_interpol_shifted.csv', index=False)

sig_results_shifted = ANOVA_timepoints_results_pos1_shifted_interpol[ANOVA_timepoints_results_pos1_shifted_interpol['p-unc'] <= 0.05]
sig_results_shifted.to_csv('../data/csv_files/sig_results_shifted.csv', index=False)


# %%
display(ANOVA_timepoints_results_pos1_shifted_interpol)
display(sig_results_shifted)

#%%
# seperate by mask

# create time window for analysis
start_time = 3
end_time = 6.5
#delay_time_window = evoked_df_pos1_interpol_shifted[(evoked_df_pos1_interpol_shifted['time'] >= start_time) & (evoked_df_pos1_interpol_shifted['time'] <= end_time)]

delay_time_window = evoked_df_shifted[(evoked_df_shifted['time'] >= start_time) & (evoked_df_shifted['time'] <= end_time)]

delay_time_window['time'] = delay_time_window['time'].round(3)
ts = sorted(delay_time_window['time'].unique())

# %%
# run a repeated measures one-way ANOVA over every timepoint
masks = [0,1]
stats_list = []
for mask in masks:
    df_mask = delay_time_window[delay_time_window['mask'] == mask].copy()
    for it in ts:
        evoked_it_time = df_mask[df_mask['time'] == it].copy()
        stats = pg.rm_anova(data=evoked_it_time, dv='pupils', subject='subID', within='Load')
        stats['time'] = it
        stats['mask'] = mask
        stats_list.append(stats)


# %%
# Concatenate all the results into a single DataFrame
ANOVA_timepoints_results_pos1_shifted_interpol = pd.concat(stats_list, ignore_index=True)
#ANOVA_timepoints_results_pos1_shifted_interpol.to_csv('../data/csv_files/ANOVA_timepoints_results_pos1_shifted_interpol.csv', index=False)

ANOVA_timepoints_results_pos1_shifted_interpol.to_csv('../data/csv_files/ANOVA_timepoints_results_new.csv', index=False)


# Filter the significant results
# sig_results_pos1_interpol_shifted = ANOVA_timepoints_results_pos1_shifted_interpol[ANOVA_timepoints_results_pos1_shifted_interpol['p-unc'] <= 0.05]
# sig_results_pos1_interpol_shifted.to_csv('../data/csv_files/sig_results_pos1_interpol_shifted.csv', index=False)

sig_results_shifted = ANOVA_timepoints_results_pos1_shifted_interpol[ANOVA_timepoints_results_pos1_shifted_interpol['p-unc'] <= 0.05]
sig_results_shifted.to_csv('../data/csv_files/sig_results_shifted.csv', index=False)


# %%
display(ANOVA_timepoints_results_pos1_shifted_interpol)
display(sig_results_shifted)
# %%
