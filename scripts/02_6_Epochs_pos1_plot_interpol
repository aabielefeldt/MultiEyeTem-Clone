# %% 
# read all_con_evoked dataframe

all_con_evoked_pos1_interpol = pd.read_csv('../data/Tables_and_Dataframes/all_con_evoked_pos1_interpol.csv')

# need to redo this
sig_results_shifted_interpol = pd.read_csv('../data/Tables_and_Dataframes/sig_results_shifted_interpol.csv')

# %% 

# since changing the errorbar to 'se' it only takes a minute to plot

fig, ax = plt.subplots(figsize=(10,8))

# stefan included get_axes in his code to show axvlines, seems to work without it though and even returns an error 
# ax = fig.get_axes()[0]

sns.lineplot(data=all_con_evoked_pos1_interpol, x='time', y='pupils', hue='Load', palette='crest', errorbar='se', ax=ax)

ax.axvline(1, color='black', alpha=0.33)
ax.axvline(2, color='black', alpha=0.66)
ax.axvline(3, color='black')  
ax.axvline(0, color='darkblue')  
# ax.axvline(6.5, color='blue')  


# Define y-coordinate for labels (as a fraction of the plot height)
label_y = 1.05  # Adjust this value as needed

# Add labels above the vertical lines

# these do not make sense either! 0 is always object position 1 no matter which condition
ax.text(3, ax.get_ylim()[1] * label_y, "onset delay, condition 3", color='black', alpha=0.33, fontsize=10, ha='center', rotation=45)
ax.text(2, ax.get_ylim()[1] * label_y, "onset delay, condition 2", color='black', alpha=0.66, fontsize=10, ha='center', rotation=45)
ax.text(1, ax.get_ylim()[1] * label_y, "onset delay, condition 1", color='black', fontsize=10, ha='center', rotation=45)

# the following two probably do not make sense because onset delay and onset probe are different in this case
ax.text(0, ax.get_ylim()[1] * label_y, "object position 1, all conditions",  color='darkblue', fontsize=10, ha='center', rotation=45)
#ax.text(6.5, ax.get_ylim()[1] * label_y, "onset probe object", color='blue', fontsize=10, ha='center', rotation=45)


# automatically changing the name to the set baseline
baseline = (all_con_evoked_pos1_interpol.at[0, 'baseline_start'], all_con_evoked_pos1_interpol.at[0, 'baseline_end'])
baseline_str = '_'.join(map(str, baseline))
name=f"pupil_fig_pos1_interpol_bl{baseline_str}.png"

# Include window that was used for the baseline
ax.axvspan(baseline[0], baseline[1], ymin=0, ymax=1, color='blue', alpha=0.4)

plt.suptitle('Pupil dilation across conditions', y=1.1, fontsize = 20)
plt.title(f'Applied baseline {baseline}', y=1.2, color='blue', alpha=0.4)

figures_folder = '/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/Figures'
figure_filepath = os.path.join(figures_folder, name)

plt.savefig(figure_filepath, bbox_inches = 'tight')



