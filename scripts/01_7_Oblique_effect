# might be useless for oblique effect


# Example function to calculate differences based on grouped DataFrame
def calculate_differences(df, chosen_column, condition=None):
    # Step 1: Group DataFrames according to the condition
    if condition == 1:
        df_grouped = df[df['items_presented'] == 1].groupby(['subID', 'object_cued_rot', 'probe_ori_cat']).agg({chosen_column: 'mean'}).reset_index()
    elif condition == 2:
        df_grouped = df[df['items_presented'] == 2].groupby(['subID', 'object_cued_rot', 'probe_ori_cat']).agg({chosen_column: 'mean'}).reset_index()
    elif condition == 3:
        df_grouped = df[df['items_presented'] == 3].groupby(['subID', 'object_cued_rot', 'probe_ori_cat']).agg({chosen_column: 'mean'}).reset_index()
    else:
        df_grouped = df.groupby(['subID', 'object_cued_rot', 'probe_ori_cat']).agg({chosen_column: 'mean'}).reset_index()

    # Step 2: Initialize a list to store results
    results = []

    # Step 3: Process each subID separately
    for sub_id, group in df_grouped.groupby('subID'):
        group = group.sort_values('object_cued_rot').reset_index(drop=True)

        # Calculate median subtracted orientations
        group['median_subtracted_oris'] = group['object_cued_rot'].rolling(window=2).median().fillna(0)

        # Calculate differences in the chosen column
        group[f'{chosen_column}_difference'] = group[chosen_column].diff()

        circular_diff = group[chosen_column].iloc[0] - group[chosen_column].iloc[-1]
        group.loc[group.index[0], f'{chosen_column}_difference'] = circular_diff

        results.append(group)

    # Concatenate all results into a single DataFrame
    df_with_diffs = pd.concat(results, ignore_index=True)

    return df_with_diffs


#%%

df_with_diffs_all = calculate_differences(df, chosen_column='acc_trial_concrete_cued', condition=None)
display(df_with_diffs_all)

df_with_diffs_all['absolute_differences'] = df_with_diffs_all['acc_trial_concrete_cued_difference'].abs()
display(df_with_diffs_all)

# plotting difference scores: 

# Get ordered list of unique target orientations
rots = df_with_diffs_all['median_subtracted_oris'].unique()
