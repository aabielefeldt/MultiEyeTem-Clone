# %% Load Metadata

df = pd.read_csv('../data/csv_files/df.csv')
good_partis = df['subID'].unique()
    
# Define paths for saving files
csv_save_dir = '../data/csv_files'
figures_save_dir = '../figures'

# %% 
# Oblique Effect

# Note: here I have 84 data points, probably two for each participant, that seems correct, I took a mean for the accuracy of every participant in both the cardinal and the oblique positions 

# Calculate mean accuracy for each category
mean_per_category = df.groupby('probe_ori_cat')['acc_trial_concrete_cued'].mean()
display(mean_per_category)

# %%
# per-participant accuracy across the two categories for all conditions

grouped_data_list = []
for i in good_partis:
    data = df[df['subID'] == i].groupby(['probe_ori_cat', 'subID'])['acc_trial_concrete_cued'].mean().reset_index()
    grouped_data_list.append(data)

# Concatenate the list of DataFrames into a single DadftaFrame
final_grouped_data_obli = pd.concat(grouped_data_list).reset_index()

oblique_data = final_grouped_data_obli[final_grouped_data_obli['probe_ori_cat'] == 'oblique']['acc_trial_concrete_cued']
cardinal_data = final_grouped_data_obli[final_grouped_data_obli['probe_ori_cat'] == 'cardinal']['acc_trial_concrete_cued']

# Statistics
# these have different results than the statistics below that I originally computed
# Note: which other statistic was I talking about here?

# t_statistic, p_value = stats.ttest_ind(cardinal_data, oblique_data)
result_ttest_obli = pg.ttest(cardinal_data, oblique_data)
display(result_ttest_obli)

# Access specific properties
p_value = result_ttest_obli['p-val'].values
t_statistic = result_ttest_obli['T'].values

# Define the significance level (alpha)
alpha = 0.05

if p_value < alpha:
    print("The t-test indicates a significant difference between accuracy in oblique vs. cardinal orientations, but check very low power")
else:
    print("The t-test does not indicate a significant difference between accuracy in oblique vs. cardinal orientations")

# %%

# Stripplot + Pointplot on mean accuracy for each participant
plt.figure(figsize=(10, 6))

palette = sns.color_palette("hls", n_colors=final_grouped_data_obli['probe_ori_cat'].nunique())

# Boxplot (distribution summary, transparent so dots are visible)
sns.boxplot(
    x='probe_ori_cat',
    y='acc_trial_concrete_cued',
    hue='probe_ori_cat',
    data=final_grouped_data_obli,
    palette=palette,
    showcaps=True,
    showfliers=False,
    whiskerprops={'linewidth':1.5},
    boxprops=dict(alpha=0.5),
    legend=False 
)

# Scatter of individual participants
sns.stripplot(
    x='probe_ori_cat',
    y='acc_trial_concrete_cued',
    hue='probe_ori_cat',
    data=final_grouped_data_obli,
    palette=palette,
    edgecolor='black',
    linewidth=1,
    jitter=True,
    alpha=0.7,
    dodge=False
)
sns.despine()
plt.title('Boxplot for Each Participant')
plt.xlabel('Cardinal vs Oblique Orientation Category')
plt.ylabel('Mean Accuracy')
plt.savefig(os.path.join(figures_save_dir, 'oblique_vs_cardinal_accuracy.png'))
plt.show()




# %%
# comparing load conditions:

# Note: why are there Nans in this?

all_p_obli_con = pd.DataFrame()

all_p_obli_con1 = []
all_p_obli_con2 = []
all_p_obli_con3 = []

# Iterate through each participant in good_partis
for i in good_partis:
    # Group the data for the current participant
    # data = df[df['subID'] == i].groupby(['probe_ori_cat'])['acc_trial_concrete_cued'].mean()
    participant_data_obli_con = df.loc[df['subID'] == i, ['probe_ori_cat', 'acc_trial_concrete_cued', 'object_cued_rot', 'items_presented']]
    #participant_data1 = df.loc[(df['subID'] == i) & (df['items_presented'] == 1), 'acc_trial_concrete_cued']
        # condition 1x
    #bp_con1 = participant_data.loc[participant_data['items_presented'] == 1].groupby('object_cued_rot')['button_press_clockwise'].agg(['mean', 'std']).reset_index()
    acc_obli_con1 = participant_data_obli_con.loc[participant_data_obli_con['items_presented'] == 1].groupby('probe_ori_cat')['acc_trial_concrete_cued'].agg(['mean', 'std']).reset_index()
    acc_obli_con1['subID'] = i
    acc_obli_con1['items_presented'] = 1
    all_p_obli_con1.append(acc_obli_con1)

    # condition 2
    #bp_con2 = participant_data.loc[participant_data['items_presented'] == 2].groupby('object_cued_rot')['button_press_clockwise'].agg(['mean', 'std']).reset_index()
    acc_obli_con2 = participant_data_obli_con.loc[participant_data_obli_con['items_presented'] == 2].groupby('probe_ori_cat')['acc_trial_concrete_cued'].agg(['mean', 'std']).reset_index()
    acc_obli_con2['subID'] = i
    acc_obli_con2['items_presented'] = 2
    all_p_obli_con2.append(acc_obli_con2)

    #bp_con3 = participant_data.loc[participant_data['items_presented'] == 3].groupby('object_cued_rot')['button_press_clockwise'].agg(['mean', 'std']).reset_index()
    acc_obli_con3 = participant_data_obli_con.loc[participant_data_obli_con['items_presented'] == 3].groupby('probe_ori_cat')['acc_trial_concrete_cued'].agg(['mean', 'std']).reset_index()
    acc_obli_con3['subID'] = i
    acc_obli_con3['items_presented'] = 3
    all_p_obli_con3.append(acc_obli_con3)

all_p_obli_con1_df = pd.concat(all_p_obli_con1)
all_p_obli_con2_df = pd.concat(all_p_obli_con2)
all_p_obli_con3_df = pd.concat(all_p_obli_con3)

all_p_obli_con = pd.concat([all_p_obli_con1_df, all_p_obli_con2_df, all_p_obli_con3_df])
all_p_obli_con['percentage'] = all_p_obli_con['mean']*100
display(all_p_obli_con)

# %%
# Perform repeated measures ANOVA
# performed directly on the df because same aggrevation within the function as if I would calculate the means first

anova_results_repeated = pg.rm_anova(data=df, dv='acc_trial_concrete_cued', within=['probe_ori_cat', 'items_presented'], subject='subID')
display(anova_results_repeated.round(4))
p_value = anova_results_repeated.loc[2, 'p-unc'] # indexing the second column to only have the interaction p-value
alpha = 0.05
if p_value < alpha:
    print("The ANOVA indicates a significant interaction in the oblique effect depending on the laod condition.")
else:
    print("The ANOVA does not indicate a significant interaction in the oblique effect depending on the laod condition.")

