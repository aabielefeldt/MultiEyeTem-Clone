#%%
import statsmodels.api as sm
import statsmodels.formula.api as smf

df_gee = df.dropna(subset=[
    "acc_trial_concrete_cued",
    "dist_to_cardinal_mem",
    "probe_away_from_cardinal",
    "items_presented",
    "subID"
]).copy()

correlation = sm.cov_struct.Independence()

df_gee["probe_away_from_cardinal"] = df_gee["probe_away_from_cardinal"].astype(int)
df_gee["items_presented"] = df_gee["items_presented"].astype(int)

geemodel = smf.gee(
    "acc_trial_concrete_cued ~ C(dist_to_cardinal_mem) * probe_away_from_cardinal * C(items_presented)",
    groups="subID",
    data=df_gee,
    family=sm.families.Binomial(),
    cov_struct = correlation
)

model_results = geemodel.fit()

model_results.summary()
# %%
model_results.cov_params()
geemodel.groups
geemodel.formula
model_results.params
model_results.predict()
geemodel.endog_names
geemodel.exog_names
geemodel.group_labels

ttest_results = model_results.t_test_pairwise(term_name='C(items_presented)')
ttest_results.result_frame


np.exp(model_results.conf_int())[0][0]
np.exp(model_results.conf_int())[1][0]
np.exp(model_results.params)
