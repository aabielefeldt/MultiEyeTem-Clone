# %% 
#  Subtrating Accuracy of Cardinal Positions from Oblique Positions 
# this is not different from the above anova, the only thing I could use this for would be to plot the interaction
# directly rather than plot the 3x2 plot but I dont think this would be any more straight forward 

# Subtracting differences in accuracy depending on cardinal vs oblique position
# Cardinal - Oblique Accuracy for every Load condition

obli_data_con1 = df.loc[df['items_presented']==1].groupby(['subID', 'items_presented', 'probe_ori_cat'])[('acc_trial_concrete_cued')].mean().reset_index()
obli_data_con2 = df.loc[df['items_presented']==2].groupby(['subID', 'items_presented', 'probe_ori_cat'])[('acc_trial_concrete_cued')].mean().reset_index()
obli_data_con3 = df.loc[df['items_presented']==3].groupby(['subID', 'items_presented', 'probe_ori_cat'])[('acc_trial_concrete_cued')].mean().reset_index()

obli_data_con1_piv = obli_data_con1.pivot(index=['subID', 'items_presented'], columns='probe_ori_cat', values='acc_trial_concrete_cued')
obli_data_con2_piv = obli_data_con2.pivot(index=['subID', 'items_presented'], columns='probe_ori_cat', values='acc_trial_concrete_cued')
obli_data_con3_piv = obli_data_con3.pivot(index=['subID', 'items_presented'], columns='probe_ori_cat', values='acc_trial_concrete_cued')


obli_data_con1_piv['Difference'] = obli_data_con1_piv['cardinal'].sub(obli_data_con1_piv['oblique'])
obli_data_con2_piv['Difference'] = obli_data_con2_piv['cardinal'].sub(obli_data_con2_piv['oblique'])
obli_data_con3_piv['Difference'] = obli_data_con3_piv['cardinal'].sub(obli_data_con3_piv['oblique'])

all_tables_subs = pd.concat([obli_data_con1_piv, obli_data_con2_piv, obli_data_con3_piv]).reset_index()
display(all_tables_subs)

plt.figure(figsize=(10,6))
sns.stripplot(data=all_tables_subs, x='items_presented', y='Difference', jitter=0.1) #(x='probe_ori_cat', y='acc_trial_concrete_cued', data=final_grouped_data_obli)
sns.pointplot(data=all_tables_subs, x='items_presented', y='Difference')
plt.title('Difference in Accuracy between Objects shown in Cardinal vs Oblique Positions per Load Condition')
plt.xlabel('Load Condition')
plt.ylabel('Mean Difference per participant')
plt.savefig(os.path.join(figures_save_dir, 'difference_accuracy_cardinal_oblique.png'))
plt.show()

# %%
# Anova on difference scores, same as doing it on the full df

result_anova_repeated = pg.rm_anova(data=all_tables_subs, dv='Difference', within=['items_presented'], subject='subID')

display(result_anova_repeated.round(4))
p_value = result_anova_repeated['p-unc'].values
alpha = 0.05
if p_value < alpha:
    print("The ANOVA indicates a significant difference in the oblique effect depending on the laod condition.")
else:
    print("The ANOVA does not indicate a significant difference in the oblique effect depending on the laod condition.")

