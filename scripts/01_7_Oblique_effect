#%% bar polar plot for accuracy per orientation (all conditions)

# Get ordered list of unique target orientations
rots = df['object_cued_rot'].unique()
rots.sort()   

fig = plt.figure()

# Change the projection to 'polar'
ax = fig.add_subplot(111, projection='polar')

# Get outer ylim for plotting radial lines
ylim = ax.get_ylim()

# Plot a radial line for each target orientation - colour matched to its kde distribution
# Then plot a radial line for the mean of each kde distribution
for r in range(len(rots)):
    theta = np.radians(rots[r])
    mean_acc = (df[df['object_cued_rot']==rots[r]]['acc_trial_concrete_cued']).mean()
    color = sns.hls_palette(16)[r]
    # ax.plot([theta, theta], [0, mean_bp], 'o--', c=sns.hls_palette(16)[r], alpha = 0.5, markersize=10)
    ax.bar([theta, theta], [0, mean_acc], color=color, alpha = 0.5, width = 0.3)
    unbiased = 0.5
    theta_circle = np.linspace(0, 2 * np.pi, 100)
    r_circle = np.full_like(theta_circle, unbiased)
    ax.plot(theta_circle, r_circle, color=color, alpha=0.3, linewidth=0.4)

    #ax.plot(theta_circle, r_circle, color=color, alpha=0.5, linewidth=0.4)


# Move r origin outwards to have a hollow circle in the middle for ~AesTHeTicS~
rorigin = -0.5*ylim[1]
ax.set_rorigin(rorigin)

# Remove yticks
ax.set_yticks([0.5])
ax.set_yticklabels(['0.5'])

# Note: ax.set_theta_offset(np.pi / 2) shifts the zero angle to the top of the plot (by 90°) (i.e., the positive y-axis).
# Set the direction of the zero angle - means zero is at the top for this plot!!
# "zero angle is the reference point from which angles are measured"
# ax.set_theta_offset(np.pi/2)
#ax.set_theta_direction(-1)
plt.show()

