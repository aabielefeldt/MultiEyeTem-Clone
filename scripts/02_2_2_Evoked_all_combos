# %%
# Importsconda
import mne
import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt
from pupil_utils import apply_baseline_nan_aware


# %% Load Metadata

df = pd.read_csv('../data/csv_files/df.csv')
good_partis = df['subID'].unique()

#%%

# Define all combos you're interested in
ori_cat_combos = df['trial_ori_cat_combo'].unique()

drop_log_rows = []

evoked_list = []

for i in good_partis:

    # Read participant data
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Epochs_even_newer"
    epoch_file = f"{folder_path}/{i}_even_newer-epo.fif"
    pupil_epoch = mne.read_epochs(epoch_file, preload=True, verbose=None)

    # applying baseline per eye and nan aware while dropping any epochs where the baseline period was nan in both eyes
    pupil_epoch_bl = apply_baseline_nan_aware(pupil_epoch, bmin=-0.1, bmax=0.0)
    baseline = pupil_epoch_bl.baseline
    
    # counting dropped epochs
    sum_dropped = sum('BAD_baseline_nan_both_eyes' in entry for entry in pupil_epoch_bl.drop_log)
    drop_log_rows.append({'subID': i, 'sum_dropped': sum_dropped})

    # combining channels
    pupil_ix = mne.pick_channels(pupil_epoch_bl.info["ch_names"], include=['pupil_left', 'pupil_right'])
    roi_dict = dict(pupils=pupil_ix)
    combine_nanmean = lambda data: np.nanmean(data, axis=1)
    pupil_epochs_combined_bl = mne.channels.combine_channels(pupil_epoch_bl, roi_dict, method=combine_nanmean)
    

    for combo in ori_cat_combos:
        # Select epochs for this trial combo
        try:
            selected_epochs = pupil_epochs_combined_bl[f"trial_ori_cat_combo == '{combo}'"]
        except Exception as e:
            print(f"Skipping {combo} for subject {i} due to missing data")
            continue
        
        # Averaging epochs based on orientation combo only, load is coded within ori combo and will then just 
        # be added to the df
        # Infer Load from number of non-'n' letters in combo (e.g., 'cnn' → 2 → Load = 1)
        n_items_presented = 3 - combo.count('n')
        load = n_items_presented
        
        # Crop duration (optional, can also infer from load if durations are fixed)
        crop_durations = {1: 7, 2: 8, 3: 9}
        selected_epochs.crop(-0.1, crop_durations[load])

        # Average and convert to DataFrame
        evoked = selected_epochs.average(method=lambda x: np.nanmean(x, axis=0))
        evoked_df = evoked.to_data_frame(scalings=1)
        evoked_df['Load'] = load
        evoked_df['subID'] = i
        evoked_df['trial_ori_cat_combo'] = combo

        evoked_list.append(evoked_df)
    
drop_log_df = pd.DataFrame(drop_log_rows)
evoked_df_all_combos = pd.concat(evoked_list, ignore_index=True)

# Saving
drop_log_df.to_csv('../data/csv_files/drop_log_df_evoked_all_combos.csv', index=False)
evoked_df_all_combos.to_csv('../data/csv_files/evoked_df_all_combos.csv', index=False)


# %%
# Shifting

# shifting the conditions so that the epochs that are epoched on pos1 are time-locked to the test onset
evoked_df_all_combos_shifted = evoked_df_all_combos.copy()
evoked_df_all_combos_shifted.loc[evoked_df_all_combos_shifted['Load']==1, 'time'] +=2
evoked_df_all_combos_shifted.loc[evoked_df_all_combos_shifted['Load']==2, 'time'] +=1
evoked_df_all_combos_shifted.loc[evoked_df_all_combos_shifted['Load']==3, 'time'] +=0

# %%
mask_partis = df[df['mask']==1]['subID'].unique().tolist()
nomask_partis = df[df['mask']==0]['subID'].unique().tolist()
# Adding column for mask
evoked_df_all_combos_shifted['mask'] = evoked_df_all_combos_shifted['subID'].apply(
    lambda x: 1 if x in mask_partis else 0)


mostly_cardinal = ['cnn', 'ccn', 'ccc', 'cco', 'coc', 'occ']
mostly_oblique = ['onn', 'oon', 'ooo', 'coo', 'oco', 'ooc']
category_map = {}
category_map.update({cat: 'mostly_cardinal' for cat in mostly_cardinal})
category_map.update({cat: 'mostly_oblique' for cat in mostly_oblique})

evoked_df_all_combos_shifted['cardinal_type'] = evoked_df_all_combos_shifted['trial_ori_cat_combo'].map(lambda x: category_map.get(x, 'mixed'))

only_cardinal = ['cnn', 'ccn', 'ccc']
only_oblique = ['onn', 'oon', 'ooo']
category_map = {}
category_map.update({cat: 'only_cardinal' for cat in only_cardinal})
category_map.update({cat: 'only_oblique' for cat in only_oblique})
evoked_df_all_combos_shifted['cardinal_type_only_one'] = evoked_df_all_combos_shifted['trial_ori_cat_combo'].map(lambda x: category_map.get(x, 'mixed'))

# also include rounding here
evoked_df_all_combos_shifted['time'] = evoked_df_all_combos_shifted['time'].round(3)

# Saving
evoked_df_all_combos_shifted.to_csv('../data/csv_files/evoked_df_all_combos_shifted.csv', index=False)






# %%
# plotting cardinal type pupil traces seperated by load and mask
masks = [0,1]
with sns.plotting_context(context='paper', font_scale=1.5): 
    for mask in masks:
        subset_mask = evoked_df_all_combos_shifted[evoked_df_all_combos_shifted['mask'] == mask]
        for load in [1,2,3]:
            subset = subset_mask[subset_mask['Load'] == load]
            fig, ax = plt.subplots(figsize=(12, 10), sharex=True, sharey=True)

            # Shades for 'all_cardinal' and 'all_oblique'
            cardinal_shades = ['#08306b', '#2171b5', '#deebf7']  # dark to light blue
            oblique_shades = ['#7f2704', '#d94801', '#fdd0a2']   # dark to light orange

            sns.lineplot(data=subset, x='time', y='pupils', hue='cardinal_type', errorbar='se', legend='full')

            sns.despine(fig=fig, ax=None, top=True, right=True, left=False, bottom=False, offset=None, trim=False)
            
            ax.axvline(0, color='black', alpha=0.33)
            ax.axvline(1, color='black', alpha=0.66)
            ax.axvline(2, color='black')  
            ax.axvline(3, color='darkblue')  
            ax.axvline(6.5, color='blue')  

            # Define y-coordinate for labels (as a fraction of the plot height)
            label_y = 1.05

            # Add labels above the vertical lines
            ax.text(0, ax.get_ylim()[1] * label_y, "object position 1", color='black', alpha=0.33, fontsize=10, ha='center', rotation=45)
            ax.text(1, ax.get_ylim()[1] * label_y, "object position 2", color='black', alpha=0.66, fontsize=10, ha='center', rotation=45)
            ax.text(2, ax.get_ylim()[1] * label_y, "object position 3", color='black', fontsize=10, ha='center', rotation=45)
            ax.text(3, ax.get_ylim()[1] * label_y, "onset delay", color='darkblue', fontsize=10, ha='center', rotation=45)
            ax.text(6.5, ax.get_ylim()[1] * label_y, "onset probe object", color='blue', fontsize=10, ha='center', rotation=45)

            # Set x-axis to show all whole numbers within range
            x_ticks = np.arange(int(evoked_df_all_combos_shifted['time'].min()), int(evoked_df_all_combos_shifted['time'].max()) + 1, 1)
            ax.set_xticks(x_ticks)
            ax.set_xticklabels(x_ticks)

            # Increase font size of x and y tick labels
            ax.tick_params(axis='x', labelsize=14)
            ax.tick_params(axis='y', labelsize=14)

            # Adding a legend
            ax.legend(loc='best', fontsize=12)
            # new_labels = ['Cardinal - Load 1', 'Cardinal - Load 2', 'Cardinal - Load 3', 'Oblique - Load 1', 'Oblique - Load 2', 'Oblique - Load 3']
            # for t, l in zip(ax.get_legend().texts, new_labels):
            #     t.set_text(l)
            # ax.set_title(f'{mask}', y=1.2, fontsize=16)

            # Adding a title
            plt.suptitle('Pupil dilation across conditions', y=1.15, fontsize = 20)
            plt.title(f'Mask = {mask} and Load = {load}', y=1.25, color='blue', alpha=0.4)
            plt.show()

# %%
