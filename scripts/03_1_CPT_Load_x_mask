# %%
# defining t-test statistics and parameters for all tests

def paired_t(X1, X2):
    t_vals, _ = stats.ttest_rel(X1, X2, axis=0)
    return t_vals

def independent_t(X1, X2):
    t_vals, _ = stats.ttest_ind(X1, X2, axis=0, equal_var=True)  # equal_var=False = Welch’s t-test vs equal_var=True -> pooled-variance t-test (Student’s t), use Welch only when groups are very unequal
    return t_vals


seed = 42
#%%

## 1 - Mask vs no Mask
##########

# using t-test (student's t) because more intepretable than f-test, using tcrit caluclated from function, two-tailed (tail=0), seed=42 to make result reproducible (42 is convention[meaning of life])
# results are the same with both tests
# should all be correct

cluster_results = {}

# Subset the data
df_mask = delay_time_window[delay_time_window['mask'] == 1]
df_nomask = delay_time_window[delay_time_window['mask'] == 0]


# Pivot to get subjects x timepoints
X1_df = df_mask.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')
X2_df = df_nomask.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')

# Align only on time because between subjects test
common_times = X1_df.columns.intersection(X2_df.columns)
times = common_times.to_numpy()

X1 = X1_df[common_times].values
X2 = X2_df[common_times].values

# threshold for independent samples t-test (students t)
# not for f-test
n1 = X1.shape[0]
n2 = X2.shape[0]
# Because we conduct a two-tailed test, we divide the p-value by 2 (which means
# we're making use of both tails of the distribution).
tcrit = t.ppf(1 - 0.025, df = (n1+n2-2))

T_obs, clusters, cluster_p_values, H0 = permutation_cluster_test(
    [X1, X2],
    n_permutations=5000, # using 10000 here because close to 0.05
    threshold=tcrit,        
    tail=0,               # 0 = two-tailed (direction of effect could go either way), tail=0 is ignored on f-test, needs to be one-tailed
    stat_fun=independent_t,
    seed=seed,     
    out_type='mask',
    verbose=True
)

alpha = 0.05
cluster_summaries = []

for i, c in enumerate(clusters):
    p_val = cluster_p_values[i]

    time_inds = c[0]
    t_vals = T_obs[time_inds]
    mean_t = t_vals.mean()
    direction = "Mask > No Mask" if mean_t > 0 else "No Mask > Mask"

    cluster_summaries.append({
        "cluster_id": i + 1,
        "start_time": times[time_inds][0],
        "end_time": times[time_inds][-1],
        "p_value": p_val,
        "mean_t": mean_t,
        "direction": direction
    })

# Turn into DataFrame
cluster_results_mask_vs_nomask = pd.DataFrame(cluster_summaries)

# Save to CSV
cluster_results_mask_vs_nomask.to_csv('../data/csv_files/cluster_results_mask_vs_nomask.csv', index=False)

display(cluster_results_mask_vs_nomask)

# Plot
plt.figure(figsize=(10, 5))
plt.plot(times, T_obs, label='T-values')
for i_c, c in enumerate(clusters):
    if cluster_p_values[i_c] < 0.05:
        plt.axvspan(times[c][0], times[c][-1], color='red', alpha=0.3)
plt.axhline(2, color='black', linestyle='--')
plt.title(f'Cluster Permutation Test (Mask vs no mask)')
plt.xlabel('Time (s)')
plt.ylabel('T-statistic')
plt.legend()
plt.tight_layout()
plt.show()

times = np.array(common_times)  # make sure it's ordered
X1_mean = X1.mean(axis=0)
X2_mean = X2.mean(axis=0)


plt.plot(times, X1_mean, label='mask')
plt.plot(times, X2_mean, label='nomask')


# Highlight significant clusters
for i_c, cluster in enumerate(clusters):
    if cluster_p_values[i_c] < 0.05:
        time_mask = cluster
        plt.axvspan(times[time_mask][0], times[time_mask][-1], color='red', alpha=0.3)

plt.legend()
