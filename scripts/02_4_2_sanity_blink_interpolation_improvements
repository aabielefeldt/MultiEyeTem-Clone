# %%
# Importsconda
import mne
import numpy as np
import pandas as pd
import itertools
import matplotlib.pyplot as plt
import seaborn as sns
import os

# %% Load Metadata
df = pd.read_csv('../data/csv_files/df.csv')
good_partis = df['subID'].unique()

# %%
# if qt is used as backend the kernel crashes
mne.viz.set_browser_backend('matplotlib')

# %%
# Trigger Dictionary
# these were set in the original experiment script, additional pairs were also set in the experiment except for "fixation", "saccade", and "BAD_blink". 
# Not sure if it is necessary to add them here because they are not relevant for what I am using the trigger_dict for 

n_objects = ['obj1', 'obj2', 'obj3']
n_positions = ['pos1', 'pos2', 'pos3']
n_orientations = [f'ori{i}' for i in range(1, 17)]

# Generate combinations of the three conditions
combinations = itertools.product(n_positions, n_objects, n_orientations)

# Create a dictionary to store the combinations
trigger_dict = {}

# Populate the dictionary with formatted combinations
for idx, combo in enumerate(combinations, start=1):
    trigger_dict['_'.join(combo)] = idx

additional_pairs = {
    "onset_concrete_cued_left": 220,
    "onset_concrete_cued_right": 221,
    "left_button_press": 241,
    "right_button_press": 242,
    "feedback_cued_item": 244,
    "mask": 245,
    "beginning/end_of_task": 246,
    "fixation": 247,
    "saccade": 248,
    "BAD_blink": 249
}

trigger_dict.update(additional_pairs)

# Extract values with "pos1" in the key, and key-value pairs
values_with_pos1 = [trigger_dict[key] for key in trigger_dict if "pos1" in key]
pos1_pairs = {key: trigger_dict[key] for key in trigger_dict if "pos1" in key}

# %% 
# creating folder for epochs
datafolder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data"
folder_name = f"Epochs_improved_blink_interpolation"
epochs_folderpath = os.path.join(datafolder_path, folder_name)
os.makedirs(epochs_folderpath, exist_ok=True)

#  %%
# Creating epochs timelocked to pos1

freqs = []
blink_stats_all = []

for i in ['TEPWRW']:
        
        # read file per subID
        folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/data_eyelink"
        eyelink_file = folder_path + "/" + i + ".asc"
        raw = mne.io.read_raw_eyelink(eyelink_file)
        sfreq = raw.info['sfreq']
        freq_pp = [i, sfreq]
        freqs.append(freq_pp)
        
        # Drop gaze channels
        # still a comma after the remaining channels in annotations
        drop_chs = ['xpos_right', 'xpos_left', 'ypos_right', 'ypos_left']
        raw.drop_channels(drop_chs)

        metadata_pp = df.loc[(df['subID'] == i)]

        # Get the original annotations
        annot = raw.annotations

        # Create new description list based on duration
        # this overwrites descriptions where necessary and keeps all other old ones
        new_descriptions = []

        for onset, duration, description, ch_names in zip(annot.onset, annot.duration, annot.description, annot.ch_names):
            if description == 'BAD_blink' and duration >= 1:
                new_descriptions.append('BAD_long_blink')
            else:
                new_descriptions.append(description)

        # Create a new Annotations object
        new_annot = mne.Annotations(onset=annot.onset,
                                duration=annot.duration,
                                description=new_descriptions,
                                ch_names=annot.ch_names)


        # Replace annotations in raw
        raw.set_annotations(new_annot)

        #################
        # Set NaN for BAD_long_blinks in pupil channels

        for onset, duration, description, ch_names in zip(new_annot.onset, new_annot.duration, new_annot.description, new_annot.ch_names):
            if description != 'BAD_long_blink':
                continue
            for ch in ch_names:
                if ch.startswith('pupil_'):
                    ch_idx = raw.ch_names.index(ch)
                    start = int(onset * sfreq)
                    stop = int((onset + duration) * sfreq)
                    raw._data[ch_idx, start:stop] = np.nan
            
        ####################
        # Does the Custom Mapping intefer with the blink interpolations at all?
        
        # Create Custom Mapping to map annotations found to event ids that match the triggers used
        # does this overwrite the new_annots? -> apparently not
        annotations = raw.annotations
        custom_mapping = {}
        # Generate mapping for annotations with integer descriptions
        max_id = 0
        for description in annotations.description:
            if description.isdigit():
                event_id = int(description)
                custom_mapping[description] = event_id
                if event_id > max_id:
                    max_id = event_id
        next_event_id = max_id + 1
        # Add non-numeric descriptions with unique event IDs
        for description in annotations.description:
            if not description.isdigit():
                if description not in custom_mapping:  # Ensure each description is only mapped once
                    custom_mapping[description] = next_event_id
                    next_event_id += 1
        sorted_custom_mapping = dict(sorted(custom_mapping.items(), key=lambda item: int(item[0]) if item[0].isdigit() else float('inf')))

        # Get events from annotations using the custom mapping 
        events_from_annot, event_dict = mne.events_from_annotations(
            raw, event_id=sorted_custom_mapping)

        # necessary events per participant - these are only those events that are also present in the event_id=pos1_pairs
        # this might be done better in the newest version of mne. 
        events_pos1 = events_from_annot[np.isin(events_from_annot, [values_with_pos1])[:, -1]]

        ########################

        # interpolate blinks (adapted to buffer=[0.05, 0.2])
        mne.preprocessing.eyetracking.interpolate_blinks(raw, buffer=[0.05, 0.2], match='BAD_blink', interpolate_gaze=False)
        
        
        # Epoching
        pupil_epochs_pos1 = mne.Epochs(
            raw,
            events_pos1,
            event_id=pos1_pairs,
            tmin=-0.1,
            tmax=9,
            baseline=None,
            metadata=metadata_pp,
            picks=['pupil_left', 'pupil_right'],
            event_repeated='merge',
            preload=True,
            reject_by_annotation=False
        )
        
        # --- Counting stats ---

        epoch_starts = pupil_epochs_pos1.events[:, 0] / sfreq
        epoch_duration = pupil_epochs_pos1.tmax - pupil_epochs_pos1.tmin

        def intervals_overlap(s1, e1, s2, e2):
            return max(s1, s2) < min(e1, e2)

        num_long_blinks_in_epoch = 0
        num_long_blinks_out_epoch = 0
        num_blinks_in_epoch = 0
        num_blinks_out_epoch = 0

        total_long_blink_duration_in = 0
        total_long_blink_duration_out = 0
        total_blink_duration_in = 0
        total_blink_duration_out = 0

        for onset, duration, description in zip(new_annot.onset, new_annot.duration, new_annot.description):
            blink_start = onset
            blink_end = onset + duration
            in_epoch = False
            for epoch_start in epoch_starts:
                epoch_end = epoch_start + epoch_duration
                if intervals_overlap(blink_start, blink_end, epoch_start, epoch_end):
                    in_epoch = True
                    break
            if description == 'BAD_long_blink':
                if in_epoch:
                    num_long_blinks_in_epoch += 1
                    total_long_blink_duration_in += duration
                else:
                    num_long_blinks_out_epoch += 1
                    total_long_blink_duration_out += duration
            elif description == 'BAD_blink':
                if in_epoch:
                    num_blinks_in_epoch += 1
                    total_blink_duration_in += duration
                else:
                    num_blinks_out_epoch += 1
                    total_blink_duration_out += duration

        # Count total number and duration of all BAD_long_blink annotations (where data set to NaN)
        total_long_blinks = sum(1 for d in new_annot.description if d == 'BAD_long_blink')
        total_long_blink_duration = sum(d for d, desc in zip(new_annot.duration, new_annot.description) if desc == 'BAD_long_blink')
        m, total_long_blink_duration_min = divmod(total_long_blink_duration, 60)
        m, total_long_blink_duration_in_min = divmod(total_long_blink_duration_in, 60)
        m, total_long_blink_duration_out_min = divmod(total_long_blink_duration_out, 60)

        # Store subject stats
        blink_stats = {
            'subID': i,
            'total_long_blinks': total_long_blinks,
            'total_long_blink_duration': total_long_blink_duration,
            'total_long_blink_duration_min': total_long_blink_duration_min,
            'long_blinks_in_epoch': num_long_blinks_in_epoch,
            'long_blinks_out_epoch': num_long_blinks_out_epoch,
            'long_blink_duration_in_epoch': total_long_blink_duration_in,
            'long_blink_duration_in_epoch_min': total_long_blink_duration_in_min,
            'long_blink_duration_out_epoch': total_long_blink_duration_out,
            'long_blink_duration_out_epoch_min': total_long_blink_duration_out_min,
            'blinks_in_epoch': num_blinks_in_epoch,
            'blinks_out_epoch': num_blinks_out_epoch,
            'blink_duration_in_epoch': total_blink_duration_in,
            'blink_duration_out_epoch': total_blink_duration_out,
        }
    
        blink_stats_all.append(blink_stats)

        # Save epoch in fif format to a specified folder
        filename = f"{i}_new_interpol_and_nan-epo.fif"
        epochs_path = os.path.join(epochs_folderpath, filename)
        pupil_epochs_pos1.save(epochs_path, overwrite=True, split_size='1.8GB', split_naming='bids', verbose=None)

# creating a dataframe with all subjects sampling frequency to later select differently sampled datafiles
freqs_df = pd.DataFrame(freqs, columns=['subID', 'frequency'])

blink_stats_df = pd.DataFrame(blink_stats_all)
display(blink_stats_df)

# %%

raw_copy = raw.copy()

# Crop only the copy
# can I also plot an area where no task was performed? are breaks included in the data?

raw_copy.crop(tmin=790, tmax=1000)
# Filter annotations: keep only those with description "bad blink" and bad long blink
blink_annot = raw.annotations[np.isin(raw.annotations.description, ["blink", "BAD_long_blink"])]

# Assign filtered annotations to the copied raw object
raw_copy.set_annotations(blink_annot)

raw_copy.plot(events=events_pos1, event_id=trigger_dict, scalings=1e3, show=False, show_options=True, duration=2000, picks= ['pupil_left', 'pupil_right'])



#%%
histo_all = pd.DataFrame()

for i in ['TEPWRW']:
    
    # reading epochs per participant
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Epochs_pos1"
    epoch_file = folder_path + "/" + i + "_pos1_interpol-epo.fif"
    pupil_epoch = mne.read_epochs(epoch_file, preload=True, verbose=None)

    # combining channels
    pupil_ix = mne.pick_channels(pupil_epoch.info["ch_names"], include=['pupil_left', 'pupil_right'])
    roi_dict = dict(pupils=pupil_ix)
    pupil_epochs_combined = mne.channels.combine_channels(pupil_epoch, roi_dict, method="mean")

    pupil_epochs_combined_df = pupil_epochs_combined.to_data_frame()
    pupil_epochs_combined_df['subID'] = i

    histo_all = pd.concat([histo_all, pupil_epochs_combined_df])

    plt.figure()
    plt.title(f'SubID {i} - distribution of pupil size within epochs')
    sns.histplot(data=pupil_epochs_combined_df, bins=100, stat='density', x='pupils', legend=True)

    # Set fixed axis limits
    plt.xlim(0, 2e9)
    plt.ylim(0, 6e-9)
    plt.show()
    # Save the figure
    name=f"pupil_size_histogram_{i}_old_blink_interpolation.png"
    figures_folder = '/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/figures/pupil_size'
    figure_filepath = os.path.join(figures_folder, name)

    plt.savefig(figure_filepath, bbox_inches = 'tight')

plt.figure()
plt.title(f'distribution of pupil size within epochs all subIDs')
sns.histplot(data=histo_all, bins=100, stat='density', x='pupils', legend=True)
plt.show()

# %%
