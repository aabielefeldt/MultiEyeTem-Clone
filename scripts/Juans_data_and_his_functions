        # chance = np.full_like(ap, 0.5)  # Set chance values
        # sem = np.nanstd(dat[i], axis=1, ddof=1) / np.sqrt(dat[i].shape[1])  # Standard error
        # uppererror = ap + sem
        # lowerror = ap - sem

        # Polar plot commands
        # pl.append(plt.polar(theta, chance, linestyle='--', color='k', linewidth=2))
        plt.polar(theta, ap, linestyle='-', linewidth=2.5)

        # # Plot the mean behavior points
        # pl.append(plt.polar(theta, ap, marker='o', markersize=8))

