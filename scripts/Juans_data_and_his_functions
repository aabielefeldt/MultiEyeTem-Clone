        plt.legend([pl[0], pl[1], pl[3], pl[4]], 
                   ['unbiased (B=0)', f'model (B={Aave})', 'mean behaviour', 'SEM behaviour'], 
                   loc='lower center')

    plt.ylim(0, 0.7)  # Set radial limits
    plt.title(titulo)
    plt.show()  # Show the plot

