def deg2rad(degrees):
    """Convert degrees to radians."""
    return degrees * (np.pi / 180)

def angdiff(angle1, angle2):
    """Calculate the angular difference between two angles."""
    return np.mod(angle1 - angle2 + np.pi, 2 * np.pi) - np.pi

def sigmoid(x, s, b):
    """Sigmoid function for computing probabilities."""
    return 1 / (1 + np.exp(-s * (x - b)))

def orivectors(n, testd):
    """Generate orientation vectors for circles and squares.
    
    Args:
        n (int): Number of equidistant rotations.
        testd (float): Displacement of test stimuli in degrees.
    
    Returns:
        oriC (ndarray): Circle orientation vectors.
        oriP (ndarray): Positive test orientation vectors.
        oriN (ndarray): Negative test orientation vectors.
    """
    # Generate orientation vectors
    oriC = np.linspace(0, 2 * np.pi, n, endpoint=False)  # Circle orientations
    oriP = deg2rad(np.linspace(0, 360, n))  # Positive test orientations
    oriN = deg2rad(np.linspace(180, 360, n))  # Negative test orientations
    return oriC, oriP, oriN

def squircleBehave2(s, A, CardPrez, behB, makefig):
    """Calculate accuracy and bias based on mixed orientations.
    
    Args:
        s (float): Noise (in memory/decision-making).
        A (float): Key parameter for mixing (squircle).
        CardPrez (float): Reducing noise near cardinal by this factor.
        behB (ndarray): Behavioral biases.
        makefig (bool): Whether to create plots.
    
    Returns:
        AccuMix (ndarray): Mixed accuracy values.
        BiasMix (ndarray): Mixed bias values.
    """
    
    # Settings/preparation
    n = 16  # Number of equidistant rotations
    testd = 6.43  # +/- displacement of test stimuli in degrees

    # Get orientation vectors
    oriC, oriP, oriN = orivectors(n, testd)

    # Prepare categorical vectors
    oriS1 = np.concatenate((np.full(4, 45), np.full(4, 135), np.full(4, 225), np.full(4, 315)))  # Cat
    oriS1 = deg2rad(oriS1)
    oriS2 = np.concatenate(([0, 0], np.full(4, 90), np.full(4, 180), np.full(4, 270), [360, 360]))  # Anti-cat
    oriS2 = deg2rad(oriS2)

    # Mix orientations directly
    if A >= 0:
        oriM = A * oriS1 + (1 - A) * oriC
    else:
        fA = -A  # Flip since it's negative
        oriM = fA * oriS2 + (1 - fA) * oriC

    # Calculate angular distances
    dTp = angdiff(oriM, oriP)  # Distance to positive test orientations
    dTn = angdiff(oriM, oriN)  # Distance to negative test orientations

    # (optional) better precision at cardinal
    sW = np.tile([CardPrez, 1, 1, CardPrez], 4)  # Weighting for cardinal presentations
    sW /= np.mean(sW)  # Ensure the mean of the vector is 1
    s *= sW  # Adjust noise by the weights

    # Predict choices under either model
    CP_P = sigmoid(dTp, s, 0)  # Probability of sensing "ccw" when test was "ccw" (correct)
    CP_N = sigmoid(dTn, s, 0)  # Probability of sensing "ccw" when test was "cw" (error)

    # Calculate accuracy and bias
    AccuMix = (CP_P + (1 - CP_N)) / 2  # Mixed accuracy
    BiasMix = (CP_P + CP_N) / 2  # Mixed bias

    # Optional plots
    if makefig:
        # Plot accuracy
        plt.figure(figsize=(10, 5))
        plt.subplot(1, 2, 1)
        plt.polar(oriC, AccuMix, marker='o', linestyle='-', label='Accuracy')
        plt.title('Accuracy')
        plt.legend()

        # Plot bias
        plt.subplot(1, 2, 2)
        plt.polar(oriC, BiasMix, marker='o', linestyle='-', label='Bias')
        plt.title('Bias')
        plt.legend()

        plt.suptitle(f'Squircle A={A}')
        plt.show()

    return AccuMix, BiasMix

# Example usage (commented out, to be replaced with actual data)
