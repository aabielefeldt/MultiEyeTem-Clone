    # custom_color = [0.9, 0, 0.7]  # Custom color
    # colores = np.vstack((custom_color, colores))  # Stack the custom color on top
    
    # Append the first value to close the polar plot
    theta = np.concatenate((theta, [theta[0]]))
    uno = np.vstack((uno, uno[0, :]))  # Append the first row
    dos = np.vstack((dos, dos[0, :]))  # Append the first row

    dat = [uno, dos]  # Store uno and dos in a list
    #legcoun = 2
    pl = []

    for i in range(2):
