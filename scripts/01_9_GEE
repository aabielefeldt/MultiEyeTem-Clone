# This plot shows the difference between assumed accuracy (per load and subject) and the accuracy 
# per orientation of probe items
# could maybe rename the x axis ticks to reflect the probe moved away thing better
# this is now showing the difference in accuracy between probe away and probe towards in reference to mean accuracy in that cardinal or oblique orientation per subId
# maybe remove the orienation specific accuracy again. Could in principle do both, if using orientation specific I am 
# taking the oblique effect out of the equation and assuming that accuracy is the same for all orienations but different for probe direction

baseline_load = (
    df.groupby(["subID","items_presented"]) # , "dist_to_cardinal_mem"
    ["acc_trial_concrete_cued"]
    .mean()
    .rename("baseline_acc")
)

groupi = (
    df.groupby([
        "subID",
        "items_presented",
        "dist_probe_to_cardinal",
        "dist_to_cardinal_mem",
        "probe_away_from_cardinal"


        ])["acc_trial_concrete_cued"].mean().reset_index())

groupi = groupi.merge(baseline_load, on=["subID","items_presented"]) # , "dist_to_cardinal_mem"

groupi["delta_acc"] = (groupi["acc_trial_concrete_cued"] - groupi["baseline_acc"])

fig, ax = plt.subplots()

sns.barplot(
    data=groupi,
    x="dist_probe_to_cardinal",
    y="delta_acc",
    hue="items_presented",
    errorbar="se",
    ax=ax
)

