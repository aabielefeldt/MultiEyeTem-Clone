# %%
# Bar Polar plot

partis = df['subID'].unique()

# Get ordered list of unique target orientations
oris = df['object_test_rot_cued'].unique()
oris.sort()   

fig = plt.figure(figsize=(7,7))

# Change the projection to 'polar'
ax = fig.add_subplot(111, projection='polar')

# Get outer ylim for plotting radial lines
ylim = ax.get_ylim()
colors1 = sns.color_palette("Paired", 4)
colors2 = sns.color_palette("Paired", 4)
colors2.reverse()
colors = np.vstack((colors1, colors2)*5)

colors_load = sns.color_palette("flare", 3)

colors1 = sns.diverging_palette(225, 15, s=70, n=4, l=50, center='light')
colors2 = sns.diverging_palette(225, 15, s=70, n=4, l=50, center='light')
colors2.reverse()

colors = np.vstack((colors1, colors2)*10)

# Plot a radial line for each target orientation - colour matched to its kde distribution
# Then plot a radial line for the mean of each kde distribution
for i in range(len(oris)):
    theta = np.radians(oris[i])
    mean_acc = (df[df['object_test_rot_cued']==oris[i]]['acc_trial_concrete_cued']).mean()
    l1_acc = (df[(df['object_test_rot_cued']==oris[i])&(df['items_presented']== 1)]['acc_trial_concrete_cued']).mean()
    l2_acc = (df[(df['object_test_rot_cued']==oris[i])&(df['items_presented']== 2)]['acc_trial_concrete_cued']).mean()
    l3_acc = (df[(df['object_test_rot_cued']==oris[i])&(df['items_presented']== 3)]['acc_trial_concrete_cued']).mean()
    
    color = colors[i]
    offset = 0.02
    
    # ax.plot([theta, theta], [0, mean_bp], 'o--', c=sns.hls_palette(16)[r], alpha = 0.5, markersize=10)
    ax.bar([theta, theta], [0, mean_acc], color=color, alpha = 0.5, width = 0.1)
    # ax.bar([theta-offset, theta-offset], [0, l1_acc], color=color, alpha = 0.3, width = 0.05)
    # ax.bar([theta, theta], [0, l2_acc], color=color, alpha = 0.3, width = 0.05)
    # ax.bar([theta-offset, theta-offset], [0, l3_acc], color=color, alpha = 0.3, width = 0.05)

    ax.plot([theta, theta], [0, l1_acc], '--', c=color, alpha = 0.5, linewidth=1)
    ax.plot([theta+offset, theta+offset], [0, l2_acc], '--', c=color, alpha = 0.5,linewidth=1)
    ax.plot([theta-offset, theta-offset], [0, l3_acc], '--', c=color, alpha = 0.5, linewidth=1)
    ax.plot([theta], [l1_acc], 'o', c=colors_load[0], alpha = 1, markersize=5, label='Load 1')
    ax.plot([theta+offset], [l2_acc], 's', c=colors_load[1], alpha = 1, markersize=5, label='Load 2')
    ax.plot([theta-offset], [l3_acc], '*', c=colors_load[2], alpha = 1, markersize=5, label='Load 3')

# Move r origin outwards to have a hollow circle in the middle for ~AesTHeTicS~
# ax.set_ylim(0.4)
# ylim = ax.get_ylim()
# rorigin = -0.005*ylim[1]
# rorigin = 0.9*ylim[1]
# ax.set_rorigin(rorigin)

ax.set_rmin(0.4)
ax.set_rorigin(0)
ax.grid(True)
y_ticks = np.arange(0.4, 1, 0.2)
ax.set_yticks(y_ticks)

handles, labels = ax.get_legend_handles_labels()
by_label = dict(zip(labels, handles))
ax.legend(by_label.values(), by_label.keys(), loc='center')

# set x ticks to object_cued rotation
# ticks = df['object_cued_rot'].unique()
# ticks2 = np.radians(ticks)
# ax.set_xticks(ticks2, minor=False)


# Set the direction of the zero angle
ax.set_theta_offset(np.pi/2)

#plt.legend()
plt.show()



