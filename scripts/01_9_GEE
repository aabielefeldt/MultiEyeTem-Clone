#%%
baseline_load = (
    df.groupby(["subID","items_presented"]) # , "dist_to_cardinal_mem"
    ["acc_trial_concrete_cued"]
    .mean()
    .rename("baseline_acc")
)

groupi = (
    df.groupby([
        "subID",
        "items_presented",
        "dist_probe_to_cardinal",
        "dist_to_cardinal_mem",
        "probe_away_from_cardinal"
        ])["acc_trial_concrete_cued"].mean().reset_index())

groupi = groupi.merge(baseline_load, on=["subID","items_presented"]) # , "dist_to_cardinal_mem"

groupi["delta_acc"] = (groupi["acc_trial_concrete_cued"] - groupi["baseline_acc"])

# %%
g = sns.catplot(
    data=groupi,
    x="probe_away_from_cardinal",
    y="delta_acc",
    hue="items_presented",
    col="dist_to_cardinal_mem",
    kind="bar",
    errorbar="se",
    height=4,
    aspect=1,
)

# axis labels
g.set_axis_labels(
    "Probe direction",
    "Accuracy deviation from subject mean"
)

# rename facet titles
g.set_titles("Distance to cardinal axis: {col_name}°")

# change x tick labels
for ax in g.axes.flat:
    ax.set_xticklabels(["Toward cardinal", "Away from cardinal"])

# set y limits
g.set(ylim=(-0.15, 0.15))

# remove seaborn legend
g._legend.remove()

plt.legend(
    title="Set size",
    loc="upper right"
)

plt.tight_layout()
plt.show()
