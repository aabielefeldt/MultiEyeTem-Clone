# %%
# this is probably not statistically valid?

baseline_load = (
    df.groupby(["subID","items_presented"])
    ["acc_trial_concrete_cued"]
    .mean()
    .rename("baseline_acc")
)
cond = (
    df.groupby([
        "subID",
        "items_presented",
        "dist_to_cardinal_mem",
        "probe_away_from_cardinal"
        ])["acc_trial_concrete_cued"].mean().reset_index())

cond = cond.merge(baseline_load, on=["subID","items_presented"])

cond["delta_acc"] = (cond["acc_trial_concrete_cued"] - cond["baseline_acc"])


anova = pg.rm_anova(
    data=cond,
    dv="delta_acc",
    within=[
        "dist_to_cardinal_mem",
        "probe_away_from_cardinal"
    ],
    subject="subID"
)

display(anova.round(4))




# %%
# Lineplot on difference
agg = (cond.groupby(["items_presented","dist_to_cardinal_mem","probe_away_from_cardinal"])
          .agg(mean_delta=("delta_acc","mean"),
               sem_delta=("delta_acc", lambda x: x.std(ddof=1)/np.sqrt(len(x))))
          .reset_index())
fig, ax = plt.subplots()

sns.lineplot(
    data=agg,
    x="dist_to_cardinal_mem",
    y="mean_delta",
    hue="items_presented",
    style="probe_away_from_cardinal",
    markers=True,
    dashes=True,
    ax=ax,
    legend='full'
)

x_ticks = agg['dist_to_cardinal_mem'].unique()
ax.set_xticks(x_ticks)

handles, labels = ax.get_legend_handles_labels()
new_labels = ["1", "2", "3"]
leg1 = ax.legend(handles[1:4], new_labels, title="Load", loc="center left")
new_labels2 = ["Toward cardinal", "Away from cardinal"]
leg2 = ax.legend(handles[5:], new_labels2, title="Probe direction", loc="upper right")
ax.add_artist(leg1)

plt.show()

