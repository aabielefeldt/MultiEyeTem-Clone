    theta_adjusted = -theta + ((np.pi/2)) % (2*np.pi)

    all_con = mbp_all[mbp_all['object_cued_rot']==oris[i]]['pressed_away_from_cardinal'].mean()
    con1 = mbp_con1[mbp_con1['object_cued_rot']==oris[i]]['pressed_away_from_cardinal'].mean()
    con2 = mbp_con2[mbp_con2['object_cued_rot']==oris[i]]['pressed_away_from_cardinal'].mean()
    con3 = mbp_con3[mbp_con3['object_cued_rot']==oris[i]]['pressed_away_from_cardinal'].mean()
    
    thetas.append(theta)
    thetas_adjusted.append(theta_adjusted)
