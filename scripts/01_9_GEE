#%%
# Generalized estimating equations

df_gee = df.dropna(subset=[
    "acc_trial_concrete_cued",
    "dist_to_cardinal_mem",
    "probe_away_from_cardinal",
    "items_presented",
    "subID"
]).copy()


df_gee["probe_away_from_cardinal"] = df_gee["probe_away_from_cardinal"].astype(int)
df_gee["items_presented"] = df_gee["items_presented"].astype(int)

correlation = sm.cov_struct.Independence()

geemodel = smf.gee(
    "acc_trial_concrete_cued ~ C(dist_to_cardinal_mem) * probe_away_from_cardinal * C(items_presented)", # 
    groups="subID",
    data=df_gee,
    family=sm.families.Binomial(),
    cov_struct = correlation
)

model_results = geemodel.fit(cov_type='robust')

# %%
# Build a clean coefficient table
coefs_table = pd.DataFrame({
    "term": model_results.params.index,
    "estimate": model_results.params.values,
    "std_error": model_results.bse.values,
    "z": model_results.tvalues.values,
    "p_value": model_results.pvalues.values,
    "ci_lower": model_results.conf_int()[0].values,
    "ci_upper": model_results.conf_int()[1].values,
})

# Optional: odds ratios for logistic GEE
coefs_table["odds_ratio"] = np.exp(coefs_table["estimate"])
# coefs_table["or_ci_lower"] = np.exp(coefs_table["ci_lower"])
# coefs_table["or_ci_upper"] = np.exp(coefs_table["ci_upper"])

# Create APA-style CI column
coefs_table["95% CI"] = (
    "[" 
    + coefs_table["ci_lower"].map("{:.2f}".format)
    + ", "
    + coefs_table["ci_upper"].map("{:.2f}".format)
    + "]"
)

coefs_table = coefs_table.rename(columns={
    "term": "Term",
    "estimate": "Estimate",
    "std_error": "SE",
    "z": "z",
    "p_value": "p",
    # "ci_lower": "CI Lower",
    # "ci_upper": "CI Upper",
    "odds_ratio": "OR",
    # "or_ci_lower": "OR CI Lower",
    # "or_ci_upper": "OR CI Upper",
}).round(3)

coefs_table["Term"] = (
    coefs_table["Term"]
    .str.replace(r"C\(dist_to_cardinal_mem\)", "Distance", regex=True)
    .str.replace(r"C\(items_presented\)", "Set size", regex=True)
    .str.replace("probe_away_from_cardinal", "Probe away", regex=False)
    .str.replace(r"\[T\.", " ", regex=True)   # level indicator
    .str.replace(r"\]", "", regex=True)
    .str.replace(":", " × ", regex=False)     # interaction separator
)
coefs_table["p"] = (
    coefs_table["p"]
    .apply(lambda x: "< .001" if x < 0.001 else f"{x:.3f}".lstrip("0").rstrip("0").rstrip("."))
)

# Drop separate CI columns
coefs_table = coefs_table.drop(columns=["ci_lower", "ci_upper"])

# Reorder columns
coefs_table = coefs_table[
    ["Term", "Estimate", "SE", "z", "p", "OR", "95% CI"]
]

# Save CSV
coefs_table.to_csv("../data/csv_files/gee_coefficients_table.csv", index=False)

# Save LaTeX
coefs_table.to_latex(
    "../data/csv_files/gee_coefficients_table.tex",
    index=False,
    float_format="%.3f"
)
# %%
# %%
# Estimated Marginal Means (EMMs)

# build grid
grid = pd.DataFrame({"dist_to_cardinal_mem": [11.25, 33.75],})
grid = grid.merge(pd.DataFrame({"probe_away_from_cardinal":[0,1]}), how="cross")
grid = grid.merge(pd.DataFrame({"items_presented":[1,2,3]}), how="cross")

# Get prediction from model results -> Estimated Marginal Means (EMMs)
# predictions representing the average, expected value of a response variable for each level of a factor, adjusted for other variables
pred = model_results.get_prediction(grid)
sf = pred.summary_frame()  # mean, mean_se on *linear predictor* scale; plus CIs on linear scale

# Combine with grid
emms = grid.copy()
emms["prob"] = sf["mean"]
emms["se_prob"] = sf["mean_se"]
emms["ci_low"] = sf["mean_ci_lower"]
emms["ci_high"] = sf["mean_ci_upper"]


#necessary?
emms["dist_to_cardinal_mem"] = emms["dist_to_cardinal_mem"].astype(float)
emms["items_presented"] = emms["items_presented"].astype(int)
emms["probe_away_from_cardinal"] = emms["probe_away_from_cardinal"].astype(int)

# full table:
# emms:
emms = emms.sort_values(["items_presented","dist_to_cardinal_mem","probe_away_from_cardinal"])

# collapsed to look at contrasts by probe direction and distance and load with differences:
# Create wide table by probe direction to compute differences
dist_prob_load_emms = emms.pivot_table(
    index=["items_presented","dist_to_cardinal_mem"],
    columns="probe_away_from_cardinal",
    values="prob"
).reset_index()

dist_prob_load_emms.columns = ["items_presented","dist_to_cardinal_mem","p_toward","p_away"]  # 0=toward, 1=away
dist_prob_load_emms["diff_away_minus_toward"] = dist_prob_load_emms["p_away"] - dist_prob_load_emms["p_toward"]

dist_probe_emms_nopiv = emms.groupby(['dist_to_cardinal_mem', 'probe_away_from_cardinal'])['prob'].mean().reset_index()

# collapsed to look at contrasts by probe direction and distancewith differences:
dist_probe_emms = emms.pivot_table(
    index=["dist_to_cardinal_mem"],
    columns="probe_away_from_cardinal",
    values="prob"
).reset_index()

dist_probe_emms.columns = ["dist_to_cardinal_mem","p_toward","p_away"]  # 0=toward, 1=away
dist_probe_emms["diff_away_minus_toward"] = dist_probe_emms["p_away"] - dist_probe_emms["p_toward"]

# collapsed to look at contrasts by probe direction and distance with differences:
# but this time difference between cardinal and oblique orientation within pressed away category
dist_probe_emms2 = emms.pivot_table(
    index=["probe_away_from_cardinal"],
    columns="dist_to_cardinal_mem",
    values="prob"
).reset_index()

dist_probe_emms2.columns = ["probe_away_from_cardinal","11.25","33.75"]  # 0=toward, 1=away
dist_probe_emms2["diff_near_minus_far"] = dist_probe_emms2["33.75"] - dist_probe_emms2["11.25"]

emms_dist_load = emms.pivot_table(
    index=["dist_to_cardinal_mem"],
    columns="items_presented",
    values="prob"
).reset_index()
emms_dist_load

emms_dist_load.columns = ["dist_to_cardinal_mem", 1,2,3]  # 0=toward, 1=away
emms_dist_load["diff_1_minus_2"] = emms_dist_load[1] - emms_dist_load[2]
emms_dist_load["diff_2_minus_3"] = emms_dist_load[2] - emms_dist_load[3]

# %%
emms = emms.round(3).reset_index()
dist_prob_load_emms = dist_prob_load_emms.round(3).reset_index()
dist_probe_emms = dist_probe_emms.round(3).reset_index()
dist_probe_emms2 = dist_probe_emms2.round(3).reset_index()
emms_dist_load = emms_dist_load.round(3).reset_index()
dist_probe_emms_nopiv = dist_probe_emms_nopiv.round(3).reset_index()

emms.to_csv('../data/csv_files/emms.csv', index=False)
dist_prob_load_emms.to_csv('../data/csv_files/dist_prob_load_emms.csv', index=False)
dist_probe_emms.to_csv('../data/csv_files/dist_probe_emms.csv', index=False)
dist_probe_emms2.to_csv('../data/csv_files/dist_probe_emms2.csv', index=False)
emms_dist_load.to_csv('../data/csv_files/emms_dist_load.csv', index=False)
dist_probe_emms_nopiv.to_csv('../data/csv_files/dist_probe_emms_nopiv.csv', index=False)

