# %%
# Importsconda
import mne
import numpy as np
import pandas as pd
from datetime import datetime

# %% Load Metadata

df = pd.read_csv('../data/df.csv')
good_partis = df['subID'].unique()

# %%
# if qt is used as backend the kernel crashes
# this can probably be deleted once run, but might just keep in in to be safe
mne.viz.set_browser_backend('matplotlib')


# %%

filepath = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Epochs_data_2024-02-29_13:54/REUNMA-epo.fif"

aves = pd.DataFrame()

for i in good_partis:
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem//multieyetem/data/Epochs_data_2024-02-29_13:54"

    epoch_file = folder_path + "/" + i + "-epo.fif"

    pupil_epochs = mne.read_epochs(epoch_file, proj=True, preload=True, verbose=None)

    pupil_ix = mne.pick_channels(pupil_epochs.info["ch_names"], include=['pupil_left', 'pupil_right'])

    roi_dict = dict(pupils=pupil_ix)
    roi_evoked = mne.channels.combine_channels(pupil_epochs, roi_dict, method="mean")
    # roi_evoked.plot()
    ave = roi_evoked.average()
    # ave.plot()

    # how can I save them according to their subIDs
    ave_pp = ave.to_data_frame()
    ave_pp['subID'] = i
    aves = pd.concat([aves, ave_pp])
    # aves.append([ave.to_data_frame(), i])

# %%

