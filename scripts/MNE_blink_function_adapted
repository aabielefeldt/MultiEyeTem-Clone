import numpy as np

def match_annotations_one_to_one(
    annotations,
    pupil_channels,
    match=(
        "velo_blink_interp",
        "blink",
        "BAD_velo_blink",
        "BAD_blink",
        "merged_blink_interp",
    ),
    tol_seconds=0.05,
):
    """
    Returns one-to-one matches between the first two channels (in pupil_channels order)
    that have relevant annotations.

    Match criteria:
      - same description
      - abs(onset difference) <= tol_seconds

    Output:
      matched_pairs: list of (idx_chA, idx_chB) where each is an index into `annotations`
      info: dict with some useful extras (channels used, unmatched, etc.)
    """
    match_set = set(match)

    # --- collect relevant indices per channel, grouped by description ---
    by_ch_desc = {}
    for ch in pupil_channels:
        desc_map = {d: [] for d in match_set}
        for i, ann in enumerate(annotations):
            if ann.get("description") not in match_set:
                continue
            ch_names = ann.get("ch_names")
            if ch_names is None or ch not in ch_names:
                continue
            desc_map[ann["description"]].append(i)

        # sort each description's indices by onset
        for d in match_set:
            desc_map[d].sort(key=lambda idx: annotations.onset[idx])

        # keep only if there is at least one relevant index
        if any(len(v) for v in desc_map.values()):
            by_ch_desc[ch] = desc_map

    present = [ch for ch in pupil_channels if ch in by_ch_desc]
    if len(present) < 2:
        return [], {"channels_used": present, "reason": "Fewer than 2 channels with relevant annotations"}

    chA, chB = present[0], present[1]

    matched_pairs = []
    unmatched_A = []
    unmatched_B = []

    # --- one-to-one matching per description using a two-pointer walk ---
    for desc in match_set:
        idxsA = by_ch_desc[chA][desc]
        idxsB = by_ch_desc[chB][desc]

        onA = np.asarray(annotations.onset)[idxsA]
        onB = np.asarray(annotations.onset)[idxsB]

        i = j = 0
        while i < len(idxsA) and j < len(idxsB):
            dt = onB[j] - onA[i]

            if abs(dt) <= tol_seconds:
                # match -> consume both (one-to-one)
                matched_pairs.append((int(idxsA[i]), int(idxsB[j])))
                i += 1
                j += 1
            elif dt < -tol_seconds:
                # B is earlier -> B can't match this A (too early), advance B
                j += 1
            else:
                # A is earlier -> A can't match this B (too early), advance A
                i += 1

        # leftovers are unmatched for that description
        unmatched_A.extend(map(int, idxsA[i:]))
        unmatched_B.extend(map(int, idxsB[j:]))

    info = {
        "channels_used": (chA, chB),
        "tol_seconds": tol_seconds,
        "n_matches": len(matched_pairs),
        "unmatched": {chA: unmatched_A, chB: unmatched_B},
    }

    return matched_pairs, info

