# does not work yet I think
import numpy as np
import mne

def merge_matched_pairs_into_new_annotations(
    raw,
    matches,
    new_description=None,
    keep_channel_names=True,
    strategy="union",  # "union" or "left" or "right" or "midpoint"
):
    """
    Creates a new annotation per match and deletes the two originals used.

    Parameters
    ----------
    raw : mne.io.Raw
        The Raw object whose annotations will be modified.
    matches : list[dict]
        Output from match_annotations_one_to_one_records(...).
        Must contain idxA, idxB, onsetA, onsetB, durationA, durationB, desc, ch_namesA, ch_namesB.
    new_description : str or None
        If None, uses the original desc from the match record (matches[k]["desc"]).
        If str, uses that for all merged annotations (e.g. "blink_both_eyes").
    keep_channel_names : bool
        If True, merged annotation gets combined ch_names from both sides.
        If False, merged annotation uses ch_names=None.
    strategy : str
        How to set onset/duration:
          - "union": onset=min(onsets), end=max(ends), duration=end-onset  (recommended)
          - "left": use left onset/duration
          - "right": use right onset/duration
          - "midpoint": onset=mean(onsets), duration=min(durationA, durationB)

    Returns
    -------
    raw : mne.io.Raw
        Same raw object, with updated annotations.
    summary : dict
        Counts + indices deleted/created.
    """

    annotations = raw.annotations
    n_before = len(annotations)

    # ---- Build merged annotations fields ----
    new_onset = []
    new_duration = []
    new_desc = []
    new_ch_names = []

    to_delete = set()

    for m in matches:
        idxA, idxB = m["idxA"], m["idxB"]
        to_delete.add(idxA)
        to_delete.add(idxB)

        onsetA, durA = m["onsetA"], m["durationA"]
        onsetB, durB = m["onsetB"], m["durationB"]
        endA = onsetA + durA
        endB = onsetB + durB

        desc = new_description if new_description is not None else m["desc"]

        if strategy == "union":
            onset = min(onsetA, onsetB)
            end = max(endA, endB)
            duration = max(0.0, end - onset)
        elif strategy == "left":
            onset, duration = onsetA, durA
        elif strategy == "right":
            onset, duration = onsetB, durB
        elif strategy == "midpoint":
            onset = 0.5 * (onsetA + onsetB)
            duration = min(durA, durB)
        else:
            raise ValueError(f"Unknown strategy: {strategy}")

        if keep_channel_names:
            chs = []
            for side in ("ch_namesA", "ch_namesB"):
                v = m.get(side)
                if v:
                    chs.extend(list(v))
            # unique, stable order
            chs = list(dict.fromkeys(chs))  # uses dict keys order; safe if you haven't overwritten dict!
            ch_names = chs if len(chs) else None
        else:
            ch_names = None

        new_onset.append(onset)
        new_duration.append(duration)
        new_desc.append(desc)
        new_ch_names.append(ch_names)

    # ---- Create the new Annotations object ----
    new_ann = mne.Annotations(
        onset=new_onset,
        duration=new_duration,
        description=new_desc,
        ch_names=new_ch_names
    )

    # ---- Delete originals then append merged ----
    # IMPORTANT: delete expects indices relative to current annotations
    # convert set -> sorted list; deleting in descending order is safe in many APIs,
    # but MNE's Annotations.delete accepts an array and handles it.
    del_idx = np.array(sorted(to_delete), dtype=int)
    annotations2 = annotations.copy()
    annotations2.delete(del_idx)

    # add merged annotations
    annotations2 = annotations2 + new_ann

    # optional: sort by onset (handy for cleanliness)
    order = np.argsort(annotations2.onset)
    annotations2 = annotations2[order]

    raw.set_annotations(annotations2)

    summary = {
        "n_before": n_before,
        "n_deleted": int(len(del_idx)),
        "n_created": int(len(new_ann)),
        "n_after": len(raw.annotations),
        "deleted_indices": del_idx,
    }
    return raw, summary