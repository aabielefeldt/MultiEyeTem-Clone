# %%
# Importsconda
import mne
import pandas as pd

# %% Load Metadata

df = pd.read_csv('../data/csv_files/df.csv')
good_partis = df['subID'].unique()

mask_partis = df[df['mask']==1]['subID'].unique().tolist()
nomask_partis = df[df['mask']==0]['subID'].unique().tolist()

# %%
# if qt is used as backend the kernel crashes
# mne.viz.set_browser_backend('matplotlib')

# %%
# appending all epochs into one list while:
# combining both pupil channels
# applying baseline
# seperating by condition
# cropping according to condition
# averaging epochs


evoked_df_only_Oblique = pd.DataFrame()

for i in good_partis:
    
    # reading epochs per participant
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Epochs_pos1"
    epoch_file = folder_path + "/" + i + "_pos1_interpol-epo.fif"
    pupil_epoch = mne.read_epochs(epoch_file, preload=True, verbose=None)
    
    # combining channels
    pupil_ix = mne.pick_channels(pupil_epoch.info["ch_names"], include=['pupil_left', 'pupil_right'])
    roi_dict = dict(pupils=pupil_ix)
    pupil_epochs_combined = mne.channels.combine_channels(pupil_epoch, roi_dict, method="mean")

    # applying baseline
    pupil_epochs_combined_bl = pupil_epochs_combined.apply_baseline(baseline=(-0.1, 0))
    baseline = pupil_epochs_combined.baseline

    # only using Oblique trials
    # pupil_epochs_Oblique = pupil_epochs_combined_bl['acc_trial_concrete_cued==1']

    # seperating per load condition
    con1_epochs_pos1 = pupil_epochs_combined_bl["items_presented == 1"]
    con1_epochs_Oblique = con1_epochs_pos1['Orientation_Bin == "Ori Bin B" or Orientation_Bin == "Ori Bin C"']
    con1_epochs_Cardinal = con1_epochs_pos1['Orientation_Bin == "Ori Bin A" or Orientation_Bin == "Ori Bin D"']
    con2_epochs_pos1 = pupil_epochs_combined_bl["items_presented == 2"]
    con2_epochs_Oblique = con2_epochs_pos1['Orientation_Bin == "Ori Bin B" or Orientation_Bin == "Ori Bin C"']
    con2_epochs_Cardinal = con2_epochs_pos1['Orientation_Bin == "Ori Bin A" or Orientation_Bin == "Ori Bin D"']
    con3_epochs_pos1 = pupil_epochs_combined_bl["items_presented == 3"]
    con3_epochs_Oblique = con3_epochs_pos1['Orientation_Bin == "Ori Bin B" or Orientation_Bin == "Ori Bin C"']
    con3_epochs_Cardinal = con3_epochs_pos1['Orientation_Bin == "Ori Bin A" or Orientation_Bin == "Ori Bin D"']

    # shortening the epochs based on condition (crop defaults to inclduing tmax)
    con1_epochs_Oblique.crop(-0.1, 7)
    con2_epochs_Oblique.crop(-0.1, 8)
    con3_epochs_Oblique.crop(-0.1, 9)
    con1_epochs_Cardinal.crop(-0.1, 7)
    con2_epochs_Cardinal.crop(-0.1, 8)
    con3_epochs_Cardinal.crop(-0.1, 9)

    # averaging per load condition
    con1_ave_Oblique = con1_epochs_Oblique.average()
    con2_ave_Oblique = con2_epochs_Oblique.average()
    con3_ave_Oblique = con3_epochs_Oblique.average()
    con1_ave_Cardinal = con1_epochs_Cardinal.average()
    con2_ave_Cardinal = con2_epochs_Cardinal.average()
    con3_ave_Cardinal = con3_epochs_Cardinal.average()

    # adding individual averaged data to dataframe including load and subID
    # Oblique trials
    con1_ave_df_Oblique = con1_ave_Oblique.to_data_frame()
    con1_ave_df_Oblique['Load'] = 1
    con1_ave_df_Oblique['subID'] = i
    con1_ave_df_Oblique['Cardinal_Category'] = 'Oblique'
    con2_ave_df_Oblique = con2_ave_Oblique.to_data_frame()
    con2_ave_df_Oblique['Load'] = 2
    con2_ave_df_Oblique['subID'] = i
    con2_ave_df_Oblique['Cardinal_Category'] = 'Oblique'
    con3_ave_df_Oblique = con3_ave_Oblique.to_data_frame()
    con3_ave_df_Oblique['Load'] = 3
    con3_ave_df_Oblique['subID'] = i
    con3_ave_df_Oblique['Cardinal_Category'] = 'Oblique'

    # Cardinal trials
    con1_ave_df_Cardinal = con1_ave_Cardinal.to_data_frame()
    con1_ave_df_Cardinal['Load'] = 1
    con1_ave_df_Cardinal['subID'] = i
    con1_ave_df_Cardinal['Cardinal_Category'] = 'Cardinal'
    con2_ave_df_Cardinal = con2_ave_Cardinal.to_data_frame()
    con2_ave_df_Cardinal['Load'] = 2
    con2_ave_df_Cardinal['subID'] = i
    con2_ave_df_Cardinal['Cardinal_Category'] = 'Cardinal'
    con3_ave_df_Cardinal = con3_ave_Cardinal.to_data_frame()
    con3_ave_df_Cardinal['Load'] = 3
    con3_ave_df_Cardinal['subID'] = i
    con3_ave_df_Cardinal['Cardinal_Category'] = 'Cardinal'

    # concatenating to evoked_df_only_Oblique
    evoked_df_only_Oblique = pd.concat([evoked_df_only_Oblique, con1_ave_df_Oblique])
    evoked_df_only_Oblique = pd.concat([evoked_df_only_Oblique, con2_ave_df_Oblique])
    evoked_df_only_Oblique = pd.concat([evoked_df_only_Oblique, con3_ave_df_Oblique])
    evoked_df_only_Oblique = pd.concat([evoked_df_only_Oblique, con1_ave_df_Cardinal])
    evoked_df_only_Oblique = pd.concat([evoked_df_only_Oblique, con2_ave_df_Cardinal])
    evoked_df_only_Oblique = pd.concat([evoked_df_only_Oblique, con3_ave_df_Cardinal])
    evoked_df_only_Oblique['baseline_start'] = baseline[0]
    evoked_df_only_Oblique['baseline_end'] = baseline[1]

evoked_df_only_Oblique = evoked_df_only_Oblique.reset_index()
display(evoked_df_only_Oblique)
evoked_df_only_Oblique.to_csv('../data/csv_files/evoked_df_only_Oblique.csv', index=False)

# %%
# Shifting

# shifting the conditions so that the epochs that are epoched on pos1 are time-locked to the test onset
evoked_df_only_Oblique_shifted = evoked_df_only_Oblique.copy()
evoked_df_only_Oblique_shifted.loc[evoked_df_only_Oblique_shifted['Load']==1, 'time'] +=2
evoked_df_only_Oblique_shifted.loc[evoked_df_only_Oblique_shifted['Load']==2, 'time'] +=1
evoked_df_only_Oblique_shifted.loc[evoked_df_only_Oblique_shifted['Load']==3, 'time'] +=0

#Adding column for mask
evoked_df_only_Oblique_shifted['mask'] = evoked_df_only_Oblique_shifted['subID'].apply(
    lambda x: 'mask' if x in mask_partis else 'no_mask')


evoked_df_only_Oblique_shifted.to_csv('../data/csv_files/evoked_df_only_Oblique_shifted.csv', index=False)
# %%
