# %%
# Importsconda
import mne
import numpy as np
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
from mne.stats import permutation_cluster_test, f_oneway, permutation_cluster_1samp_test
from scipy import stats
from scipy.stats import zscore
from scipy.ndimage import gaussian_filter1d
from scipy.stats import t

# %% 
# read evokes seperated by oblique vs cardinal
df = pd.read_csv('../data/csv_files/df.csv')
good_partis = df['subID'].unique()
mask_partis = df[df['mask']==1]['subID'].unique().tolist()
nomask_partis = df[df['mask']==0]['subID'].unique().tolist()

# evoked_df_shifted = pd.read_csv('../data/csv_files/evoked_df_shifted.csv')

evoked_df_all_combos_shifted = pd.read_csv('../data/csv_files/evoked_df_all_combos_shifted.csv')
# sig_results_shifted_cardinal_category = pd.read_csv('../data/csv_files/sig_results_shifted_cardinal_category.csv')

 # %% Rounding the time of all to be identical between participants, ultimately move this to where the evoked dfs are created
# evoked_df_shifted['time'] = evoked_df_shifted['time'].round(3)
evoked_df_all_combos_shifted['time'] = evoked_df_all_combos_shifted['time'].round(3)

#%%
# parameters

seed=42
n_perm=5000

#%%
# Data preparation for tests:

# exluding participant?

# blink_outlier_subIDs = ['GJL7U8'] # , 'Z16JQR', 'AGYVK9', 'T4LJ1R', 'TEPWRW'
# evoked_df_all_combos_shifted_excluded = evoked_df_all_combos_shifted[~evoked_df_all_combos_shifted['subID'].isin(blink_outlier_subIDs)]

# cropping to delay time window
start_time = 3
end_time = 6.5
# delay_time_window = evoked_df_all_combos_shifted_excluded[(evoked_df_all_combos_shifted_excluded['time'] >= start_time) & (evoked_df_all_combos_shifted_excluded['time'] <= end_time)]
delay_time_window = evoked_df_all_combos_shifted[(evoked_df_all_combos_shifted['time'] >= start_time) & (evoked_df_all_combos_shifted['time'] <= end_time)]

# z-scoring data
delay_time_window = delay_time_window.copy()

# Z-score within each subject (across all times and trials)
delay_time_window['pupils_z'] = delay_time_window.groupby('subID')['pupils'].transform(
    lambda x: zscore(x, nan_policy='omit')
)



#%%
# 1.1 - Cardinal vs Oblique only trials
# same number of trials in all trial-orientation combos and load conditions
# cluster permutation test of only cardinal trials vs only oblique trials (ignoring mixed trials, and ignoring load and mask)
# now with time window, rounding and z-scoring

df_card = delay_time_window[delay_time_window['cardinal_type_only_one']=='only_cardinal']
df_obli = delay_time_window[delay_time_window['cardinal_type_only_one']=='only_oblique']
#df_mixed = delay_time_window[delay_time_window['cardinal_type_only_one']=='mixed']

# Use mean to aggregate multiple entries per subID/time
X1_df = df_card.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')
X2_df = df_obli.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')

# Make sure both have the same subjects and times
common_subs = X1_df.index.intersection(X2_df.index)
common_times = X1_df.columns.intersection(X2_df.columns)
times = common_times.to_numpy()

# Align them
X1 = X1_df.loc[common_subs, common_times].to_numpy()
X2 = X2_df.loc[common_subs, common_times].to_numpy()

Xdiff = X2 - X1                       # (n_subjects, n_times)
n_sub = Xdiff.shape[0]
# Because we conduct a two-tailed test, we divide the p-value by 2 (which means
# we're making use of both tails of the distribution).
tcrit = t.ppf(1 - 0.025, df=n_sub - 1)  # two-tailed cluster-forming threshold

T_obs, clusters, cluster_p_values, H0 = permutation_cluster_1samp_test(
    Xdiff,
    n_permutations=n_perm,
    threshold=tcrit,
    tail=0,
    seed=seed,
    out_type="mask",
    verbose=True
)

# Store results
cluster_results = {
    "T_obs": T_obs,
    "clusters": clusters,
    "cluster_p_values": cluster_p_values,
    "times": times
}
print(cluster_p_values)

# Plot
plt.figure(figsize=(10, 5))
plt.plot(times, T_obs, label='T-values')
for i_c, c in enumerate(clusters):
    if cluster_p_values[i_c] < 0.05:
        plt.axvspan(times[c][0], times[c][-1], color='red', alpha=0.3)
plt.axhline(0, color='black', linestyle='--')
plt.title(f'Cluster Permutation Test (cardinal vs oblique trials)')
plt.xlabel('Time (s)')
plt.ylabel('T-statistic')
plt.legend()
plt.tight_layout()
plt.show()

# %%
# 1.2 - Cardinal vs Oblique trials (seperated by load)
# cluster permutation test for cardinal vs oblique pupil dilation but for every load condition seperately (but not by mask) and within time window
# is seperating by load ok in this case? are the number of trials per condition equals and/or are they confounded somehow?

cluster_results = {}

for load in [1, 2, 3]:
    print(f"\nRunning cluster test for Load {load}...")

    # Subset the data
    df_load = delay_time_window[delay_time_window['Load'] == load]
    df_card = df_load[df_load['cardinal_type_only_one'] == 'only_cardinal']
    df_obli = df_load[df_load['cardinal_type_only_one'] == 'only_oblique']

    # Pivot to get subjects x timepoints
    X1_df = df_card.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')
    X2_df = df_obli.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')

    # Make sure both have the same subjects and times
    common_subs = X1_df.index.intersection(X2_df.index)
    common_times = X1_df.columns.intersection(X2_df.columns)
    times = common_times.to_numpy()

    # Align them
    X1 = X1_df.loc[common_subs, common_times].to_numpy()
    X2 = X2_df.loc[common_subs, common_times].to_numpy()

    Xdiff = X2 - X1                       # (n_subjects, n_times)
    n_sub = Xdiff.shape[0]
    # Because we conduct a two-tailed test, we divide the p-value by 2 (which means
    # we're making use of both tails of the distribution).
    tcrit = t.ppf(1 - 0.025, df=n_sub - 1)  # two-tailed cluster-forming threshold

    T_obs, clusters, cluster_p_values, H0 = permutation_cluster_1samp_test(
        Xdiff,
        n_permutations=n_perm,
        threshold=tcrit,
        tail=0,
        seed=seed,
        out_type="mask",
        verbose=True
    )

    # Store results
    cluster_results[load] = {
        "T_obs": T_obs,
        "clusters": clusters,
        "cluster_p_values": cluster_p_values,
        "times": times
    }
    print(cluster_results[load]['cluster_p_values'])

    # Plot
    plt.figure(figsize=(10, 5))
    plt.plot(times, T_obs, label='T-values')
    for i_c, c in enumerate(clusters):
        if cluster_p_values[i_c] < 0.05:
            plt.axvspan(times[c][0], times[c][-1], color='red', alpha=0.3)
    plt.axhline(0, color='black', linestyle='--')
    plt.title(f'Cluster Permutation Test (Load {load})')
    plt.xlabel('Time (s)')
    plt.ylabel('T-statistic')
    plt.legend()
    plt.tight_layout()
    plt.show()

    # putting with the respective data analysis on top for now. check that that is correct
    # this would look good as a plot but is this legit?, do the same for the load conditions also
    times = np.array(common_times)  # make sure it's ordered
    X1_mean = X1.mean(axis=0)
    X2_mean = X2.mean(axis=0)

    plt.plot(times, X1_mean, label='Mostly Cardinal')
    plt.plot(times, X2_mean, label='Mostly Oblique')

    # Highlight significant clusters
    for i_c, cluster in enumerate(clusters):
        if cluster_p_values[i_c] < 0.05:
            time_mask = cluster
            plt.axvspan(times[time_mask][0], times[time_mask][-1], color='red', alpha=0.3)

    plt.legend()
    plt.title('Cluster Permutation Test')
    plt.xlabel('Time (s)')
    plt.ylabel('Pupil size')
    plt.show()


#%%
# 2.1 Only cardinal and oblique vs mixed in load 2 and 3 separately
# Check both only one orientation category trials vs mixed trials (could do the same as a linear contrast where all oblique wouldn't contribute really, but maybe this is actually more sound)
# maybe this isn't ideal still because of the entanglement between trial type and load?
# delay_time_window.groupby('Load')['cardinal_type_only_one'].value_counts()
# delay_time_window.groupby('Load')['trial_ori_cat_combo'].value_counts()
# same amount of trials for sum of both only-one-type-trials in load 2
# -> much more mixed trials in load 3 than sum of only-one-type-trials
# but since trial count is the same across subjects and I am creating a contrast per subject, this should be fine
# could also equalize trial counts by subsampling - taking equal number of random trials in bigger condition to smaller condition

# now running seperately for load, effect only exists in load 3 
# but also needs to be seperated per load otherwise an unequal number of trials from either load is contributing to the conditions

for load in [2,3]:

    df_load = delay_time_window[delay_time_window['Load']==load]
    df_only_one = df_load[(df_load['cardinal_type_only_one']=='only_cardinal') | (df_load['cardinal_type_only_one']=='only_oblique')]
    df_mixed = df_load[df_load['cardinal_type_only_one']=='mixed']

    # Use mean to aggregate multiple entries per subID/time
    X1_df = df_only_one.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')
    X2_df = df_mixed.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')

    # Make sure both have the same subjects and times
    common_subs = X1_df.index.intersection(X2_df.index)
    common_times = X1_df.columns.intersection(X2_df.columns)
    times = common_times.to_numpy()

    # Align them
    X1 = X1_df.loc[common_subs, common_times].to_numpy()
    X2 = X2_df.loc[common_subs, common_times].to_numpy()

    Xdiff = X2 - X1                       # (n_subjects, n_times)
    n_sub = Xdiff.shape[0]
    # Because we conduct a two-tailed test, we divide the p-value by 2 (which means
    # we're making use of both tails of the distribution).
    tcrit = t.ppf(1 - 0.025, df=n_sub - 1)  # two-tailed cluster-forming threshold

    T_obs, clusters, cluster_p_values, H0 = permutation_cluster_1samp_test(
        Xdiff,
        n_permutations=n_perm,
        threshold=tcrit,
        tail=0,
        seed=seed,
        out_type="mask",
        verbose=True
    )

    # Store results
    cluster_results = {
        "T_obs": T_obs,
        "clusters": clusters,
        "cluster_p_values": cluster_p_values,
        "times": times
    }
    print(cluster_p_values)

    # Plot
    plt.figure(figsize=(10, 5))
    plt.plot(times, T_obs, label='T-values')

    for i_c, c in enumerate(clusters):
        if cluster_p_values[i_c] < 0.05:
            plt.axvspan(times[c][0], times[c][-1], color='red', alpha=0.3)
    plt.axhline(0, color='black', linestyle='--')
    plt.title(f'Cluster Permutation Test (one-category trials vs mixed trials Load {load})')
    plt.xlabel('Time (s)')
    plt.ylabel('T-statistic')
    plt.legend()
    plt.tight_layout()
    plt.show()

    # putting with the respective data analysis on top for now. check that that is correct
    # this would look good as a plot but is this legit?, do the same for the load conditions also
    times = np.array(common_times)  # make sure it's ordered
    X1_mean = X1.mean(axis=0)
    X2_mean = X2.mean(axis=0)

    plt.plot(times, X1_mean, label='One orientation type trial')
    plt.plot(times, X2_mean, label='Mixed orientation type trial')

    # Highlight significant clusters
    for i_c, cluster in enumerate(clusters):
        if cluster_p_values[i_c] < 0.05:
            time_mask = cluster
            plt.axvspan(times[time_mask][0], times[time_mask][-1], color='red', alpha=0.3)

    plt.legend()
    plt.title(f'Cluster Permutation Test (one-category trials vs mixed trials Load {load}')
    plt.xlabel('Time (s)')
    plt.ylabel('Pupil size')
    plt.show()

# %%
# putting all loads and categories into one plot

plt.figure()
cats_loads = {}
for load in [2,3]:
    delay_load = delay_time_window[delay_time_window['Load']==load]
    df_only_one = delay_load[(delay_load['cardinal_type_only_one']=='only_cardinal') | (delay_load['cardinal_type_only_one']=='only_oblique')]
    df_mixed = delay_load[delay_load['cardinal_type_only_one']=='mixed']
    one_type = df_only_one.groupby(['time'])['pupils_z'].mean()
    mixed = df_mixed.groupby(['time'])['pupils_z'].mean()
    cats_loads[load] = {'one_type': one_type, 'mixed': mixed}

df_cats_load2 = pd.DataFrame(cats_loads[2])
df_cats_load3 = pd.DataFrame(cats_loads[3])

df_cats_loads = df_cats_load2.merge(df_cats_load3, on=['time'], suffixes=[2,3])

plt.figure()
sns.lineplot(df_cats_loads, x='time', y='one_type2', label='Load2 - one type')
sns.lineplot(df_cats_loads, x='time', y='mixed2', label='Load2 - mixed')
sns.lineplot(df_cats_loads, x='time', y='one_type3', label='Load3 - one type')
sns.lineplot(df_cats_loads, x='time', y='mixed3', label='Load3 - mixed')
plt.legend()
plt.title('Cluster Permutation Test')
plt.xlabel('Time (s)')
plt.ylabel('Pupil size')
plt.show()




