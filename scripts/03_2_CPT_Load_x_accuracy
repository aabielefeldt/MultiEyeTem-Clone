# %%
# Importsconda

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.stats import zscore
from mne.stats import permutation_cluster_test, f_oneway, permutation_cluster_1samp_test
from scipy import stats
from scipy.stats import t, ttest_rel, zscore, f
from IPython.display import display

# %% 
# read evokeds and metadata
df = pd.read_csv('../data/csv_files/df.csv')
evoked_df_accuracy_shifted = pd.read_csv('../data/csv_files/evoked_df_only_correct_shifted.csv')
evoked_df_accuracy = pd.read_csv('../data/csv_files/evoked_df_accuracy.csv')

# %%
# Data Preparation 

evoked_df_acc = evoked_df_accuracy_shifted.copy()

evoked_df_acc['time'] = evoked_df_acc['time'].round(3)

# zscore the complete time-frame, not ideal because load conditions contribute differently due to longer trials for higher load
# if I am only looking at false vs correct, this is probably fine though
# evoked_df_acc['pupils'] = evoked_df_acc.groupby('subID')['pupils'].transform(lambda x: zscore(x, nan_policy='omit'))

start_time, end_time = 3, 6.5
delay_time_window = evoked_df_acc[(evoked_df_acc['time'] >= start_time) & (evoked_df_acc['time'] <= end_time)].copy()
delay_time_window['pupils_z'] = delay_time_window.groupby('subID')['pupils'].transform(lambda x: zscore(x, nan_policy='omit'))

# %%
# parameters

n_perm = 5000
seed = 42

# %%
# 1 - Accuracy main effect (Correct vs False)

# post-hoc pairwise comparison cluster tests ---
# fixed, now using permutation_cluster_1samp_test for within subjects design, which uses t-test against zero under
# the hood to test whether the mean differences between conditions are different from zero across subjects
# mathematically equivalent to ttest_rel, subtraction for difference curve just happens internally with ttest_rel
# this is copied from load main effec/post-hoc tests
# 


# Safety copy and ensure common time grid
df_post = delay_time_window.copy()

alpha = 0.05

all_rows = []  # to collect summaries across both mask groups

# Subset the data

df_correct = delay_time_window[delay_time_window['accuracy'] == 'correct']
df_false = delay_time_window[delay_time_window['accuracy'] == 'false']

# Pivot to get subjects x timepoints
X1_df = df_correct.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')
X2_df = df_false.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')

# Align subjects and timepoints across the two accuracies (within-subjects!)
common_subs  = X1_df.index.intersection(X2_df.index)
common_times = X1_df.columns.intersection(X2_df.columns)
common_times = np.array(sorted(common_times))

X1 = X1_df.loc[common_subs, common_times].to_numpy()
X2 = X2_df.loc[common_subs, common_times].to_numpy()
times = common_times

# Drop rows/cols with any NaNs across the two accuracies
row_ok = (~np.isnan(X1) & ~np.isnan(X2)).all(axis=1)
col_ok = (~np.isnan(X1) & ~np.isnan(X2)).all(axis=0)
X1, X2 = X1[row_ok][:, col_ok], X2[row_ok][:, col_ok]
times = times[col_ok]
common_subs = common_subs[row_ok]

print("Aligned shapes:", X1.shape, X2.shape)  # (n_subjects, n_times)


Xdiff = X2 - X1                       # (n_subjects, n_times)
n_sub = Xdiff.shape[0]
# Because we conduct a two-tailed test, we divide the p-value by 2 (which means
# we're making use of both tails of the distribution).
tcrit = t.ppf(1 - 0.025, df=n_sub - 1)  # two-tailed cluster-forming threshold

T_obs, clusters, cluster_p_values, H0 = permutation_cluster_1samp_test(
    Xdiff,
    n_permutations=n_perm,
    threshold=tcrit,
    tail=0,
    seed=seed,
    out_type="mask",
    verbose=True
)

print(cluster_p_values.round(3))
# Summarize significant clusters
alpha = 0.05
n_times = len(times)

# ---- Summarize significant clusters (no helper) ----
for i_c, c in enumerate(clusters):
    p = float(cluster_p_values[i_c])
    if p < alpha:
        # Build a boolean time mask regardless of cluster type
        if isinstance(c, np.ndarray):
            time_mask = c  # already boolean mask over time
        else:
            # c is a tuple containing a slice (or a slice)
            s = c[0] if isinstance(c, tuple) else c
            time_mask = np.zeros(n_times, dtype=bool)
            time_mask[s] = True

        t_vals = T_obs[time_mask]
        mean_t = float(np.mean(t_vals))

        # Effect (A - B) averaged within the cluster (paired contrast)
        # Here XA and XB are the two arrays you tested (e.g., X3 and X1)
        mean_diff = float(np.nanmean(Xdiff[:, time_mask]))

        # Cluster bounds for reporting
        idx = np.flatnonzero(time_mask)
        t_start = float(times[idx[0]])
        t_end   = float(times[idx[-1]])

        all_rows.append({
            "cluster_id": int(i_c + 1),
            "start_time": t_start,
            "end_time": t_end,
            "p_value": p,
            "mean_t": mean_t,
            "mean_diff": mean_diff,
            "n_subjects": int(X1.shape[0])
        })

# ---- Plot t-curve and shade ALL significant clusters (no helper) ----
plt.figure(figsize=(10, 5))
plt.plot(times, T_obs, label='t-values')
plt.axhline(0, color='k', linestyle='--', linewidth=0.8)
plt.title(f"Post-hoc (paired cluster test)")
plt.xlabel("Time (s)")
plt.ylabel("t-statistic")
plt.legend()
plt.tight_layout()
plt.show()

# Optional: show condition means for reference
plt.figure(figsize=(10, 5))
plt.plot(times, X1.mean(axis=0), label='correct')
plt.plot(times, X2.mean(axis=0), label='incorrect')
for i_c, c in enumerate(clusters):
    if cluster_p_values[i_c] < alpha:
        if isinstance(c, np.ndarray):
            time_mask = c
        else:
            s = c[0] if isinstance(c, tuple) else c
            time_mask = np.zeros(n_times, dtype=bool)
            time_mask[s] = True

        idx = np.flatnonzero(time_mask)
        if idx.size:  # safety
            plt.axvspan(times[idx[0]], times[idx[-1]], color='red', alpha=0.3, zorder=0)

plt.title(f"Condition means")
plt.xlabel("Time (s)")
plt.ylabel("Mean pupil")
plt.legend()
plt.tight_layout()
plt.show()

# Save combined summary across
posthoc_df = pd.DataFrame(all_rows).reset_index(drop=True)
# posthoc_df.to_csv("posthoc_load_pairwise_clusters.csv", index=False)

display(posthoc_df if not posthoc_df.empty else "No significant post-hoc clusters.")
#%%
# Test the interaction between Load and Accuracy with a contrast based interaction test
# this should be all correct I think but check again
# this is testing whether the linear trend for the load conditions is the same in correct vs incorrect trials
# for the whole trial timeline it isnt (-> there is a difference during test)
# but maybe also interesting to only look at delay


alpha = 0.05
n_perm = 5000

# Build per-load (subjects × time) for each accuracy
def mat_for(acc, load):
    sub = delay_time_window[(delay_time_window['accuracy'] == acc) & (delay_time_window['Load'] == load)]
    return sub.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')

C1, C2, C3 = mat_for('correct',1), mat_for('correct',2), mat_for('correct',3)
I1, I2, I3 = mat_for('false',  1), mat_for('false',  2), mat_for('false',  3)

# Intersect subjects & times across all 6 to keep within-subjects
common_subs = C1.index
common_times = C1.columns
for M in [C2, C3, I1, I2, I3]:
    common_subs = common_subs.intersection(M.index)
    common_times = common_times.intersection(M.columns)
times = np.array(sorted(common_times))

C1 = C1.loc[common_subs, times].to_numpy()
C2 = C2.loc[common_subs, times].to_numpy()
C3 = C3.loc[common_subs, times].to_numpy()
I1 = I1.loc[common_subs, times].to_numpy()
I2 = I2.loc[common_subs, times].to_numpy()
I3 = I3.loc[common_subs, times].to_numpy()

# Drop timepoints with any NaN across all 6
col_ok = (~np.isnan(C1) & ~np.isnan(C2) & ~np.isnan(C3) &
          ~np.isnan(I1) & ~np.isnan(I2) & ~np.isnan(I3)).all(axis=0)

times = times[col_ok]
C1, C2, C3 = C1[:, col_ok], C2[:, col_ok], C3[:, col_ok]
I1, I2, I3 = I1[:, col_ok], I2[:, col_ok], I3[:, col_ok]

# Linear trend weights across loads
w = np.array([-1.0, 0.0, 1.0])

# Per-subject linear trend time series for Correct and Incorrect
trend_C = w[0]*C1 + w[1]*C2 + w[2]*C3   # (n_sub × n_time)
trend_I = w[0]*I1 + w[1]*I2 + w[2]*I3

# Interaction contrast: Correct − Incorrect (if positive → steeper positive load trend on correct trials)
X = (trend_C - trend_I)                  # (n_sub × n_time)

n = X.shape[0]
# Because we conduct a two-tailed test, we divide the p-value by 2 (which means
# we're making use of both tails of the distribution).
threshold = t.ppf(1 - 0.025, df=n-1)

# 1-sample cluster permutation test vs 0
T_obs, clusters, cluster_p_values, H0 = permutation_cluster_1samp_test(
    X,
    n_permutations=n_perm,
    threshold=threshold,   # auto t-threshold for 1-sample t
    tail=0,           # two-tailed (trend could be pos or neg)
    out_type='mask',
    seed=seed,
    verbose=True
)

rows = []
for i_c, c in enumerate(clusters):
    p = float(cluster_p_values[i_c])
    if p < alpha:
        # c is a boolean mask (out_type='mask'); if it's a slice tuple, adapt accordingly
        if isinstance(c, np.ndarray):
            idx = np.flatnonzero(c)
        else:
            idx = np.arange(len(times))[c]

        if idx.size == 0:
            continue


        start_t = float(times[idx[0]])
        end_t   = float(times[idx[-1]])
        mean_t  = float(np.mean(T_obs[idx]))
        dur     = int(idx.size)

        rows.append({
            "effect": "Interaction (linear trend: Correct − Incorrect)",
            "cluster_id": int(i_c + 1),
            "start_time": start_t,
            "end_time": end_t,
            "duration_samps": dur,
            "p_value": p,
            "mean_t": mean_t,
            "n_subjects": int(X.shape[0]),
        })

summary = pd.DataFrame(rows).reset_index(drop=True)
display(summary if not summary.empty else pd.DataFrame({"note": ["No significant clusters after min-size filter."]}))
summary.to_csv("clusters_LoadxAccuracy_linearTrend_interaction_FIXED.csv", index=False)


# Plot t-curve with correctly shaded clusters
plt.figure(figsize=(10,5))
plt.plot(times, T_obs, label='t (Correct − Incorrect load trend)')
plt.axhline(0, color='k', linestyle=':', linewidth=0.8)

for i_c, c in enumerate(clusters):
    if cluster_p_values[i_c] < alpha:
        if isinstance(c, np.ndarray):
            idx = np.flatnonzero(c)
        else:
            idx = np.arange(len(times))[c]
        plt.axvspan(float(times[idx[0]]), float(times[idx[-1]]), color='red', alpha=0.3)

plt.xlabel("Time (s)")
plt.ylabel("t")
plt.title("Interaction via linear trend (C − I) — cluster summary (fixed mapping)")
plt.tight_layout()
plt.show()

times = np.array(common_times)  # make sure it's ordered
X1_mean = C1.mean(axis=0)
X2_mean = C2.mean(axis=0)
X3_mean = C3.mean(axis=0)
Y1_mean = I1.mean(axis=0)
Y2_mean = I2.mean(axis=0)
Y3_mean = I3.mean(axis=0)


plt.plot(times, X1_mean, label='correct1')
plt.plot(times, X2_mean, label='correct2')
plt.plot(times, X3_mean, label='correct3')
plt.plot(times, Y1_mean, label='false1')
plt.plot(times, Y2_mean, label='false2')
plt.plot(times, Y3_mean, label='false3')


# Highlight significant clusters
for i_c, cluster in enumerate(clusters):
    if cluster_p_values[i_c] < 0.05:
        time_mask = cluster
        plt.axvspan(times[time_mask][0], times[time_mask][-1], color='red', alpha=0.3)

plt.legend()
plt.title(f'Cluster Permutation Test Mask Conditions')
plt.xlabel('Time (s)')
plt.ylabel('Pupil size')
plt.show()



# %%
# Main effect of accuracy but divided by load conditions
cluster_results = {}

for load in [1, 2, 3]:
    print(f"\nRunning cluster test for Load {load}...")

    # Subset the data
    df_load = delay_time_window[delay_time_window['Load'] == load]
    df_correct = df_load[df_load['accuracy'] == 'correct']
    df_false = df_load[df_load['accuracy'] == 'false']

    # Pivot to get subjects x timepoints
    X1_df = df_correct.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')
    X2_df = df_false.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')

    # Align subjects and timepoints
    common_subs = X1_df.index.intersection(X2_df.index)
    common_times = X1_df.columns.intersection(X2_df.columns)
    times = common_times.to_numpy()

    X1 = X1_df.loc[common_subs, common_times].to_numpy()
    X2 = X2_df.loc[common_subs, common_times].to_numpy()

    Xdiff = X2 - X1                       # (n_subjects, n_times)
    n_sub = Xdiff.shape[0]
    # Because we conduct a two-tailed test, we divide the p-value by 2 (which means
    # we're making use of both tails of the distribution).
    tcrit = t.ppf(1 - 0.025, df=n_sub - 1)  # two-tailed cluster-forming threshold

    # Run cluster-based permutation test
    T_obs, clusters, cluster_p_values, H0 = permutation_cluster_1samp_test(
        Xdiff,
        n_permutations=n_perm,
        threshold=tcrit,
        tail=0,
        seed=seed,
        out_type='mask',
        verbose=True
    )
    print(cluster_p_values.round(3))
    # Store results
    cluster_results[load] = {
        "T_obs": T_obs,
        "clusters": clusters,
        "cluster_p_values": cluster_p_values,
        "times": times
    }
    print(cluster_results[load]['cluster_p_values'])

    # Plot
    plt.figure(figsize=(10, 5))
    plt.plot(times, T_obs, label='T-values')
    for i_c, c in enumerate(clusters):
        if cluster_p_values[i_c] < 0.05:
            plt.axvspan(times[c][0], times[c][-1], color='red', alpha=0.3)
    plt.axhline(0, color='black', linestyle='--')
    plt.title(f'Cluster Permutation Test (Load {load})')
    plt.xlabel('Time (s)')
    plt.ylabel('T-statistic')
    plt.legend()
    plt.tight_layout()
    plt.show()

    times = np.array(common_times)  # make sure it's ordered
    X1_mean = X1.mean(axis=0)
    X2_mean = X2.mean(axis=0)


    plt.plot(times, X1_mean, label='correct')
    plt.plot(times, X2_mean, label='false')


    # Highlight significant clusters
    for i_c, cluster in enumerate(clusters):
        if cluster_p_values[i_c] < 0.05:
            time_mask = cluster
            plt.axvspan(times[time_mask][0], times[time_mask][-1], color='red', alpha=0.3)

    plt.legend()
    plt.title(f'Cluster Permutation Test Accuracy')
    plt.xlabel('Time (s)')
    plt.ylabel('Pupil size')
    plt.show()

    


# %%
# One-sample cluster test on a planned contrast.
# a linear trend contrast cluster test against zero.
# “Is the average difference between high and low load (per subject) reliably non-zero?” - answer no, there is a reliable difference
# might compare this to the planned contrast test above, both are apparently reasonable
# results are also relatively similar to results of the more complicated omnibus test (similar significant clusters, p-values are much more significant for omnibus test though)

# the difference between load conditions is reliably non-zero for only correct as well as 
# for only false trials, however the effect was slightly bigger and more significant for correct trials
#####



    
