# stefan included get_axes in his code to show axvlines, seems to work without it though and even returns an error 
# ax = fig.get_axes()[0]

palette = sns.color_palette('husl', 3)
sns.lineplot(data=all_con_evoked, x='time', y='pupils', hue='Load', palette=palette)

ax.axvline(0, label="onset probe object")
ax.axvline(-3.5, label="onset delay")
# ax.axvline(-4.5, label="object position 3")
# ax.axvline(-5.5, label="object position 2")
# ax.axvline(-6.5, label="object position 1")

ax.axvline(-4.5, label="object position 3", color='lightpink')  # Customize color and saturation
ax.axvline(-5.5, label="object position 2", color='lightpink', alpha=0.66)  # Customize color and saturation
ax.axvline(-6.5, label="object position 1", color='lightpink', alpha=0.33)  # Customize color and saturation



fig.legend()
fig
plt.show

