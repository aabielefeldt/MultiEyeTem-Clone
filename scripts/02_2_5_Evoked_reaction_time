
# %%
# Importsconda
import mne
import pandas as pd
import numpy as np
from pupil_utils import apply_baseline_nan_aware


# %% Load Metadata

df = pd.read_csv('../data/csv_files/df.csv')
good_partis = df['subID'].unique()

# %%
# appending all epochs into one list while:
# combining both pupil channels
# applying baseline
# seperating by condition
# cropping according to condition
# averaging epochs
drop_log_rows = []

evoked_list = []

for i in good_partis:
    
    # reading epochs per participant
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Epochs_even_newer"
    epoch_file = folder_path + "/" + i + "_even_newer-epo.fif"
    pupil_epoch = mne.read_epochs(epoch_file, preload=True, verbose=None)
    
    # applying baseline per eye and nan aware while dropping any epochs where the baseline period was nan in both eyes
    pupil_epoch_bl = apply_baseline_nan_aware(pupil_epoch, bmin=-0.1, bmax=0.0)
    baseline = pupil_epoch_bl.baseline
    
    # counting dropped epochs
    sum_dropped = sum('BAD_baseline_nan_both_eyes' in entry for entry in pupil_epoch_bl.drop_log)
    drop_log_rows.append({'subID': i, 'sum_dropped': sum_dropped})

    # combining channels
    pupil_ix = mne.pick_channels(pupil_epoch_bl.info["ch_names"], include=['pupil_left', 'pupil_right'])
    roi_dict = dict(pupils=pupil_ix)
    combine_nanmean = lambda data: np.nanmean(data, axis=1)
    pupil_epochs_combined_bl = mne.channels.combine_channels(pupil_epoch_bl, roi_dict, method=combine_nanmean)
    

    # after pupil_epochs_combined_bl is created
    rt = pupil_epochs_combined_bl.metadata['rt_resp_concrete_cued']
    sub_reaction_time_median = np.nanmedian(rt)  # skips NaNs

    # seperating slow vs fast reaction time per subID
    con1_epochs_pos1 = pupil_epochs_combined_bl["items_presented == 1"]
    con1_epochs_fast= con1_epochs_pos1[f"rt_resp_concrete_cued <= {sub_reaction_time_median}"]
    con1_epochs_slow = con1_epochs_pos1[f"rt_resp_concrete_cued > {sub_reaction_time_median}"]
    con2_epochs_pos1 = pupil_epochs_combined_bl["items_presented == 2"]
    con2_epochs_fast = con2_epochs_pos1[f"rt_resp_concrete_cued <= {sub_reaction_time_median}"]
    con2_epochs_slow = con2_epochs_pos1[f"rt_resp_concrete_cued > {sub_reaction_time_median}"]
    con3_epochs_pos1 = pupil_epochs_combined_bl["items_presented == 3"]
    con3_epochs_fast = con3_epochs_pos1[f"rt_resp_concrete_cued <= {sub_reaction_time_median}"]
    con3_epochs_slow = con3_epochs_pos1[f"rt_resp_concrete_cued > {sub_reaction_time_median}"]

    # shortening the epochs based on condition (crop defaults to inclduing tmax)
    con1_epochs_fast.crop(-0.1, 7)
    con2_epochs_fast.crop(-0.1, 8)
    con3_epochs_fast.crop(-0.1, 9)
    con1_epochs_slow.crop(-0.1, 7)
    con2_epochs_slow.crop(-0.1, 8)
    con3_epochs_slow.crop(-0.1, 9)

    # averaging per load condition
    evoked_nan_mean = lambda x: np.nanmean(x, axis=0)
    con1_ave_fast = con1_epochs_fast.average(method=evoked_nan_mean)
    con2_ave_fast = con2_epochs_fast.average(method=evoked_nan_mean)
    con3_ave_fast = con3_epochs_fast.average(method=evoked_nan_mean)
    con1_ave_slow = con1_epochs_slow.average(method=evoked_nan_mean)
    con2_ave_slow = con2_epochs_slow.average(method=evoked_nan_mean)
    con3_ave_slow = con3_epochs_slow.average(method=evoked_nan_mean)

    # adding individual averaged data to dataframe including load and subID
    # Cardinal trials
    con1_ave_df_fast = con1_ave_fast.to_data_frame(scalings=1)
    con1_ave_df_fast['Load'] = 1
    con1_ave_df_fast['subID'] = i
    con1_ave_df_fast['reaction_time'] = 'fast'
    con2_ave_df_fast = con2_ave_fast.to_data_frame(scalings=1)
    con2_ave_df_fast['Load'] = 2
    con2_ave_df_fast['subID'] = i
    con2_ave_df_fast['reaction_time'] = 'fast'
    con3_ave_df_fast = con3_ave_fast.to_data_frame(scalings=1)
    con3_ave_df_fast['Load'] = 3
    con3_ave_df_fast['subID'] = i
    con3_ave_df_fast['reaction_time'] = 'fast'

    # Oblique trials
    con1_ave_df_slow = con1_ave_slow.to_data_frame(scalings=1)
    con1_ave_df_slow['Load'] = 1
    con1_ave_df_slow['subID'] = i
    con1_ave_df_slow['reaction_time'] = 'slow'
    con2_ave_df_slow = con2_ave_slow.to_data_frame(scalings=1)
    con2_ave_df_slow['Load'] = 2
    con2_ave_df_slow['subID'] = i 
    con2_ave_df_slow['reaction_time'] = 'slow'
    con3_ave_df_slow = con3_ave_slow.to_data_frame(scalings=1)
    con3_ave_df_slow['Load'] = 3
    con3_ave_df_slow['subID'] = i
    con3_ave_df_slow['reaction_time'] = 'slow'

    # concatenating to evoked_df_reaction_time
    # extending evoked list
    evoked_list.extend([con1_ave_df_fast, con2_ave_df_fast, con3_ave_df_fast, con1_ave_df_slow, con2_ave_df_slow, con3_ave_df_slow])


drop_log_df = pd.DataFrame(drop_log_rows)
evoked_df_reaction_time = pd.concat(evoked_list, ignore_index=True)

# evoked_df_accuracy['baseline_start'] = baseline[0] 
# evoked_df_accuracy['baseline_end'] = baseline[1] 
drop_log_df.to_csv('../data/csv_files/drop_log_df_evoked_reaction_time.csv', index=False)
evoked_df_reaction_time.to_csv('../data/csv_files/evoked_df_reaction_time.csv', index=False)

# %%
# Shifting

# shifting the conditions so that the epochs that are epoched on pos1 are time-locked to the test onset
evoked_df_reaction_time_shifted = evoked_df_reaction_time.copy()
evoked_df_reaction_time_shifted.loc[evoked_df_reaction_time_shifted['Load']==1, 'time'] +=2
evoked_df_reaction_time_shifted.loc[evoked_df_reaction_time_shifted['Load']==2, 'time'] +=1
evoked_df_reaction_time_shifted.loc[evoked_df_reaction_time_shifted['Load']==3, 'time'] +=0

# %%
# Adding column for mask
mask_partis = df[df['mask']==1]['subID'].unique().tolist()
nomask_partis = df[df['mask']==0]['subID'].unique().tolist()

evoked_df_reaction_time_shifted['mask'] = evoked_df_reaction_time_shifted['subID'].apply(
    lambda x: 1 if x in mask_partis else 0)

evoked_df_reaction_time_shifted['time'] = evoked_df_reaction_time_shifted['time'].round(3)
evoked_df_reaction_time_shifted.to_csv('../data/csv_files/evoked_df_reaction_time_shifted.csv', index=False)
# %%
