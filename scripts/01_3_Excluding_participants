# %%
# Imports
import pandas as pd

# %% Load Metadata

df = pd.read_csv('../data/csv_files/df.csv')
good_partis = df['subID'].unique()

# %% 
# Excluding Participants

# %%
# List of subject IDs to exclude

# excluding OUG64 for performance (binomial test)
# potentially excluding UCXTVD and D62XJG because they had the square mask

# subjects_to_exclude = ['OUGX64', 'UCXTVD', 'D62XJG']
subjects_to_exclude = ['OUGX64']

# Use boolean indexing to drop rows where 'subID' is in the exclusion list
df = df[~df['subID'].isin(subjects_to_exclude)]

good_partis = df['subID'].unique()