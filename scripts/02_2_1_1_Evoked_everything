anova_results = pg.rm_anova(data=evokeds_df_shifted_object_ori_dw, dv='pupils_z', within=['dist_probe_to_cardinal', 'pressed_away_from_cardinal'], subject='subID')

# Display ANOVA results
display(anova_results.round(4))

