# -----------------------------
card_df = trial_df[trial_df["trial_ori_pattern"] == "all_cardinal"].copy()

# drop rows with missing values in key columns
card_df = card_df.dropna(subset=["away_cardinal", "acc_trial_concrete_cued", "items_presented", "subID"]).copy()

# now safe to cast
card_df["away_cardinal"] = card_df["away_cardinal"].astype(int)
card_df["acc_trial_concrete_cued"] = card_df["acc_trial_concrete_cued"].astype(int)
card_df["items_presented"] = card_df["items_presented"].astype("category")
card_df["subID"] = card_df["subID"].astype(str)


# If you don't already have pupil_delay_z, create it (within-subject z-score)
if "pupil_delay_z" not in card_df.columns:
    card_df["pupil_delay_z"] = card_df.groupby("subID")["pupil_delay_mean"].transform(
        lambda x: (x - x.mean()) / x.std(ddof=0)
    )

# Optional: remove rows with missing values in any model vars
model_vars = ["away_cardinal", "pupil_delay_z", "acc_trial_concrete_cued", "items_presented", "subID"]
card_df = card_df.dropna(subset=model_vars).copy()

# ----------------------------------------------------
# 2) (Optional) Descriptives: away rate by conditions
# ----------------------------------------------------
desc = (card_df
        .groupby(["items_presented", "acc_trial_concrete_cued"])["away_cardinal"]
        .agg(n="count", away_rate="mean")
        .reset_index())
print(desc)

# ---------------------------------------------------------
# 3) Plot: P(away) vs pupil, split by load and accuracy
# ---------------------------------------------------------
# Bin pupil for visualization (avoids messy scatter)
card_df["pupil_bin"] = pd.qcut(card_df["pupil_delay_z"], q=10, duplicates="drop")
plot_df = (card_df
           .groupby(["items_presented", "acc_trial_concrete_cued", "pupil_bin"], as_index=False)
           .agg(pupil_delay_z=("pupil_delay_z", "mean"),
                p_away=("away_cardinal", "mean"),
                n=("away_cardinal", "size")))

g = sns.FacetGrid(
    plot_df,
    row="acc_trial_concrete_cued",
    col="items_presented",
    height=3.2,
    aspect=1.2,
    sharex=True,
    sharey=True
)
g.map_dataframe(sns.lineplot, x="pupil_delay_z", y="p_away")
g.set_axis_labels("Delay pupil (z, 3.0–6.5s)", "P(away_cardinal = 1)")
g.set_titles(row_template="Accuracy={row_name}", col_template="Load={col_name}")
plt.tight_layout()
plt.show()

# ---------------------------------------------------------
# 4) Logistic GEE: away_cardinal predicted by pupil + mods
# ---------------------------------------------------------
# Start simpler if you want:
# formula = "away_cardinal ~ pupil_delay_z + acc_trial_concrete_cued + items_presented"

formula = (
    "away_cardinal ~ "
    "pupil_delay_z * acc_trial_concrete_cued + "
    "pupil_delay_z * items_presented"
)

gee = smf.gee(
    formula=formula,
    groups="subID",
    data=card_df,
    family=sm.families.Binomial()
).fit()

print(gee.summary())

# -----------------------------------------
# 5) Odds ratios + 95% CI (more interpretable)
# -----------------------------------------
params = gee.params
conf = gee.conf_int()
or_table = pd.DataFrame({
    "OR": np.exp(params),
    "CI_low": np.exp(conf[0]),
    "CI_high": np.exp(conf[1]),
    "p": gee.pvalues
}).round(4)

print("\nOdds ratios (exp(beta)) with 95% CI:")
print(or_table)



