############################################################
# Data Preparation 

evokeds_df_shifted_bias_dw = evokeds_df_shifted_bias.copy()
evokeds_df_shifted_bias_dw['time'] = evokeds_df_shifted_bias_dw['time'].round(3)


start_time, end_time = 3, 6.5
evokeds_df_shifted_bias_dw = evokeds_df_shifted_bias_dw[(evokeds_df_shifted_bias_dw['time'] >= start_time) & (evokeds_df_shifted_bias_dw['time'] <= end_time)].copy()


# no pupils cclumn in piv
evokeds_df_shifted_bias_dw['pupils_z'] = evokeds_df_shifted_bias_dw.groupby('subID')['pupils'].transform(lambda x: zscore(x, nan_policy='omit'))



evoked_piv_dw = evokeds_df_shifted_bias_dw.pivot_table(
    index=['subID', "dist_to_cardinal_mem", 'acc_trial_concrete_cued', 'time'],
    columns="probe_away_from_cardinal",
    values="pupils_z"
).reset_index()


evoked_piv_dw.columns = ['subID', "dist_to_cardinal_mem",'acc_trial_concrete_cued','time', "p_toward","p_away"]  # 0=toward, 1=away
evoked_piv_dw["diff_away_minus_toward"] = evoked_piv_dw["p_away"] - evoked_piv_dw["p_toward"]




#%%
# Parameters

n_perm = 5000
seed = 42
# %% 
# Cluster test on main effect between away vs towards cardinal axis button press
# but only for probe objects close to the cardinal axis
##########
#####

cluster_results = {}

#subset_cardinal = evokeds_df_shifted_bias_dw[evokeds_df_shifted_bias_dw['dist_to_cardinal_mem'] == 11.25 & evokeds_df_shifted_bias_dw['acc_trial'] == 11.25]

#subset only close to cardinal
subset_1 = evokeds_df_shifted_bias_dw[(evokeds_df_shifted_bias_dw['dist_to_cardinal_mem'] == 11.25)  & (evokeds_df_shifted_bias_dw['probe_away_from_cardinal'] == 0) & (evokeds_df_shifted_bias_dw['acc_trial_concrete_cued'] == 1)]
subset_2 = evokeds_df_shifted_bias_dw[(evokeds_df_shifted_bias_dw['dist_to_cardinal_mem'] == 33.75) & (evokeds_df_shifted_bias_dw['probe_away_from_cardinal'] == 1) & (evokeds_df_shifted_bias_dw['acc_trial_concrete_cued'] == 0)]

# Pivot to get subjects x timepoints
X1_df = subset_1.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')
X2_df = subset_2.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')

# Align only on time because between subjects test
common_times = X1_df.columns.intersection(X2_df.columns)
times = common_times.to_numpy()

X1 = X1_df[common_times].values
X2 = X2_df[common_times].values

Xdiff = X2 - X1                       # (n_subjects, n_times)
n_sub = Xdiff.shape[0]
# Because we conduct a two-tailed test, we divide the p-value by 2 (which means
# we're making use of both tails of the distribution).
tcrit = t.ppf(1 - 0.025, df=n_sub - 1)  # two-tailed cluster-forming threshold

T_obs, clusters, cluster_p_values, H0 = permutation_cluster_1samp_test(
    Xdiff,
    n_permutations=n_perm,
    threshold=tcrit,
    tail=0,
    seed=seed,
    out_type="mask",
    verbose=True
)

cluster_summaries = []
for i, c in enumerate(clusters):
    p_val = cluster_p_values[i]
    time_inds = c[0]
    T_vals = T_obs[time_inds]
    mean_T = T_vals.mean()

    # Extract descriptive means of each condition inside cluster
    load_means = {
        "mean_load1": np.nanmean(X1[:, time_inds]),
        "mean_load2": np.nanmean(X2[:, time_inds])
    }
    cluster_entry = {
        "cluster_id": i + 1,
        "start_time": times[time_inds][0],
        "end_time": times[time_inds][-1],
        "p_value": p_val,
        "mean_F": mean_T,
    }
    cluster_entry.update(load_means)

    cluster_summaries.append(cluster_entry)

# Save to DataFrame
cluster_df = pd.DataFrame(cluster_summaries)
# cluster_df.to_csv("cluster_results_load_by_mask.csv", index=False)
display(cluster_df)


# Plot
plt.figure(figsize=(10, 5))
plt.plot(times, T_obs, label='T-values')
for i_c, c in enumerate(clusters):
    if cluster_p_values[i_c] < 0.05:
        plt.axvspan(times[c][0], times[c][-1], color='red', alpha=0.3)
plt.axhline(2, color='black', linestyle='--')
plt.title(f'Cluster Permutation Test (Correct vs False)')
plt.xlabel('Time (s)')
plt.ylabel('T-statistic')
plt.legend()
plt.tight_layout()
plt.show()

times = np.array(common_times)  # make sure it's ordered
X1_mean = X1.mean(axis=0)
X2_mean = X2.mean(axis=0)


plt.plot(times, X1_mean, label='away')
plt.plot(times, X2_mean, label='towars')


# Highlight significant clusters
for i_c, cluster in enumerate(clusters):
    if cluster_p_values[i_c] < 0.05:
        time_mask = cluster
        plt.axvspan(times[time_mask][0], times[time_mask][-1], color='red', alpha=0.3)

plt.legend()
plt.title(f'Cluster Permutation Test Mask Conditions')
plt.xlabel('Time (s)')
plt.ylabel('Pupil size')
plt.show()









