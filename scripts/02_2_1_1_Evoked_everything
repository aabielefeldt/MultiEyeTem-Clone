# %%
# Data Preparation 

evokeds_df_shifted = evokeds_df_shifted.copy()
evokeds_df_shifted['time'] = evokeds_df_shifted['time'].round(3)


start_time, end_time = 3, 6.5
evokeds_df_shifted_dw = evokeds_df_shifted[(evokeds_df_shifted['time'] >= start_time) & (evokeds_df_shifted['time'] <= end_time)].copy()

evokeds_df_shifted_dw['pupils_z'] = evokeds_df_shifted_dw.groupby('subID')['pupils'].transform(lambda x: zscore(x, nan_policy='omit'))

#%%
# defining t-test statistic

def paired_t(X1, X2):
    t_vals, _ = stats.ttest_rel(X1, X2, axis=0)
    return t_vals

def independent_t(X1, X2):
    t_vals, _ = stats.ttest_ind(X1, X2, axis=0, equal_var=True)  # equal_var=False = Welch’s t-test vs equal_var=True -> pooled-variance t-test (Student’s t), use Welch only when groups are very unequal
    return t_vals

#%%
# Parameters

n_perm = 5000
seed = 42
# %% 
# Cluster test on main effect between away vs towards cardinal axis button press
# but only for probe objects close to the cardinal axis
##########
#####

cluster_results = {}

#subset only close to cardinal
# subset_cardinal = evokeds_df_shifted_dw[evokeds_df_shifted_dw['dist_to_cardinal'] == 11.25]

# either the above subset or could also look at only all_cardinal ori combos
subset_cardinal = evokeds_df_shifted_dw[evokeds_df_shifted_dw['trial_ori_pattern'] == 'all_cardinal']
#subset_cardinal = subset_cardinal[subset_cardinal['acc_trial_concrete_cued'] == 0]


# Subset
subset_away = subset_cardinal[subset_cardinal['away_cardinal'] == 1]
subset_tow = subset_cardinal[subset_cardinal['away_cardinal'] == 0]

# Pivot to get subjects x timepoints
X1_df = subset_away.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')
X2_df = subset_tow.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')

# Align only on time because between subjects test
common_times = X1_df.columns.intersection(X2_df.columns)
times = common_times.to_numpy()

X1 = X1_df[common_times].values
X2 = X2_df[common_times].values



Xdiff = X2 - X1                       # (n_subjects, n_times)
n_sub = Xdiff.shape[0]
# Because we conduct a two-tailed test, we divide the p-value by 2 (which means
# we're making use of both tails of the distribution).
tcrit = t.ppf(1 - 0.025, df=n_sub - 1)  # two-tailed cluster-forming threshold

T_obs, clusters, cluster_p_values, H0 = permutation_cluster_1samp_test(
    Xdiff,
    n_permutations=n_perm,
    threshold=tcrit,
    tail=0,
    seed=seed,
    out_type="mask",
    verbose=True
)

cluster_summaries = []
for i, c in enumerate(clusters):
    p_val = cluster_p_values[i]
    time_inds = c[0]
    F_vals = T_obs[time_inds]
    mean_F = F_vals.mean()

    # Extract descriptive means of each condition inside cluster
    load_means = {
        "mean_load1": np.nanmean(X1[:, time_inds]),
        "mean_load2": np.nanmean(X2[:, time_inds])
    }
    cluster_entry = {
        "cluster_id": i + 1,
        "start_time": times[time_inds][0],
        "end_time": times[time_inds][-1],
        "p_value": p_val,
        "mean_F": mean_F,
    }
    cluster_entry.update(load_means)

    cluster_summaries.append(cluster_entry)

# Save to DataFrame
cluster_df = pd.DataFrame(cluster_summaries)
# cluster_df.to_csv("cluster_results_load_by_mask.csv", index=False)
display(cluster_df)


# Plot
plt.figure(figsize=(10, 5))
plt.plot(times, T_obs, label='T-values')
for i_c, c in enumerate(clusters):
    if cluster_p_values[i_c] < 0.05:
        plt.axvspan(times[c][0], times[c][-1], color='red', alpha=0.3)
plt.axhline(2, color='black', linestyle='--')
plt.title(f'Cluster Permutation Test (Correct vs False)')
plt.xlabel('Time (s)')
plt.ylabel('T-statistic')
plt.legend()
plt.tight_layout()
plt.show()

times = np.array(common_times)  # make sure it's ordered
X1_mean = X1.mean(axis=0)
X2_mean = X2.mean(axis=0)


plt.plot(times, X1_mean, label='away')
plt.plot(times, X2_mean, label='towars')


# Highlight significant clusters
for i_c, cluster in enumerate(clusters):
    if cluster_p_values[i_c] < 0.05:
        time_mask = cluster
        plt.axvspan(times[time_mask][0], times[time_mask][-1], color='red', alpha=0.3)

plt.legend()
plt.title(f'Cluster Permutation Test Mask Conditions')
plt.xlabel('Time (s)')
plt.ylabel('Pupil size')
plt.show()


