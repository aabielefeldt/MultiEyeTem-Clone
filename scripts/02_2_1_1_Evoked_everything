# %%
import numpy as np
import pandas as pd
import mne

delay_tmin, delay_tmax = 3.0, 6.5

rows = []

for sub in good_partis:
    epoch_file = f"{folder_path}/{sub}_even_newer-epo.fif"
    ep = mne.read_epochs(epoch_file, preload=True, verbose=None)

    ep.metadata = df.loc[df["subID"] == sub].copy()

    # baseline + drop bad baseline epochs
    ep = apply_baseline_nan_aware(ep, bmin=-0.1, bmax=0.0)

    # combine eyes -> one channel
    pupil_ix = mne.pick_channels(ep.info["ch_names"], include=["pupil_left", "pupil_right"])
    ep = mne.channels.combine_channels(ep, dict(pupils=pupil_ix),
                                       method=lambda data: np.nanmean(data, axis=1))

    # crop to delay window and compute mean per epoch
    ep_delay = ep.copy().crop(delay_tmin, delay_tmax)

    X = ep_delay.get_data()  # shape: (n_epochs, 1, n_times)
    pupil_delay_mean = np.nanmean(X[:, 0, :], axis=1)  # one value per epoch

    meta = ep_delay.metadata.copy()
    meta["subID"] = sub
    meta["pupil_delay_mean"] = pupil_delay_mean

    # keep only what you need
    keep = ["subID", "items_presented", "trial_ori_pattern", "acc_trial_concrete_cued", 'dist_to_cardinal_mem', 'pressed_away_from_cardinal', "pupil_delay_mean"]
    rows.append(meta[keep])

trial_df = pd.concat(rows, ignore_index=True)


#%%
# clean dtypes
trial_df["items_presented"] = trial_df["items_presented"].astype("category")
trial_df["trial_ori_pattern"] = trial_df["trial_ori_pattern"].astype("category")



trial_df["pupil_delay_z"] = trial_df.groupby("subID")["pupil_delay_mean"].transform(
    lambda x: (x - x.mean()) / x.std(ddof=0)
)

# %% trying to do cluster test on the above effect

# Main effect of away_button press but divided by load conditions and only in all_cardinal trials
# or only on cardinal probe object... what makes more sense?
cluster_results = {}

for load in [1, 2, 3]:
    print(f"\nRunning cluster test for Load {load}...")

    # Subset the data
    subset = evokeds_df_shifted_dw[evokeds_df_shifted_dw['items_presented'] == load]
    subset_card = subset[subset['dist_to_cardinal'] == 11.25]
    subset_inaccurate = subset_card[subset_card['trial_ori_pattern'] == 'all_cardinal']
    #subset_inaccurate=subset_card
    #subset_card = subset[subset['trial_ori_pattern'] == 'all_cardinal']

    df_away = subset_inaccurate[subset_inaccurate['away_cardinal'] == 1]
    df_tow = subset_inaccurate[subset_inaccurate['away_cardinal'] == 0]

    # Pivot to get subjects x timepoints
    X1_df = df_away.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')
    X2_df = df_tow.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')

    # Align subjects and timepoints
    common_subs = X1_df.index.intersection(X2_df.index)
    common_times = X1_df.columns.intersection(X2_df.columns)

    X1 = X1_df.loc[common_subs, common_times].to_numpy()
    X2 = X2_df.loc[common_subs, common_times].to_numpy()
    times = common_times.to_numpy()


    Xdiff = X2 - X1                       # (n_subjects, n_times)
    n_sub = Xdiff.shape[0]
    # Because we conduct a two-tailed test, we divide the p-value by 2 (which means
    # we're making use of both tails of the distribution).
    tcrit = t.ppf(1 - 0.025, df=n_sub - 1)  # two-tailed cluster-forming threshold

    T_obs, clusters, cluster_p_values, H0 = permutation_cluster_1samp_test(
        Xdiff,
        n_permutations=n_perm,
        threshold=tcrit,
        tail=0,
        seed=seed,
        out_type="mask",
        verbose=True
    )

    cluster_summaries = []
    for i, c in enumerate(clusters):
        p_val = cluster_p_values[i]
        time_inds = c[0]
        F_vals = T_obs[time_inds]
        mean_F = F_vals.mean()

        # Extract descriptive means of each condition inside cluster
        load_means = {
            "mean_load1": np.nanmean(X1[:, time_inds]),
            "mean_load2": np.nanmean(X2[:, time_inds])
        }
        cluster_entry = {
            "cluster_id": i + 1,
            "start_time": times[time_inds][0],
            "end_time": times[time_inds][-1],
            "p_value": p_val,
            "mean_F": mean_F,
        }
        cluster_entry.update(load_means)

        cluster_summaries.append(cluster_entry)

    # Save to DataFrame
    cluster_df = pd.DataFrame(cluster_summaries)
    # cluster_df.to_csv("cluster_results_load_by_mask.csv", index=False)
    display(cluster_df)

    # Plot
    plt.figure(figsize=(10, 5))
    plt.plot(times, T_obs, label='T-values')
    for i_c, c in enumerate(clusters):
        if cluster_p_values[i_c] < 0.05:
            plt.axvspan(times[c][0], times[c][-1], color='red', alpha=0.3)
    plt.axhline(0, color='black', linestyle='--')
    plt.title(f'Cluster Permutation Test (Load {load})')
    plt.xlabel('Time (s)')
    plt.ylabel('T-statistic')
    plt.legend()
    plt.tight_layout()
    plt.show()

    times = np.array(common_times)  # make sure it's ordered
    X1_mean = X1.mean(axis=0)
    X2_mean = X2.mean(axis=0)


    plt.plot(times, X1_mean, label='away')
    plt.plot(times, X2_mean, label='towards')


    # Highlight significant clusters
    for i_c, cluster in enumerate(clusters):
        if cluster_p_values[i_c] < 0.05:
            time_mask = cluster
            plt.axvspan(times[time_mask][0], times[time_mask][-1], color='red', alpha=0.3)

    plt.legend()
    plt.title(f'Cluster Permutation Test Load Conditions and button press towards or away from cardinal')
    plt.xlabel('Time (s)')
    plt.ylabel('Pupil size')
    plt.show()


    print(f"\nRunning cluster test for Load {load}...")


