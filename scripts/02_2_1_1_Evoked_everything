evokeds_df_shifted_object_ori = evokeds_df_shifted_object_ori.copy()
evokeds_df_shifted_object_ori['time'] = evokeds_df_shifted_object_ori['time'].round(3)


start_time, end_time = 3, 6.5
evokeds_df_shifted_object_ori_dw = evokeds_df_shifted_object_ori[(evokeds_df_shifted_object_ori['time'] >= start_time) & (evokeds_df_shifted_object_ori['time'] <= end_time)].copy()

evokeds_df_shifted_object_ori_dw['pupils_z'] = evokeds_df_shifted_object_ori_dw.groupby('subID')['pupils'].transform(lambda x: zscore(x, nan_policy='omit'))


