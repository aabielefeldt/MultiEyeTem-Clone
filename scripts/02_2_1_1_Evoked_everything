con2s = []
con3s = []
all_cons = []
colors = sns.hls_palette(17)
# colors = sns.color_palette("mako", as_cmap=True)
df_grouped_con1 = evokeds_df_shifted_object_ori_dw[evokeds_df_shifted_object_ori_dw['items_presented']==1]
df_grouped_con2 = evokeds_df_shifted_object_ori_dw[evokeds_df_shifted_object_ori_dw['items_presented']==2]
df_grouped_con3 = evokeds_df_shifted_object_ori_dw[evokeds_df_shifted_object_ori_dw['items_presented']==3]

# Get ordered list of unique target orientations
oris = evokeds_df_shifted_object_ori_dw['dist_probe_to_cardinal'].unique()
oris.sort()   
oris = np.append(oris, oris[0])

#unbiased_assumption = np.full(17, 0.5)

for i in range(len(oris)):
    theta = np.radians(oris[i])
    theta_adjusted = -theta + ((np.pi/2)) % (2*np.pi)

    all_con = evokeds_df_shifted_object_ori_dw[evokeds_df_shifted_object_ori_dw['dist_probe_to_cardinal']==oris[i]]['pupils_z'].mean()
    con1 = df_grouped_con1[df_grouped_con1['dist_probe_to_cardinal']==oris[i]]['pupils_z'].mean()
    con2 = df_grouped_con2[df_grouped_con2['dist_probe_to_cardinal']==oris[i]]['pupils_z'].mean()
    con3 = df_grouped_con3[df_grouped_con3['dist_probe_to_cardinal']==oris[i]]['pupils_z'].mean()
    
    thetas.append(theta)
    thetas_adjusted.append(theta_adjusted)
    all_cons.append(all_con)
    con1s.append(con1)
    con2s.append(con2)
    con3s.append(con3)

    ax.plot(theta_adjusted, all_con, 'o', color=colors[1])
    ax.plot(theta_adjusted, con1, 'o', color=colors[5])
    ax.plot(theta_adjusted, con2, 'o', color=colors[9])
    ax.plot(theta_adjusted, con3, 'o', color=colors[13])

    # Add text labels for each point to inspect if needed
    # text_positions = np.full(17, 0.55)[i]
    # label_offset = 0.0  # Adjust this value for label position
    # ax.text(theta_adjusted, text_positions + label_offset, str(oris[i]), fontsize=9, ha='center', va='center', color='black')



# Plotting lines to connect dots
ax.plot(thetas_adjusted, all_cons, '--', color='black', label='all loads average')
ax.plot(thetas_adjusted, con1s, '-', color=colors[5], label='load 1')
ax.plot(thetas_adjusted, con2s, '-', color=colors[9], label='load 2')
ax.plot(thetas_adjusted, con3s, '-', color=colors[13], label='load 3')

#ax.plot(thetas_adjusted, unbiased_assumption, color=colors[16], linestyle='dashed')

plt.legend()

plt.show()
