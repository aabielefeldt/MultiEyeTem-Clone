# %%
import numpy as np
import pandas as pd
import mne

delay_tmin, delay_tmax = 3.0, 6.5

rows = []

for sub in good_partis:
    epoch_file = f"{folder_path}/{sub}_even_newer-epo.fif"
    ep = mne.read_epochs(epoch_file, preload=True, verbose=None)

    ep.metadata = df2.loc[df2["subID"] == sub].copy()

    # baseline + drop bad baseline epochs
    ep = apply_baseline_nan_aware(ep, bmin=-0.1, bmax=0.0)

    # combine eyes -> one channel
    pupil_ix = mne.pick_channels(ep.info["ch_names"], include=["pupil_left", "pupil_right"])
    ep = mne.channels.combine_channels(ep, dict(pupils=pupil_ix),
                                       method=lambda data: np.nanmean(data, axis=1))

    # crop to delay window and compute mean per epoch
    ep_delay = ep.copy().crop(delay_tmin, delay_tmax)

    X = ep_delay.get_data()  # shape: (n_epochs, 1, n_times)
    pupil_delay_mean = np.nanmean(X[:, 0, :], axis=1)  # one value per epoch

    meta = ep_delay.metadata.copy()
    meta["subID"] = sub
    meta["pupil_delay_mean"] = pupil_delay_mean

    # keep only what you need
    keep = ["subID", "items_presented", "trial_ori_pattern", "acc_trial_concrete_cued", 'away_cardinal', "pupil_delay_mean"]
    rows.append(meta[keep])

trial_df = pd.concat(rows, ignore_index=True)


#%%
# clean dtypes
trial_df["items_presented"] = trial_df["items_presented"].astype("category")
trial_df["trial_ori_pattern"] = trial_df["trial_ori_pattern"].astype("category")



trial_df["pupil_delay_z"] = trial_df.groupby("subID")["pupil_delay_mean"].transform(
    lambda x: (x - x.mean()) / x.std(ddof=0)
)

# %%
import statsmodels.api as sm
import statsmodels.formula.api as smf

model = smf.gee(
    "away_cardinal ~ pupil_delay_z * acc_trial_concrete_cued + pupil_delay_z * items_presented + pupil_delay_z * trial_ori_pattern",
    groups="subID",
    data=trial_df,
    family=sm.families.Binomial()
)
res = model.fit()
print(res.summary())


