# %% trying to do cluster test on the above effect

# Main effect of away_button press but divided by load conditions and only in all_cardinal trials
# or only on cardinal probe object... what makes more sense?
cluster_results = {}

for load in [1, 2, 3]:
    print(f"\nRunning cluster test for Load {load}...")

    # Subset the data
    subset = evokeds_df_shifted_dw[evokeds_df_shifted_dw['items_presented'] == load]
    subset_card = subset[subset['dist_to_cardinal'] == 11.25]
    #subset_card = subset[subset['trial_ori_pattern'] == 'all_cardinal']

    df_away = subset_card[subset_card['away_cardinal'] == 1]
    df_tow = subset_card[subset_card['away_cardinal'] == 0]

    # Pivot to get subjects x timepoints
    X1_df = df_away.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')
    X2_df = df_tow.pivot_table(index='subID', columns='time', values='pupils_z', aggfunc='mean')

    # Align subjects and timepoints
    common_subs = X1_df.index.intersection(X2_df.index)
    common_times = X1_df.columns.intersection(X2_df.columns)

    X1 = X1_df.loc[common_subs, common_times].to_numpy()
    X2 = X2_df.loc[common_subs, common_times].to_numpy()
    times = common_times.to_numpy()

    # Run cluster-based permutation test
    T_obs, clusters, cluster_p_values, H0 = permutation_cluster_test(
        [X1, X2],
        n_permutations=1000,
        threshold=2.0,
        tail=0,
        out_type='mask',
        verbose=True,
        stat_fun=paired_t
    )

    cluster_summaries = []
    for i, c in enumerate(clusters):
        p_val = cluster_p_values[i]
        time_inds = c[0]
        F_vals = T_obs[time_inds]
        mean_F = F_vals.mean()

        # Extract descriptive means of each condition inside cluster
        load_means = {
            "mean_load1": np.nanmean(X1[:, time_inds]),
            "mean_load2": np.nanmean(X2[:, time_inds])
        }
        cluster_entry = {
            "cluster_id": i + 1,
            "start_time": times[time_inds][0],
            "end_time": times[time_inds][-1],
            "p_value": p_val,
            "mean_F": mean_F,
        }
        cluster_entry.update(load_means)

        cluster_summaries.append(cluster_entry)

    # Save to DataFrame
    cluster_df = pd.DataFrame(cluster_summaries)
    # cluster_df.to_csv("cluster_results_load_by_mask.csv", index=False)
    display(cluster_df)

    # Plot
    plt.figure(figsize=(10, 5))
    plt.plot(times, T_obs, label='T-values')
    for i_c, c in enumerate(clusters):
        if cluster_p_values[i_c] < 0.05:
            plt.axvspan(times[c][0], times[c][-1], color='red', alpha=0.3)
    plt.axhline(0, color='black', linestyle='--')
    plt.title(f'Cluster Permutation Test (Load {load})')
    plt.xlabel('Time (s)')
    plt.ylabel('T-statistic')
    plt.legend()
    plt.tight_layout()
    plt.show()

    times = np.array(common_times)  # make sure it's ordered
    X1_mean = X1.mean(axis=0)
    X2_mean = X2.mean(axis=0)


    plt.plot(times, X1_mean, label='away')
    plt.plot(times, X2_mean, label='towards')


    # Highlight significant clusters
    for i_c, cluster in enumerate(clusters):
        if cluster_p_values[i_c] < 0.05:
            time_mask = cluster
            plt.axvspan(times[time_mask][0], times[time_mask][-1], color='red', alpha=0.3)

    plt.legend()
    plt.title(f'Cluster Permutation Test Load Conditions and button press towards or away from cardinal')
    plt.xlabel('Time (s)')
    plt.ylabel('Pupil size')
    plt.show()
