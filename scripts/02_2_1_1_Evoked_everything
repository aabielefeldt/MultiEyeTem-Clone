# %% 
# Trying to test the interaction between load and away cardinal?

# no interaction found

alpha = 0.05
n_perm = 5000


subset = evokeds_df_shifted_dw[evokeds_df_shifted_dw['trial_ori_pattern']=='all_cardinal']
subset = evokeds_df_shifted_dw[evokeds_df_shifted_dw['dist_to_cardinal']==11.25]
subset = evokeds_df_shifted_dw
# Build per-load (subjects × time) for each accuracy
def mat_for(away, load):
    sub = subset[(subset['away_cardinal'] == away) & (subset['items_presented'] == load)]
    return sub.pivot_table(index='subID', columns='time', values='pupils', aggfunc='mean')

C1, C2, C3 = mat_for(1,1), mat_for(1,2), mat_for(1,3)
I1, I2, I3 = mat_for(0, 1), mat_for(0, 2), mat_for(0, 3)

# Intersect subjects & times across all 6 to keep within-subjects
common_subs = C1.index
common_times = C1.columns
for M in [C2, C3, I1, I2, I3]:
    common_subs = common_subs.intersection(M.index)
    common_times = common_times.intersection(M.columns)
times = np.array(sorted(common_times))

C1 = C1.loc[common_subs, times].to_numpy()
C2 = C2.loc[common_subs, times].to_numpy()
C3 = C3.loc[common_subs, times].to_numpy()
I1 = I1.loc[common_subs, times].to_numpy()
I2 = I2.loc[common_subs, times].to_numpy()
I3 = I3.loc[common_subs, times].to_numpy()

# Drop timepoints with any NaN across all 6
col_ok = (~np.isnan(C1) & ~np.isnan(C2) & ~np.isnan(C3) &
          ~np.isnan(I1) & ~np.isnan(I2) & ~np.isnan(I3)).all(axis=0)

times = times[col_ok]
C1, C2, C3 = C1[:, col_ok], C2[:, col_ok], C3[:, col_ok]
I1, I2, I3 = I1[:, col_ok], I2[:, col_ok], I3[:, col_ok]

# Linear trend weights across loads
w = np.array([-1.0, 0.0, 1.0])

# Per-subject linear trend time series for Correct and Incorrect
trend_C = w[0]*C1 + w[1]*C2 + w[2]*C3   # (n_sub × n_time)
trend_I = w[0]*I1 + w[1]*I2 + w[2]*I3

# Interaction contrast: Correct − Incorrect (if positive → steeper positive load trend on correct trials)
X = (trend_C - trend_I)                  # (n_sub × n_time)

n = X.shape[0]
# Because we conduct a two-tailed test, we divide the p-value by 2 (which means
# we're making use of both tails of the distribution).
threshold = t.ppf(1 - 0.025, df=n-1)

# 1-sample cluster permutation test vs 0
T_obs, clusters, cluster_p_values, H0 = permutation_cluster_1samp_test(
    X,
    n_permutations=n_perm,
    threshold=threshold,   # auto t-threshold for 1-sample t
    tail=0,           # two-tailed (trend could be pos or neg)
    out_type='mask',
    verbose=True
)

rows = []
for i_c, c in enumerate(clusters):
    p = float(cluster_p_values[i_c])

    # c is a boolean mask (out_type='mask'); if it's a slice tuple, adapt accordingly
    if isinstance(c, np.ndarray):
        idx = np.flatnonzero(c)
    else:
        idx = np.arange(len(times))[c]

    if idx.size == 0:
        continue


    start_t = float(times[idx[0]])
    end_t   = float(times[idx[-1]])
    mean_t  = float(np.mean(T_obs[idx]))
    dur     = int(idx.size)

    rows.append({
        "effect": "Interaction (linear trend: Correct − Incorrect)",
        "cluster_id": int(i_c + 1),
        "start_time": start_t,
        "end_time": end_t,
        "duration_samps": dur,
        "p_value": p,
        "mean_t": mean_t,
        "n_subjects": int(X.shape[0]),
    })

summary = pd.DataFrame(rows).reset_index(drop=True)
display(summary if not summary.empty else pd.DataFrame({"note": ["No significant clusters after min-size filter."]}))
summary.to_csv("clusters_LoadxAccuracy_linearTrend_interaction_FIXED.csv", index=False)


# Plot t-curve with correctly shaded clusters
plt.figure(figsize=(10,5))
plt.plot(times, T_obs, label='t (Correct − Incorrect load trend)')
plt.axhline(0, color='k', linestyle=':', linewidth=0.8)

for i_c, c in enumerate(clusters):
    if cluster_p_values[i_c] < alpha:
        if isinstance(c, np.ndarray):
            idx = np.flatnonzero(c)
        else:
            idx = np.arange(len(times))[c]
        plt.axvspan(float(times[idx[0]]), float(times[idx[-1]]), color='red', alpha=0.3)

plt.xlabel("Time (s)")
plt.ylabel("t")
plt.title("Interaction via linear trend (C − I) — cluster summary (fixed mapping)")
plt.tight_layout()
plt.show()

