# %%

# Collapse across loads: average (Load1+Load2+Load3)/3 for Correct and False
mat_correct = pd.concat([mat_c1, mat_c2, mat_c3]).groupby(level=0).mean()
mat_false   = pd.concat([mat_f1, mat_f2, mat_f3]).groupby(level=0).mean()

# Align common subs/times
common_subs_acc = mat_correct.index.intersection(mat_false.index)
common_times_acc = mat_correct.columns.intersection(mat_false.columns)

Xc = mat_correct.loc[common_subs_acc, common_times_acc].to_numpy()
Xf = mat_false.loc[common_subs_acc, common_times_acc].to_numpy()
times_acc = common_times_acc.to_numpy()

def paired_t(X1, X2):
    t_vals, _ = stats.ttest_rel(X1, X2, axis=0)
    return t_vals


# Run paired-samples cluster t-test
# probably needs to be 1samp cluster test instead
T_obs_acc, clusters_acc, pvals_acc, H0_acc = permutation_cluster_test(
    [Xc, Xf],
    n_permutations=5000,
    tail=0,              # two-tailed t-test
    threshold=3,      # uses t-distribution automatically
    out_type='mask',
    verbose=True,
    stat_fun=paired_t

)

# Plot
plt.figure(figsize=(11,5))
plt.plot(times_acc, T_obs_acc, label='t (Accuracy main effect)')
for i_c, c in enumerate(clusters_acc):
    if pvals_acc[i_c] < 0.05:
        plt.axvspan(times_acc[c][0], times_acc[c][-1], alpha=0.3, label='p < 0.05 cluster' if i_c==0 else None)
plt.axhline(0, color='k', lw=0.8)
plt.xlabel('Time (s)')
plt.ylabel('t-statistic')
plt.title('Cluster permutation: Main effect of Accuracy (Correct vs False)')
plt.legend()
plt.tight_layout()
plt.show()

#%%
# -----------------------------
# 0) Prep
# -----------------------------
delay_time_window = evoked_df_accuracy.copy()
delay_time_window['time'] = delay_time_window['time'].round(3)


# OPTIONAL: z-score within subject (across all trials & times) BEFORE averaging
#delay_time_window['pupils'] = delay_time_window.groupby('subID')['pupils'].transform(lambda x: zscore(x, nan_policy='omit'))

start_time = 3
end_time = 6.5
delay_time_window = delay_time_window[(delay_time_window['time'] >= start_time) & (delay_time_window['time'] <= end_time)]

# -----------------------------
# 1) Build subject×time matrices per Load & Accuracy
# -----------------------------
def make_matrix(dfin, load_val, acc_label):
    _df = dfin[(dfin['Load'] == load_val) & (dfin['accuracy'] == acc_label)]
    # average over any residual trials per subject/time
    piv = _df.pivot_table(index='subID', columns='time', values='pupils', aggfunc='mean')
    return piv  # rows: subjects, cols: time

mat_c1 = make_matrix(delay_time_window, 1, 'correct')
mat_f1 = make_matrix(delay_time_window, 1, 'false')
mat_c2 = make_matrix(delay_time_window, 2, 'correct')
mat_f2 = make_matrix(delay_time_window, 2, 'false')
mat_c3 = make_matrix(delay_time_window, 3, 'correct')
mat_f3 = make_matrix(delay_time_window, 3, 'false')

# -----------------------------
# 2) Make "difference waves" per Load: Correct - False
# -----------------------------
# Align time axes per load
common_times_1 = mat_c1.columns.intersection(mat_f1.columns)
common_times_2 = mat_c2.columns.intersection(mat_f2.columns)
common_times_3 = mat_c3.columns.intersection(mat_f3.columns)

D1 = (mat_c1[common_times_1] - mat_f1[common_times_1])
D2 = (mat_c2[common_times_2] - mat_f2[common_times_2])
D3 = (mat_c3[common_times_3] - mat_f3[common_times_3])

# -----------------------------
# 3) Ensure common subjects & common timepoints across ALL three loads
# -----------------------------
common_subs = D1.index.intersection(D2.index).intersection(D3.index)
common_times = D1.columns.intersection(D2.columns).intersection(D3.columns)

D1 = D1.loc[common_subs, common_times]
D2 = D2.loc[common_subs, common_times]
D3 = D3.loc[common_subs, common_times]
times = common_times.to_numpy()

X1 = D1.to_numpy()  # shape: n_subjects × n_times
X2 = D2.to_numpy()
X3 = D3.to_numpy()

# -----------------------------
# 4) Repeated-measures (within-subject) one-way ANOVA F stat over loads
#    This computes F at each timepoint assuming subjects are a random factor.
# -----------------------------
def rm_oneway_F(*X):
    """
    X: list of arrays, each shape (n_subjects, n_times), one per level (here 3 loads)
    Returns: F-values per timepoint (shape: n_times,)
    """
    Y = np.stack(X, axis=1)               # (S, L, T)
    S, L, T = Y.shape
    # Means
    grand = Y.mean(axis=(0, 1))           # (T,)
    subj_mean = Y.mean(axis=1)            # (S, T)
    level_mean = Y.mean(axis=0)           # (L, T)
    # Sums of squares
    SS_total   = ((Y - grand)**2).sum(axis=(0, 1))              # (T,)
    SS_subject = L * ((subj_mean - grand)**2).sum(axis=0)       # (T,)
    SS_level   = S * ((level_mean - grand)**2).sum(axis=0)      # (T,)
    SS_error   = SS_total - SS_subject - SS_level               # (T,)
    # DoF
    df_level = L - 1
    df_error = (L - 1) * (S - 1)
    # Mean squares & F
    MS_level = SS_level / df_level
    MS_error = SS_error / df_error
    F = MS_level / MS_error
    return F

# -----------------------------
# 5) Cluster permutation (interaction test)
#    We're testing whether the accuracy difference depends on load -> A×B interaction.
#    Use one-tailed (F >= 0) and let threshold=None pick a data-driven threshold.
# -----------------------------
T_obs, clusters, cluster_p_values, H0 = permutation_cluster_test(
    [X1, X2, X3],
    stat_fun=rm_oneway_F,
    n_permutations=5000,
    threshold=3.0,   # data-driven threshold; or set an F critical value if you prefer
    tail=1,           # F is inherently one-sided (>= 0)
    out_type='mask',
    verbose=True
)

# -----------------------------
# 6) Plot F(t) and significant clusters
# -----------------------------
plt.figure(figsize=(11, 5))
plt.plot(times, T_obs, label='F (Accuracy×Load interaction)')
for i_c, c in enumerate(clusters):
    if cluster_p_values[i_c] < 0.05:
        # c is a boolean mask over time
        plt.axvspan(times[c][0], times[c][-1], alpha=0.3, label='p < 0.05 cluster' if i_c == 0 else None)
plt.axhline(0, color='k', lw=0.8)
plt.xlabel('Time (s)')
plt.ylabel('F-statistic')
plt.title('Cluster permutation: Accuracy × Load (interaction on Correct−False differences)')
plt.legend()
plt.tight_layout()
plt.show()

# Optionally, visualize the three difference waves (means across subjects)
plt.figure(figsize=(11, 5))
plt.plot(times, X1.mean(axis=0), label='Load 1: Correct−False')
plt.plot(times, X2.mean(axis=0), label='Load 2: Correct-False')
plt.plot(times, X3.mean(axis=0), label='Load 3: Correct−False')
for i_c, c in enumerate(clusters):
    if cluster_p_values[i_c] < 0.05:
        plt.axvspan(times[c][0], times[c][-1], alpha=0.2)
plt.axhline(0, color='k', lw=0.8)
plt.xlabel('Time (s)')
plt.ylabel('Δ pupil (arb. units)')
plt.title('Subject-mean difference waves by Load (for context)')
plt.legend()
plt.tight_layout()
plt.show()

