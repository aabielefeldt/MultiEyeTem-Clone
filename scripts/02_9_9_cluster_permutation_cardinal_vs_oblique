# %%
# 3.5- Cardinal vs Oblique trials (seperated by load and mask)
# maybe need to check power especially for this one?
# Cluster permutation test cardinal against oblique trials seperated by load and by mask and within delay time window

# Container to store all results
cluster_results = {}

# Loop over Load and Mask conditions
for mask_val in [0, 1]:
    for load_val in [1, 2, 3]:
        print(f"\nRunning cluster test for Load {load_val}, Mask {mask_val}...")

        # Filter data
        df_cond = delay_time_window[
            (delay_time_window['Load'] == load_val) &
            (delay_time_window['mask'] == mask_val)
        ]
        df_card = df_cond[df_cond['cardinal_type'] == 'mostly_cardinal']
        df_obli = df_cond[df_cond['cardinal_type'] == 'mostly_oblique']

        # Pivot: subjects × timepoints
        X1_df = df_card.pivot_table(index='subID', columns='time', values='pupils', aggfunc='mean')
        X2_df = df_obli.pivot_table(index='subID', columns='time', values='pupils', aggfunc='mean')

        # Align both groups by common subjects and times
        common_subs = X1_df.index.intersection(X2_df.index)
        common_times = X1_df.columns.intersection(X2_df.columns)

        # Skip if there's not enough subjects or timepoints
        if len(common_subs) < 2 or len(common_times) < 10:
            print("Not enough data – skipping.")
            continue

        # Get data arrays
        X1 = X1_df.loc[common_subs, common_times].to_numpy()
        X2 = X2_df.loc[common_subs, common_times].to_numpy()
        times = common_times.to_numpy()
        print(len(times))

        # Run cluster permutation test
        T_obs, clusters, cluster_p_values, H0 = permutation_cluster_test(
            [X1, X2],
            n_permutations=1000,
            threshold=2.0,
            tail=0,
            out_type='mask',
            verbose=True,
            stat_fun=paired_t,
        )

        # Store results
        key = f"Load{load_val}_Mask{mask_val}"
        cluster_results[key] = {
            "T_obs": T_obs,
            "clusters": clusters,
            "cluster_p_values": cluster_p_values,
            "times": times,
            "subjects": list(common_subs)
        }

        print(cluster_results[key]['cluster_p_values'])

        # Plot results
        plt.figure(figsize=(10, 5))
        plt.plot(times, T_obs, label='T-values')
        for i_c, c in enumerate(clusters):
            if cluster_p_values[i_c] < 0.05:
                plt.axvspan(times[c][0], times[c][-1], color='red', alpha=0.3)
        plt.axhline(0, color='black', linestyle='--')
        plt.title(f'Cluster Permutation: Load {load_val}, Mask {mask_val}')
        plt.xlabel('Time (s)')
        plt.ylabel('T-statistic')
        plt.legend()
        plt.tight_layout()
        plt.show()

        times = np.array(common_times)  # make sure it's ordered
        X1_mean = X1.mean(axis=0)
        X2_mean = X2.mean(axis=0)

        plt.plot(times, X1_mean, label='Mostly Cardinal')
        plt.plot(times, X2_mean, label='Mostly Oblique')

        # Highlight significant clusters
        for i_c, cluster in enumerate(clusters):
            if cluster_p_values[i_c] < 0.05:
                time_mask = cluster
                plt.axvspan(times[time_mask][0], times[time_mask][-1], color='red', alpha=0.3)

        plt.legend()
        plt.title(f'Cluster Permutation Test, load{load_val} mask{mask_val}')
        plt.xlabel('Time (s)')
        plt.ylabel('Pupil size')
        plt.show()




# %%
#%%
# Test the interaction between Load and Orientation type with a contrast based interaction test
# copied from: interaction between Load and Accuracy with a contrast based interaction test

alpha = 0.05
n_perm = 5000


# Build per-load (subjects × time) for each accuracy
def mat_for(ct, load):
    sub = delay_time_window[(delay_time_window['cardinal_type'] == ct) & (delay_time_window['Load'] == load)]
    return sub.pivot_table(index='subID', columns='time', values='pupils', aggfunc='mean')

C1, C2, C3 = mat_for('mostly_oblique',1), mat_for('mostly_oblique',2), mat_for('mostly_oblique',3)
I1, I2, I3 = mat_for('mostly_cardinal',  1), mat_for('mostly_cardinal',  2), mat_for('mostly_cardinal',  3)

# Intersect subjects & times across all 6 to keep within-subjects
common_subs = C1.index
common_times = C1.columns
for M in [C2, C3, I1, I2, I3]:
    common_subs = common_subs.intersection(M.index)
    common_times = common_times.intersection(M.columns)
times = np.array(sorted(common_times))

C1 = C1.loc[common_subs, times].to_numpy()
C2 = C2.loc[common_subs, times].to_numpy()
C3 = C3.loc[common_subs, times].to_numpy()
I1 = I1.loc[common_subs, times].to_numpy()
I2 = I2.loc[common_subs, times].to_numpy()
I3 = I3.loc[common_subs, times].to_numpy()

# Drop timepoints with any NaN across all 6
col_ok = (~np.isnan(C1) & ~np.isnan(C2) & ~np.isnan(C3) &
          ~np.isnan(I1) & ~np.isnan(I2) & ~np.isnan(I3)).all(axis=0)

times = times[col_ok]
C1, C2, C3 = C1[:, col_ok], C2[:, col_ok], C3[:, col_ok]
I1, I2, I3 = I1[:, col_ok], I2[:, col_ok], I3[:, col_ok]

# Linear trend weights across loads
w = np.array([-1.0, 0.0, 1.0])

# Per-subject linear trend time series for Correct and Incorrect
trend_C = w[0]*C1 + w[1]*C2 + w[2]*C3   # (n_sub × n_time)
trend_I = w[0]*I1 + w[1]*I2 + w[2]*I3

# Interaction contrast: Correct − Incorrect (if positive → steeper positive load trend on correct trials)
X = (trend_C - trend_I)                  # (n_sub × n_time)

n = X.shape[0]
threshold = t.ppf(1 - 0.025, df=n-1)

# 1-sample cluster permutation test vs 0
T_obs, clusters, cluster_p_values, H0 = permutation_cluster_1samp_test(
    X,
    n_permutations=n_perm,
    threshold=threshold,   # auto t-threshold for 1-sample t
    tail=0,           # two-tailed (trend could be pos or neg)
    out_type='mask',
    verbose=True
)

rows = []
for i_c, c in enumerate(clusters):
    p = float(cluster_p_values[i_c])
    if p < alpha:
        # c is a boolean mask (out_type='mask'); if it's a slice tuple, adapt accordingly
        if isinstance(c, np.ndarray):
            idx = np.flatnonzero(c)
        else:
            idx = np.arange(len(times))[c]

        if idx.size == 0:
            continue


        start_t = float(times[idx[0]])
        end_t   = float(times[idx[-1]])
        mean_t  = float(np.mean(T_obs[idx]))
        dur     = int(idx.size)

        rows.append({
            "effect": "Interaction (linear trend: mostly_oblique − mostly_cardinal)",
            "cluster_id": int(i_c + 1),
            "start_time": start_t,
            "end_time": end_t,
            "duration_samps": dur,
            "p_value": p,
            "mean_t": mean_t,
            "n_subjects": int(X.shape[0]),
        })

summary = pd.DataFrame(rows).reset_index(drop=True)
display(summary if not summary.empty else pd.DataFrame({"note": ["No significant clusters after min-size filter."]}))
summary.to_csv("clusters_LoadxAccuracy_linearTrend_interaction_FIXED.csv", index=False)


# Plot t-curve with correctly shaded clusters
plt.figure(figsize=(10,5))
plt.plot(times, T_obs, label='t (mostly_oblique − mostly_cardinal load trend)')
plt.axhline(0, color='k', linestyle=':', linewidth=0.8)

for i_c, c in enumerate(clusters):
    if cluster_p_values[i_c] < alpha:
        if isinstance(c, np.ndarray):
            idx = np.flatnonzero(c)
        else:
            idx = np.arange(len(times))[c]
        plt.axvspan(float(times[idx[0]]), float(times[idx[-1]]), color='red', alpha=0.3)

plt.xlabel("Time (s)")
plt.ylabel("t")
plt.title("Interaction via linear trend (C − I) — cluster summary (fixed mapping)")
plt.tight_layout()
plt.show()


# %%
