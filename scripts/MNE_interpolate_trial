# %%

import mne
from mne.annotations import Annotations, _annotations_starts_stops
import numpy as np

# %%
fpath = mne.datasets.sample.data_path() / "MEG" / "sample" / "sample_audvis_raw.fif"
raw = mne.io.read_raw_fif(fpath)
print(raw.first_time)


# %%

# %%
events = mne.find_events(raw)
sfreq = raw.info['sfreq']


annotations = mne.annotations_from_events(events, sfreq)
raw.set_annotations(annotations)

print(raw.annotations)
#print(raw.events)
#%%
# similar to my interpolation function, setting start and end based on annotation onsets
mask = np.zeros_like(raw.times, dtype=bool)
match = ['1']
ones_annots = [annot for annot in raw.annotations if annot["description"] in match]

for annot in ones_annots:
    # Update the mask for times within the current blink period
    start = annot["onset"]
    end = annot["onset"] + annot["duration"]
    print(start,end)
    print(raw.time_as_index(start))
    print(raw.time_as_index(end))
    
    mask |= (raw.times >= start) & (raw.times <= end)


#%%
# starts and ends from annotations_starts_stops function
# .. very different results, why?
# maybe connected to sfreq?
# or to the fact that the first sample isnt zero?
starts, ends = _annotations_starts_stops(raw, "1")
# print(starts*sfreq, ends*sfreq)
# #above is the same as below with time_as_index
# print(raw.time_as_index(starts))
print(starts,ends)
