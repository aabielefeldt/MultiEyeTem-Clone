# cluster_results_mask_vs_nomask = pd.read_csv('../data/csv_files/cluster_results_mask_vs_nomask.csv')
evoked_df_shifted = pd.read_csv('../data/csv_files/evoked_df_shifted.csv')

evoked_df_shifted["time"] = evoked_df_shifted["time"].round(3)
# then use x="time_r" in the helper + lineplot, and marker times as exact values
#%%

delay_start, delay_end = 3.0, 6.5   # adjust if needed (inclusive/exclusive is up to you)

# Boolean mask for delay period
is_delay = evoked_df_shifted["time"].between(delay_start, delay_end, inclusive="both")

def delay_zscore_apply_all(g):
    # compute mean/sd from delay only, apply to all rows of that subject
    delay_vals = g.loc[is_delay.loc[g.index], "pupils"].to_numpy()

    mu = np.nanmean(delay_vals)
    sd = np.nanstd(delay_vals, ddof=0)

    # avoid division-by-zero if sd == 0 or all NaN
    if not np.isfinite(sd) or sd == 0:
        return pd.Series(np.nan, index=g.index)

    return (g["pupils"] - mu) / sd

evoked_df_shifted["pupils_z_delay"] = (
    evoked_df_shifted
    .groupby("subID", group_keys=False)
    .apply(delay_zscore_apply_all)
)


# Z-score within each subject (across all times and trials) - should maybe be based on zscore only of delay period because that is what I am analysing
evoked_df_shifted['pupils_z'] = evoked_df_shifted.groupby('subID')['pupils'].transform(
    lambda x: zscore(x, nan_policy='omit'))

#%%
marker_times = {
    1: [2],
    2: [1, 2],
    3: [0, 1, 2]
}

def add_load_markers(ax, data, x="time", y="pupils_z_delay", hue="Load"):

    # Get line colors (for circle fills)
    handles, labels = ax.get_legend_handles_labels()
    color_map = {}
    for h, lab in zip(handles, labels):
        try:
            key = int(lab)
        except ValueError:
            key = lab
        color_map[key] = h.get_color()

    # Mean timecourse
    m = data.groupby([hue, x], as_index=False)[y].mean()

    for load, times in marker_times.items():

        mm = m[m[hue].eq(load) & m[x].isin(times)]

        for i, (_, row) in enumerate(mm.iterrows(), start=1):

            # Circle (Load color)
            ax.scatter(
                row[x], row[y],
                s=160,
                marker="o",
                color=colors_load[i-1],
                edgecolor="white",
                linewidth=1,
                zorder=10
            )

            # Number (position color)
            ax.text(
                row[x], row[y],
                str(i),
                color="white",
                ha="center",
                va="center",
                fontsize=9,
                weight="bold",
                zorder=11
            )


