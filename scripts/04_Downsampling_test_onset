# %%
# subID to resample from freqs_df (which has been created in the epochs script)
freqs_df = pd.read_csv('/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Tables_and_Dataframes/freqs_df.csv')
subject = freqs_df[freqs_df['frequency']>500]
i = subject['subID']

# i = 'KJN4WD'

folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/data_eyelink"

eyelink_file = folder_path + "/" + i + ".asc"
print(eyelink_file)
raw = mne.io.read_raw_eyelink(eyelink_file)

metadata_pp = df.loc[(df['subID'] == i)]
events_from_annot, event_dict = mne.events_from_annotations(
raw, event_id=custom_mapping)

test_onset_dict = {"onset_concrete_cued_left": 220,
    "onset_concrete_cued_right": 221}

# %%

# baseline set to None
# baseline is only added for all epochs in the next script

current_sfreq = raw.info["sfreq"]
desired_sfreq = 500  # Hz
decim = np.round(current_sfreq / desired_sfreq).astype(int)
obtained_sfreq = current_sfreq / decim
lowpass_freq = obtained_sfreq / 3.0

raw_filtered = raw.copy().filter(l_freq=None, h_freq=lowpass_freq)
events_from_annot, event_dict = mne.events_from_annotations(
    raw_filtered, event_id=custom_mapping)

pupil_epochs = mne.Epochs(
    raw_filtered, 
    events_from_annot[np.isin(events_from_annot, [220, 221])[:,-1]],
    event_id=test_onset_dict, 
    tmin=-6.5,
    tmax=2.5,
    baseline=None,
    metadata=metadata_pp,
    picks=['pupil_left', 'pupil_right'],
    event_repeated='merge',
    preload=True,
    reject_by_annotation=False,
    decim=decim
)

print(
    "desired sampling frequency was {} Hz; decim factor of {} yielded an "
    "actual sampling frequency of {} Hz.".format(
        desired_sfreq, decim, pupil_epochs.info["sfreq"]
    )
)


folder_name = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Epochs_data_test_onset"
filename = f"{i}-epo.fif"
filepath = os.path.join(folder_name, filename)
pupil_epochs.save(filepath, overwrite=True, split_size='1.8GB', split_naming='bids', verbose=None)


