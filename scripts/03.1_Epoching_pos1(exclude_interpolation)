# to have this be run as code I would need to use the original annotations?? These are only read while doing the epochs.. Can I do it without them? 
# Just have Code to put in the dictionary always the number that is 



# %%

# check if ordering is correct (what I wrote in notion is not correct I think but this should be right)


# can also write code making the triggers themselves: 
n_objects = ['obj1', 'obj2', 'obj3']
n_positions = ['pos1', 'pos2', 'pos3']
n_orientations = [f'ori{i}' for i in range(1, 17)]

# Generate combinations of the three conditions
combinations = itertools.product(n_positions, n_objects, n_orientations)

# Create a dictionary to store the combinations
trigger_dict = {}

# Populate the dictionary with formatted combinations
for idx, combo in enumerate(combinations, start=1):
    trigger_dict['_'.join(combo)] = idx

additional_pairs = {
    "onset_concrete_cued_left": 220,
    "onset_concrete_cued_right": 221,
    "left_button_press": 241,
    "right_button_press": 242,
    "feedback_cued_item": 244,
    "mask": 245,
    "beginning/end_of_task": 246
}

trigger_dict.update(additional_pairs)

# %% 

# Extract values with "pos1" in the key
values_with_pos1 = [trigger_dict[key] for key in trigger_dict if "pos1" in key]

# Extract key-value pairs from trigger_dict where the value contains "pos1"
pos1_pairs = {key: trigger_dict[key] for key in trigger_dict if "pos1" in key}

# Print the dictionary
print("Key-value pairs with 'pos1' in the value:")
print(pos1_pairs)


# %% 
# try saving this in the data folder not in the script folder

datafolder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data"
folder_name = f"Epochs_pos1"
epochs_folderpath = os.path.join(datafolder_path, folder_name)
os.makedirs(epochs_folderpath, exist_ok=True)

#  %%
# Making the epochs over pos1

# make the epochs slightly longer so I can have a intertrialbaseline for condition 3 (-6.6 - -6.5)
# do I need to make three for every participant? Or can I just take the one and seperate by condition
# one_subID = ['REUNMA']

# at the moment no loop over conditions - does it work?

for i in good_partis:
        folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/data_eyelink"

        eyelink_file = folder_path + "/" + i + ".asc"
        print(eyelink_file)
        raw = mne.io.read_raw_eyelink(eyelink_file)

        mne.preprocessing.eyetracking.interpolate_blinks(raw, buffer=0.05, match='BAD_blink', interpolate_gaze=False)
        # metadata_pp = df.loc[(df['subID'] == i) & (df['items_presented'] == condition)]
        metadata_pp = df.loc[(df['subID'] == i)]
        
        events_from_annot, event_dict = mne.events_from_annotations(
            raw, event_id=custom_mapping)
        display(events_from_annot)

        # Filter events based on the current condition

        # all events per participant
        events_pos1 = events_from_annot[np.isin(events_from_annot, [values_with_pos1])[:, -1]]

        # need to now filter them to only include those for one condition
        # the metadata is already set to only one condition in this loop and therefore the idea here is to use
        # the index of the metadata for the events

        # make sure the index is really correct
        #events_condition = events_onset[metadata_pp.index, :]

        pupil_epochs_pos1 = mne.Epochs(
            raw,
            events_pos1,
            event_id=pos1_pairs,
            tmin=-0.1,
            tmax=9,
            baseline=None,
            metadata=metadata_pp,
            picks=['pupil_left', 'pupil_right'],
            event_repeated='merge',
            preload=True,
            reject_by_annotation=False
        )

        # Save epoch in fif format to a specified folder
        filename = f"{i}_pos1_interpol-epo.fif"
        epochs_path = os.path.join(epochs_folderpath, filename)
        pupil_epochs_pos1.save(epochs_path, overwrite=True, split_size='1.8GB', split_naming='bids', verbose=None)



