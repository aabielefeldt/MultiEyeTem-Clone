            print("Significant")
        else:
            print("Not Significant")
print(f'There were {result_len} elements in the results')

# In this case the result means that a participant that is not significant is not
# significantly different from the expected proportion or from chance level. They performed not better 
# than chance level. However this would mean that performing significantly worse than chance level would not be
# exlcluded either
