# %% Load Metadata

df = pd.read_csv('../data/csv_files/df.csv')
good_partis = df['subID'].unique()

# %%
# Cardinal Repulsion Polar Plot

# Define paths for saving files
csv_save_dir = '../data/csv_files'
figures_save_dir = '../figures'

# Data
mbp_df = df.groupby(by=['object_cued_rot', 'items_presented'])['button_press_clockwise'].mean().reset_index()

mbp_all = df.groupby('object_cued_rot')['button_press_clockwise'].mean().reset_index()
mbp_con1 = mbp_df[mbp_df['items_presented'] == 1]
mbp_con2 = mbp_df[mbp_df['items_presented'] == 2]
mbp_con3 = mbp_df[mbp_df['items_presented'] == 3]

mbp_all_rounded = mbp_all.round(4)
mbp_all_rounded.to_csv('../data/csv_files/mbp_all_rounded.csv', index=False)


# Polar Plot
fig = plt.figure()

# Change the projection to 'polar'
ax = fig.add_subplot(111, projection='polar')

# Get outer ylim for plotting radial lines
ylim = ax.get_ylim()

# to store values for plotting full circle lines at the end
thetas = []
thetas_adjusted = []
con1s = []
con2s = []
con3s = []
all_cons = []
colors = sns.hls_palette(17)
colors = sns.color_palette("mako", as_cmap=True)
# Get ordered list of unique target orientations
oris = df['object_cued_rot'].unique()
oris.sort()   
oris = np.append(oris, oris[0])

unbiased_assumption = np.full(17, 0.5)

for i in range(len(oris)):
    theta = np.radians(oris[i])
    theta_adjusted = -theta + ((np.pi/2)) % (2*np.pi)

    all_con = mbp_all[mbp_all['object_cued_rot']==oris[i]]['button_press_clockwise'].mean()
    con1 = mbp_con1[mbp_con1['object_cued_rot']==oris[i]]['button_press_clockwise'].mean()
    con2 = mbp_con2[mbp_con2['object_cued_rot']==oris[i]]['button_press_clockwise'].mean()
    con3 = mbp_con3[mbp_con3['object_cued_rot']==oris[i]]['button_press_clockwise'].mean()
    
    thetas.append(theta)
    thetas_adjusted.append(theta_adjusted)
    all_cons.append(all_con)
    con1s.append(con1)
    con2s.append(con2)
    con3s.append(con3)

    ax.plot(theta_adjusted, all_con, 'o', color=colors[1])
    ax.plot(theta_adjusted, con1, 'o', color=colors[5])
    ax.plot(theta_adjusted, con2, 'o', color=colors[9])
    ax.plot(theta_adjusted, con3, 'o', color=colors[13])

    # Add text labels for each point to inspect if needed
    # text_positions = np.full(17, 0.55)[i]
    # label_offset = 0.0  # Adjust this value for label position
    # ax.text(theta_adjusted, text_positions + label_offset, str(oris[i]), fontsize=9, ha='center', va='center', color='black')



# Plotting lines to connect dots
ax.plot(thetas_adjusted, all_cons, '--', color=colors[1])
ax.plot(thetas_adjusted, con1s, '-', color=colors[5])
ax.plot(thetas_adjusted, con2s, '-', color=colors[9])
ax.plot(thetas_adjusted, con3s, '-', color=colors[13])

ax.plot(thetas_adjusted, unbiased_assumption, color=colors[16], linestyle='dashed')

# plt.legend()

plt.show()

