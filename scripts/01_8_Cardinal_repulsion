# %%
# Example function to calculate absolute differences based on grouped DataFrame
def calculate_absolute_differences(df, chosen_column, condition=None):
    # Filter DataFrame based on condition
    if condition:
        df_grouped = df[df['items_presented'] == condition]
    else:
        df_grouped = df
        
    # Group by required columns and calculate mean for each group
    df_grouped = df_grouped.groupby(['subID', 'object_cued_rot', 'Cardinal_Category']).agg(
        {chosen_column: 'mean'}).reset_index()

    # List to store results
    results = []

    # Process each subID separately
    for sub_id, group in df_grouped.groupby('subID'):
        group = group.sort_values('object_cued_rot').reset_index(drop=True)

        # Calculate median subtracted orientations
        group['median_subtracted_oris'] = group['object_cued_rot'].rolling(window=2).median().fillna(0)

        # Calculate differences in the chosen column
        group[f'{chosen_column}_abs_difference'] = group[chosen_column].diff().abs()

        # Handle circular difference between last and first orientation
        circular_diff = abs(group[chosen_column].iloc[-1] - group[chosen_column].iloc[0])
        group.loc[group.index[0], f'{chosen_column}_abs_difference'] = circular_diff

        # Append to results
        results.append(group)

    # Concatenate all results into a single DataFrame
    df_with_diffs = pd.concat(results, ignore_index=True)

    return df_with_diffs

# %%

# Modified function to calculate mean differences first, then apply absolute value
def calculate_differences_with_delayed_abs(df, chosen_column, condition=None):
    # Filter DataFrame based on condition
    if condition:
        df_grouped = df[df['items_presented'] == condition]
    else:
        df_grouped = df
        
    # Group by required columns and calculate mean for each group
    df_grouped = df_grouped.groupby(['subID', 'object_cued_rot', 'Cardinal_Category']).agg(
        {chosen_column: 'mean'}).reset_index()

    # List to store results
    results = []

    # Process each subID separately
    for sub_id, group in df_grouped.groupby('subID'):
        group = group.sort_values('object_cued_rot').reset_index(drop=True)
        
        # Calculate median subtracted orientations
        group['median_subtracted_oris'] = group['object_cued_rot'].rolling(window=2).median().fillna(0)
        
        # Calculate signed differences (do not apply abs yet)
        group[f'{chosen_column}_difference'] = group[chosen_column].diff()
        
        # Handle circular difference between last and first orientation
        circular_diff = group[chosen_column].iloc[-1] - group[chosen_column].iloc[0]
        group.loc[group.index[0], f'{chosen_column}_difference'] = circular_diff
        
        # Append to results
        results.append(group)

    # Concatenate all results into a single DataFrame
    df_with_diffs = pd.concat(results, ignore_index=True)
    print(df_with_diffs)
    # Now calculate mean of differences per orientation and take absolute value after mean calculation
    df_mean_diffs = df_with_diffs.groupby(['object_cued_rot', 'median_subtracted_oris']).agg(
        {f'{chosen_column}_difference': 'mean'}).reset_index()

    # Apply absolute transformation after taking the mean
    df_mean_diffs[f'{chosen_column}_abs_difference'] = df_mean_diffs[f'{chosen_column}_difference'].abs()

    return df_mean_diffs

# Example usage
# Assuming 'df' is your DataFrame and 'button_press_clockwise' is the chosen column
mean_diffs_all_conditions = calculate_differences_with_delayed_abs(df, 'button_press_clockwise')


