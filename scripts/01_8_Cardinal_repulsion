# %% 
# Subtracting - manually without the function
# Calculating clockwise button press proportion for the orientations of interest (closest to the cardinal axes)

# Grouping the data by the necessary keys and producing a mean for button press clockwise for every condition and orientation and subject ID

df_grouped = df.groupby(by=['subID', 'items_presented', 'object_cued_rot'])['button_press_clockwise'].mean().reset_index()

# Grouping by Condition
condition_grps = df_grouped.groupby('items_presented', as_index=False)

seperated_con_difs = []        # List for condition-specific differences
combined_con_difs = []  # List for differences across all conditions

conditions = np.sort(df['items_presented'].unique())

for condition in conditions:
    current_condition = condition_grps.get_group(condition)
    
    for i in good_partis:
        participant_grp = current_condition.groupby('subID', as_index=False)
        participant_data = participant_grp.get_group(i)
        differences = []
        
        # Define the pairs of orientations for subtraction
        orientation_pairs = [(11.25, 348.75), (101.25, 78.75), (191.25, 168.75), (281.25, 258.75)]

        # calculating the mean for that orientation within that participant and load condition
        for ori_x, ori_y in orientation_pairs:
            value_x = participant_data.loc[participant_data['object_cued_rot'] == ori_x, 'button_press_clockwise'].mean()
            value_y = participant_data.loc[participant_data['object_cued_rot'] == ori_y, 'button_press_clockwise'].mean()
        
            # Calculate the difference and append to the list
            difference = value_x - value_y
            differences.append(difference)

        mean_difference = np.mean(differences)
        seperated_con_difs.append((i, mean_difference, condition))
        
    # Now, calculate the mean difference across all conditions (for the same participants) at the same time
    df_grouped_all_con = df.groupby(['subID', 'object_cued_rot'])['button_press_clockwise'].mean().reset_index()

    for i in good_partis:
        participant_grp_all_con = df_grouped_all_con.groupby('subID', as_index=False)
        participant_data_all_con = participant_grp_all_con.get_group(i)
        differences_all_con = []

        for ori_x, ori_y in orientation_pairs:
            value_x_all_con = participant_data_all_con.loc[participant_data_all_con['object_cued_rot'] == ori_x, 'button_press_clockwise'].mean()
            value_y_all_con = participant_data_all_con.loc[participant_data_all_con['object_cued_rot'] == ori_y, 'button_press_clockwise'].mean()

            # Calculate the difference and append to the list
            difference_all_con = value_x_all_con - value_y_all_con
            differences_all_con.append(difference_all_con)
            #print(i, value_x_all_con, value_y_all_con, difference_all_con, differences_all_con)

        mean_difference_all_con = np.mean(differences_all_con)
        combined_con_difs.append((i, mean_difference_all_con))

# Create DataFrames for both condition-specific differences and all conditions combined
seperated_con_difs_df = pd.DataFrame(seperated_con_difs, columns=['subID', 'Mean_Difference', 'items_presented'])
combined_con_difs_df = pd.DataFrame(combined_con_difs, columns=['subID', 'Mean_Difference'])

# Display the DataFrames
display(seperated_con_difs_df)
display(combined_con_difs_df)


#%% 
#  T-test against zero for all conditions together 
ttest_results = pg.ttest(combined_con_difs_df['Mean_Difference'], 0)
display(ttest_results.round(4))

p_value = ttest_results['p-val'].values

# Define the significance level (alpha)
alpha = 0.05

# Check if the p-value is less than alpha to determine significance
if p_value < alpha:
    print("The t-test indicates a significant difference in cardinal bias from 0 across all load conditions.")
else:
    print("The t-test does not indicate a significant difference in cardinal bias from 0 across all load conditions.")

#%%

# Also run t-tests for all conditions individually against zero?
# checking wether there is cardinal repulsion present in each condition

conditions = np.sort(df['items_presented'].unique())

for condition in conditions:
    con_specific = seperated_con_difs_df.loc[seperated_con_difs_df['items_presented'] == condition, 'Mean_Difference'].reset_index()
    ttest_results = pg.ttest(con_specific['Mean_Difference'], 0)
    display(ttest_results.round(4))

    p_value = ttest_results['p-val'].values

    # Define the significance level (alpha)
    alpha = 0.05

    # Check if the p-value is less than alpha to determine significance
    if p_value < alpha:
        print(f"The t-test indicates a significant difference in cardinal bias from 0 in condition {condition}.")
    else:
        print(f"The t-test does not indicate a significant difference in cardinal bias from 0 in condition {condition}.")


