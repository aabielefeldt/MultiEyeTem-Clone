# completeley new idea using Gipetto 

import numpy as np
import pandas as pd

# ============================================================
# 1) Helpers: circular distance + nearest cardinal axis (0/90/180/270)
# ============================================================

CARDINALS = np.array([0.0, 90.0, 180.0, 270.0])

def wrap360(theta):
    """Wrap degrees into [0, 360). Works on scalars or numpy arrays/Series."""
    return np.mod(theta, 360.0)

def circ_dist_deg(a, b):
    """
    Circular distance between angles a and b in degrees, in [0, 180].
    a, b can be arrays/Series.
    """
    a = wrap360(a)
    b = wrap360(b)
    d = np.abs(a - b)
    return np.minimum(d, 360.0 - d)

def nearest_cardinal_axis(theta_mem):
    """
    For each theta_mem (deg), return nearest cardinal axis (0/90/180/270)
    and distance to it.
    """
    theta_mem = wrap360(theta_mem)
    # dist to each cardinal: shape (n, 4)
    dists = np.stack([circ_dist_deg(theta_mem, c) for c in CARDINALS], axis=1)
    idx = np.argmin(dists, axis=1)
    axis = CARDINALS[idx]
    dmin = dists[np.arange(len(theta_mem)), idx]
    return axis, dmin


# ============================================================
# 2) Trial-level "away from cardinal" coding from button press
#    Your columns:
#      - object_cued_rot: memorized/original orientation (deg)
#      - button_press_clockwise: 1=CW, 0=CCW
#    Optional:
#      - object_test_rot_cued: probe orientation shown (deg)
#      - acc_trial_concrete_cued: accuracy (0/1)
# ============================================================

def add_cardinal_bias_columns(df,
                              mem_col="object_cued_rot",
                              press_col="button_press_clockwise",
                              eps_deg=1.0):
    """
    Adds:
      - nearest_cardinal (deg)
      - dist_to_cardinal (deg)
      - away_cardinal (0/1): whether chosen direction moves AWAY from the nearest cardinal
      - bias_signed (deg): + if away, - if toward (magnitude in degrees for eps step)
    Uses a tiny step eps_deg in the chosen direction from the memorized orientation.
    """
    out = df.copy()

    theta_mem = wrap360(out[mem_col].to_numpy(dtype=float))
    axis, d_mem = nearest_cardinal_axis(theta_mem)

    # Map button press to direction: CW=+1, CCW=-1
    dir_resp = np.where(out[press_col].to_numpy() == 1, 1.0, -1.0)

    theta_step = wrap360(theta_mem + eps_deg * dir_resp)
    d_step = circ_dist_deg(theta_step, axis)

    away = (d_step > d_mem).astype(int)     # 1 = away, 0 = toward
    # If you want to treat exact ties (rare) as NA:
    ties = np.isclose(d_step, d_mem, atol=1e-12)
    away = away.astype("float")
    away[ties] = np.nan

    out["nearest_cardinal"] = axis
    out["dist_to_cardinal"] = d_mem
    out["away_cardinal"] = away
    out["bias_signed"] = (d_step - d_mem)   # >0 away, <0 toward (in "eps degrees" units)
    return out


# --- apply to your df ---
df2 = add_cardinal_bias_columns(df,
                                mem_col="object_cued_rot",
                                press_col="button_press_clockwise",
                                eps_deg=1.0)

# Quick sanity checks
print(df2[["object_cued_rot", "nearest_cardinal", "dist_to_cardinal",
           "button_press_clockwise", "away_cardinal", "bias_signed"]].head())


# ============================================================
# 3) Aggregate like your snippet, but now for AWAY bias
#    (mean away_cardinal = proportion of responses that move away from cardinal)
# ============================================================

mbp_bias = (
    df2.groupby(["object_cued_rot", "items_presented"])["away_cardinal"]
       .mean()
       .reset_index(name="p_away")
)

mbp_bias_all = (
    df2.groupby("object_cued_rot")["away_cardinal"]
       .mean()
       .reset_index(name="p_away")
)

mbp_bias_con1 = mbp_bias[mbp_bias["items_presented"] == 1]
mbp_bias_con2 = mbp_bias[mbp_bias["items_presented"] == 2]
mbp_bias_con3 = mbp_bias[mbp_bias["items_presented"] == 3]

mbp_bias_all.round(4).to_csv("../data/csv_files/p_away_by_orientation.csv", index=False)


# ============================================================
# 4) Model: Does bias vary with load and/or accuracy?
#    Best practice is a trial-level logistic model.
#
#    statsmodels options:
#      A) GEE (logistic) with participant clusters (robust; very practical)
#      B) BinomialBayesMixedGLM (true random effects; a bit more complex)
#
#    Below is A) GEE, which is usually the easiest and solid.
# ============================================================

import statsmodels.api as sm
import statsmodels.formula.api as smf

# ---- you need a participant id column name here ----
# Common names: "participant", "subj", "subject", "ppid" etc.
subject = "subID"  # <- CHANGE THIS to your actual column name

# Prepare modeling frame
model_df = df2.copy()

# Keep only rows with away_cardinal defined (drop ties if any)
model_df = model_df.dropna(subset=["away_cardinal"])

# Keep only rows with defined accuracy
model_df = model_df.dropna(subset=["acc_trial_concrete_cued"])

# Ensure predictors are treated as categorical where appropriate
model_df["items_presented"] = model_df["items_presented"].astype("category")
model_df["accuracy"] = model_df["acc_trial_concrete_cued"].astype(int)


# Optional: include distance to cardinal as covariate (often important)
# model_df["dist_to_cardinal_z"] = (model_df["dist_to_cardinal"] - model_df["dist_to_cardinal"].mean()) / model_df["dist_to_cardinal"].std()

# --- GEE logistic with participant clusters ---
# This tests: away_cardinal ~ load * accuracy (+ optional covariate dist_to_cardinal)
# Remove accuracy terms if you don't have accuracy available.
gee_formula = "away_cardinal ~ C(items_presented) * accuracy + dist_to_cardinal"
# If you prefer without distance covariate:
# gee_formula = "away_cardinal ~ C(items_presented) * accuracy"

gee = smf.gee(
    formula=gee_formula,
    groups=model_df[subject],
    data=model_df,
    family=sm.families.Binomial()
)
gee_res = gee.fit()
print(gee_res.summary())

# Interpreting coefficients:
# Positive coef => higher log-odds of "away" responses (more repulsion away from cardinal).
# Use odds ratios:
odds_ratios = np.exp(gee_res.params)
print("\nOdds ratios:\n", odds_ratios)


# ============================================================
# 5) If you want participant-level ANOVA-style summaries:
#    Compute per-participant proportions then use ordinary stats.
#    (Less ideal than trial-level GEE/GLMM, but sometimes useful for plots.)
# ============================================================

# Per participant × load × accuracy mean away
if "acc_trial_concrete_cued" in df2.columns:
    subj_bias = (
        df2.dropna(subset=["away_cardinal"])
           .groupby([subject, "items_presented", "acc_trial_concrete_cued"])["away_cardinal"]
           .mean()
           .reset_index(name="p_away")
    )
    subj_bias.to_csv("../data/csv_files/p_away_by_subj_load_accuracy.csv", index=False)

# Per participant × load mean away (collapsed over accuracy)
subj_bias_load = (
    df2.dropna(subset=["away_cardinal"])
       .groupby([subject, "items_presented"])["away_cardinal"]
       .mean()
       .reset_index(name="p_away")
)
subj_bias_load.to_csv("../data/csv_files/p_away_by_subj_load.csv", index=False)

