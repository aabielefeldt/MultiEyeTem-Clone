# %%
# Imports
import pandas as pd

# %% Load Metadata

df = pd.read_csv('../data/csv_files/df.csv')
partis = df['subID'].unique()

# %% 
# Excluding Participants

# %%
# List of subject IDs to exclude
# potentially excluding UCXTVD and D62XJG because they had the square mask
results = pd.read_csv('../data/csv_files/binom_all_conditions_results.csv')
subjects_to_exclude = []
for i in partis:
    # Get the data for the current participant and drop NaN values
    # p_value = results.loc[results['subID'] == i, 'p-value'] > 0.05:
    if results.loc[results['subID'] == i, 'p-value'].values[0] > 0.05:
        subjects_to_exclude.append(i)

# %%
# Use boolean indexing to drop rows where 'subID' is in the exclusion list
df = df[~df['subID'].isin(subjects_to_exclude)]

good_partis = df['subID'].unique()

# need to save it like that?
# %%
df.to_csv('../data/csv_files/df.csv', index=False)

