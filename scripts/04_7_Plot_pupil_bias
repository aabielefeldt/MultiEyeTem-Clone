# cluster_results_mask_vs_nomask = pd.read_csv('../data/csv_files/cluster_results_mask_vs_nomask.csv')
evoked_df_button_press = pd.read_csv('../data/csv_files/evoked_df_button_press.csv')

evoked_df_button_press["time"] = evoked_df_button_press["time"].round(3)
# then use x="time_r" in the helper + lineplot, and marker times as exact values
#%%

delay_start, delay_end = 3.0, 6.5   # adjust if needed (inclusive/exclusive is up to you)

# Boolean mask for delay period
is_delay = evoked_df_button_press["time"].between(delay_start, delay_end, inclusive="both")

def delay_zscore_apply_all(g):
    # compute mean/sd from delay only, apply to all rows of that subject
    delay_vals = g.loc[is_delay.loc[g.index], "pupils"].to_numpy()

    mu = np.nanmean(delay_vals)
    sd = np.nanstd(delay_vals, ddof=0)

    # avoid division-by-zero if sd == 0 or all NaN
    if not np.isfinite(sd) or sd == 0:
        return pd.Series(np.nan, index=g.index)

    return (g["pupils"] - mu) / sd

evoked_df_button_press["pupils_z_delay"] = (
    evoked_df_button_press
    .groupby("subID", group_keys=False)
    .apply(delay_zscore_apply_all)
)


# Z-score within each subject (across all times and trials) - should maybe be based on zscore only of delay period because that is what I am analysing
evoked_df_button_press['pupils_z'] = evoked_df_button_press.groupby('subID')['pupils'].transform(
    lambda x: zscore(x, nan_policy='omit')
)
# an evoked where I used the full time of the encoding period until delay (differing lengths for load conditions) as the baseline
#evoked_df_shifted_full_trial_bl = pd.read_csv('../data/csv_files/evoked_df_shifted_full_trial_bl.csv')


df_cardinal_bias_acc = df.groupby(['subID', 'dist_probe_to_cardinal'])['acc_trial_concrete_cued'].mean().reset_index()
df_cardinal_bias_acc = df_cardinal_bias_acc.sort_values('dist_probe_to_cardinal')
df_cardinal_bias_acc_piv = df_cardinal_bias_acc.pivot(index=['subID'], columns='dist_probe_to_cardinal', values='acc_trial_concrete_cued').reset_index()
df_cardinal_bias_acc_piv['diff_card'] = df_cardinal_bias_acc_piv[3.25] - df_cardinal_bias_acc_piv[19.25]

df_cardinal_bias_acc_piv['diff_obli'] = df_cardinal_bias_acc_piv[25.75] - df_cardinal_bias_acc_piv[41.75]

diff_card_med = df_cardinal_bias_acc_piv['diff_card'].median()

diff_card_med_high = df_cardinal_bias_acc_piv[df_cardinal_bias_acc_piv['diff_card']>= diff_card_med]['subID']
diff_card_med_low = df_cardinal_bias_acc_piv[df_cardinal_bias_acc_piv['diff_card']< diff_card_med]['subID']

evoked_df_button_press['group'] = np.where(
    evoked_df_button_press['subID'].isin(diff_card_med_high), 'high', 'low'
)
#%%
evoked_df_button_press['bp_away'] = evoked_df_button_press['pressed_away_from_cardinal']
evoked_df_button_press['Load'] = evoked_df_button_press['items_presented']
# variance testing within delay
# not significant
# no difference between mask and no mask in terms of variance during the delay
# means I can savely use z-scoring during delay I guess

#%%
# variance in delay (significant)
delay = evoked_df_button_press[
    evoked_df_button_press["time"].between(3, 6.5)
]

delay_sd = delay.groupby(["subID", 'group'])["pupils"].std().reset_index(name="sd_pupil")

sd_mask = delay_sd[delay_sd["group"] == 'high']["sd_pupil"]
sd_nomask = delay_sd[delay_sd["group"] == 'low']["sd_pupil"]

lev_resu = levene(sd_mask, sd_nomask)
plt.figure()
sns.boxplot(data=delay_sd, x="group", y="sd_pupil")
sns.stripplot(data=delay_sd, x="group", y="sd_pupil", color="black", alpha=0.6)
display(lev_resu)

#%%
# variance overall (not significant)
delay = evoked_df_button_press[
    evoked_df_button_press["time"].between(0, 9)
]

delay_sd = delay.groupby(["subID", 'group'])["pupils"].std().reset_index(name="sd_pupil")

sd_mask = delay_sd[delay_sd["group"] == 'high']["sd_pupil"]
sd_nomask = delay_sd[delay_sd["group"] == 'low']["sd_pupil"]

lev_resu = levene(sd_mask, sd_nomask)
plt.figure()
sns.boxplot(data=delay_sd, x="group", y="sd_pupil")
display(lev_resu)

# %% means of the groups

# mean in delay (not significant)
delay = evoked_df_button_press[
    evoked_df_button_press["time"].between(3, 6.5)
]
delay_mean = delay.groupby(["subID", 'group'])["pupils"].mean().reset_index(name="mean_pupil")

mean_high = delay_mean[delay_mean["group"] == 'high']["mean_pupil"]
mean_low = delay_mean[delay_mean["group"] == 'low']["mean_pupil"]

resu = pg.ttest(mean_high, mean_low)
plt.figure()
sns.boxplot(data=delay_mean, x="group", y="mean_pupil")
display(resu)

