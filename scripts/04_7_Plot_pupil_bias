#%%
marker_times = {
    1: [2],
    2: [1, 2],
    3: [0, 1, 2]
}

def add_load_markers(ax, data, x="time", y="pupils_z_delay", hue="Load"):

    # Get line colors (for circle fills)
    handles, labels = ax.get_legend_handles_labels()
    color_map = {}
    for h, lab in zip(handles, labels):
        try:
            key = int(lab)
        except ValueError:
            key = lab
        color_map[key] = h.get_color()

    # Mean timecourse
    m = data.groupby([hue, x], as_index=False)[y].mean()

    for load, times in marker_times.items():

        mm = m[m[hue].eq(load) & m[x].isin(times)]

        for i, (_, row) in enumerate(mm.iterrows(), start=1):

            # Circle (Load color)
            ax.scatter(
                row[x], row[y],
                s=160,
                marker="o",
                color=colors_load[i-1],
                edgecolor="white",
                linewidth=1,
                zorder=10
            )

            # Number (position color)
            ax.text(
                row[x], row[y],
                str(i),
                color="white",
                ha="center",
                va="center",
                fontsize=9,
                weight="bold",
                zorder=11
            )


# %% 
colors_load = sns.color_palette("flare", 3)

with sns.plotting_context(context='paper', font_scale=1.5): 
    
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 8), sharey=True)

    # Plot for participants WITH mask (Left Plot)
    mask_data = evoked_df_button_press[evoked_df_button_press["group"]=='high']
    sns.lineplot(
        data=mask_data, 
        hue='Load', x='time', y='pupils_z_delay', style='bp_away',
        errorbar='se', ax=ax1, palette=colors_load
    )
    
    # Plot for participants WITHOUT mask (Right Plot)
    nomask_data = evoked_df_button_press[evoked_df_button_press["group"]=='low']
    sns.lineplot(
        data=nomask_data, 
        hue='Load', x='time', y='pupils_z_delay', style='bp_away',
        errorbar='se', ax=ax2, legend='full', palette=colors_load
    )

    add_load_markers(ax1, mask_data)
    add_load_markers(ax2, nomask_data)

    sns.despine(ax=ax1)
    sns.despine(ax=ax2)

    # # Add mask time
    # ax1.axvspan(3, 3.1, color='blue', alpha=0.15)
    # ax1.text(3, 1.1, "mask \ndisplay", color='blue', alpha=0.5, fontsize=10)

    # Add probe
    ylim = ax1.get_ylim()[1] 
    ax1.axvline(3, color='black', alpha=0.5)
    ax1.axvline(6.5, color='black', alpha=0.5)
    ax2.axvline(3, color='black', alpha=0.5)
    ax2.axvline(6.5, color='black', alpha=0.5)
    

    # Set x-axis to show all whole numbers within range
    x_ticks = np.arange(int(evoked_df_button_press['time'].min()), int(evoked_df_button_press['time'].max()) + 1, 1)
    ax2.set_xticks(x_ticks)
    ax2.set_xticklabels(x_ticks)
    ax1.set_xticks(x_ticks)
    ax1.set_xticklabels(x_ticks)

    ax1.set_title('High bias group', y=1.1, fontsize=16)
    ax2.set_title('Low bias group', y=1.1, fontsize=16)

    ax1.set_ylabel('pupil size (z-scored)')
    ax1.set_xlabel('time (s)')
    ax2.set_xlabel('time (s)')

    # Increase font size of x and y tick labels
    ax2.tick_params(axis='x', labelsize=14)
    ax2.tick_params(axis='y', labelsize=14)

    ax1.autoscale(enable=True, axis='y', tight=True)
    ax2.autoscale(enable=True, axis='y', tight=True)

    ax1.text(1.3, 2.3, "encoding", color='black', alpha=0.8, fontsize=10, ha='center', clip_on=False)
    ax1.text(6.5+1.3, 2.3, "probe", color='black', alpha=0.8, fontsize=10, ha='center', clip_on=False)
    ax1.text(3+1.75, 2.3, "delay", color='black', alpha=0.8, fontsize=10, ha='center', clip_on=False)
    ax1.axhspan(2.25, 2.4, transform=ax1.transAxes, color='gray', alpha=0.15, clip_on=False)

    ax2.text(1.3, 2.3, "encoding", color='black', alpha=0.8, fontsize=10, ha='center', clip_on=False)
    ax2.text(6.5+1.3, 2.3, "probe", color='black', alpha=0.8, fontsize=10, ha='center', clip_on=False)
    ax2.text(3+1.75, 2.3, "delay", color='black', alpha=0.8, fontsize=10, ha='center', clip_on=False)
    ax2.axhspan(2.25, 2.4, transform=ax1.transAxes,  color='gray', alpha=0.15, clip_on=False)
    # Adding a title
    # plt.suptitle('Pupil dilation across conditions', y=1.15, fontsize = 20)
    # plt.title(f'Applied baseline {baseline}', y=1.25, color='blue', alpha=0.4)
    
    #Adding a legend
    plt.legend()
    ax1.legend(loc='lower right', fontsize=12)
    ax2.legend(loc='lower right', fontsize=12)


    # Save the figure
    name=f"pupil_high_vs_low_bias.png"
