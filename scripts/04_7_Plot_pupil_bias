# read evoked dataframe and associated significant results 
df = pd.read_csv('../data/csv_files/df.csv')
good_partis = df['subID'].unique()
mask_partis = df[df['mask']==1]['subID'].unique().tolist()
nomask_partis = df[df['mask']==0]['subID'].unique().tolist()

# evoked_df_pos1_interpol_shifted = pd.read_csv('../data/csv_files/evoked_df_pos1_interpol_shifted.csv')
# sig_results_pos1_interpol_shifted = pd.read_csv('../data/csv_files/sig_results_pos1_interpol_shifted.csv')

# # Participants with time issue
