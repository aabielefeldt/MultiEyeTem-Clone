##################################
#################################

# run a single subIDs epochs new and save seperately - try with and without blink interpolation
# do I need the custom mapping for my checks? - need subID..
# lets try without

# Trigger Dictionary
# these were set in the original experiment script, additional pairs were also set in the experiment except for "fixation", "saccade", and "BAD_blink". 
# Not sure if it is necessary to add them here because they are not relevant for what I am using the trigger_dict for 

n_objects = ['obj1', 'obj2', 'obj3']
n_positions = ['pos1', 'pos2', 'pos3']
n_orientations = [f'ori{i}' for i in range(1, 17)]

# Generate combinations of the three conditions
combinations = itertools.product(n_positions, n_objects, n_orientations)

# Create a dictionary to store the combinations
trigger_dict = {}

# Populate the dictionary with formatted combinations
for idx, combo in enumerate(combinations, start=1):
    trigger_dict['_'.join(combo)] = idx

additional_pairs = {
    "onset_concrete_cued_left": 220,
    "onset_concrete_cued_right": 221,
    "left_button_press": 241,
    "right_button_press": 242,
    "feedback_cued_item": 244,
    "mask": 245,
    "beginning/end_of_task": 246,
    "fixation": 247,
    "saccade": 248,
    "BAD_blink": 249
}

trigger_dict.update(additional_pairs)

# Extract values with "pos1" in the key, and key-value pairs
values_with_pos1 = [trigger_dict[key] for key in trigger_dict if "pos1" in key]
pos1_pairs = {key: trigger_dict[key] for key in trigger_dict if "pos1" in key}



# creating folder for epochs
datafolder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data"
folder_name = f"Epochs_single_to_try_out"
epochs_folderpath = os.path.join(datafolder_path, folder_name)
os.makedirs(epochs_folderpath, exist_ok=True)

for i in ['8H3YTN']:
        
        # read file per subID
        folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/data_eyelink"
        eyelink_file = folder_path + "/" + i + ".asc"
        raw = mne.io.read_raw_eyelink(eyelink_file)
        metadata_pp = df.loc[(df['subID'] == i)]

        # interpolate blinks
        # ran it with buffer 0.05 and 0.02 instead of 0.2 before
        # mne.preprocessing.eyetracking.interpolate_blinks(raw, buffer=[0.05, 0.2], match='BAD_blink', interpolate_gaze=False)
        
        # Create Custom Mapping to map annotations found to event ids that match the triggers used
        annotations = raw.annotations
        custom_mapping = {}
        # Generate mapping for annotations with integer descriptions
        max_id = 0
        for description in annotations.description:
            if description.isdigit():
                event_id = int(description)
                custom_mapping[description] = event_id
                if event_id > max_id:
                    max_id = event_id
        next_event_id = max_id + 1
        # Add non-numeric descriptions with unique event IDs
        for description in annotations.description:
            if not description.isdigit():
                if description not in custom_mapping:  # Ensure each description is only mapped once
                    custom_mapping[description] = next_event_id
                    next_event_id += 1
        sorted_custom_mapping = dict(sorted(custom_mapping.items(), key=lambda item: int(item[0]) if item[0].isdigit() else float('inf')))

        # Get events from annotations using the custom mapping 
        events_from_annot, event_dict = mne.events_from_annotations(
            raw, event_id=sorted_custom_mapping)

        # necessary events per participant - these are only those events that are also present in the event_id=pos1_pairs
        # this might be done better in the newest version of mne. 
        events_pos1 = events_from_annot[np.isin(events_from_annot, [values_with_pos1])[:, -1]]

        # Epoching
        # changed/ added event_repeated='error', since I don't fully understand what this does maybe better to not just merge events
        # on_missing='raise', nothing raised but maybe good to keep?
        # reject_by_annotation=True -> if blinks are interpolated no bad annotations are left and therefore nothing excluded
        pupil_epochs_pos1 = mne.Epochs(
            raw,
            events_pos1,
            event_id=pos1_pairs,
            tmin=-0.1,
            tmax=9,
            baseline=None,
            metadata=metadata_pp,
            picks=['pupil_left', 'pupil_right'],
            event_repeated='error',
            on_missing='raise',
            preload=True,
            reject_by_annotation=False
        )


        # Save epoch in fif format to a specified folder
        filename = f"{i}_single_try_out_blink_interpol.fif"
        epochs_path = os.path.join(epochs_folderpath, filename)
        pupil_epochs_pos1.save(epochs_path, overwrite=True, split_size='1.8GB', split_naming='bids', verbose=None)

# %%
epochs_single = pd.DataFrame()

for i in ['8H3YTN']:
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Epochs_single_to_try_out"
    epoch_file = folder_path + "/" + i + "_single_try_out_blink_interpol.fif"
    pupil_epoch = mne.read_epochs(epoch_file, preload=True, verbose=None)
    # pupil_epoch.plot()

    # combining channels
    pupil_ix = mne.pick_channels(pupil_epoch.info["ch_names"], include=['pupil_left', 'pupil_right'])
    roi_dict = dict(pupils=pupil_ix)
    pupil_epochs_combined = mne.channels.combine_channels(pupil_epoch, roi_dict, method="mean")

    epochs_df = pupil_epochs_combined.to_data_frame()
    epochs_df['subID'] = i
    # can I plot on top of each other without transforming to dataframe first?
    # there would have to be a way to use hue or something
    # pupil_epochs_combined[j].average().plot()

    epochs_single = pd.concat([epochs_single, epochs_df])


epochs_single = epochs_single.reset_index()
 # %%

data = epochs_single[epochs_single['epoch'].isin(range(430, 445))]

with sns.plotting_context(context='paper', font_scale=1.5): 
    fig, ax = plt.subplots(figsize=(10, 8))

# Plot, using a meaningful column for hue (if available, e.g., 'condition')
    sns.lineplot(data=data, x='time', y='pupils', hue='epoch', errorbar='se', ax=ax)

plt.title(f'SubID REUNMA - Epochs 430 - 445 ')
plt.show()
