# %%
# Newest epochs (uncombined)
# reading epochs and saving as dataframe without averaging to check for all trials per subID
# plot all trials per participant on top of each other to check 
# for individual trial outliers

epochs_all_uncombined_even_newer = pd.DataFrame()
for i in good_partis:
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Epochs_even_newer"
    epoch_file = folder_path + "/" + i + "_even_newer-epo.fif"
    pupil_epoch = mne.read_epochs(epoch_file, preload=True, verbose=None)

    epochs_df = pupil_epoch.to_data_frame()
    epochs_df['subID'] = i
    # can I plot on top of each other without transforming to dataframe first?
    # there would have to be a way to use hue or something
    # pupil_epochs_combined[j].average().plot()

    epochs_all_uncombined_even_newer = pd.concat([epochs_all_uncombined_even_newer, epochs_df])


epochs_all_uncombined_even_newer = epochs_all_uncombined_even_newer.reset_index()

# %%
# Newest epochs (combined)
# using nanmean!
# epochs all new with the newest epochs -> need nan mean to combine
epochs_all_combined_nan_even_newer = pd.DataFrame()
for i in good_partis:
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Epochs_even_newer"
    epoch_file = folder_path + "/" + i + "_even_newer-epo.fif"
    pupil_epoch = mne.read_epochs(epoch_file, preload=True, verbose=None)

    # combining channels
    pupil_ix = mne.pick_channels(pupil_epoch.info["ch_names"], include=['pupil_left', 'pupil_right'])
    roi_dict = dict(pupils=pupil_ix)
    combine_nanmean = lambda data: np.nanmean(data, axis=1)
    pupil_epochs_combined_nan = mne.channels.combine_channels(pupil_epoch, roi_dict, method=combine_nanmean)

    epochs_combined_nan_df = pupil_epochs_combined_nan.to_data_frame()
    epochs_combined_nan_df['subID'] = i
    # can I plot on top of each other without transforming to dataframe first?
    # there would have to be a way to use hue or something
    # pupil_epochs_combined[j].average().plot()

    epochs_all_combined_nan_even_newer = pd.concat([epochs_all_combined_nan_even_newer, epochs_combined_nan_df])

epochs_all_combined_nan_even_newer = epochs_all_combined_nan_even_newer.reset_index()


# %%
# plotting all trials per subID in a plt plot for uncombined pupils

# first with epochs_all_uncombined_new
# then with epochs_all_uncombined_even_newer

for i in good_partis: 
    data = epochs_all_uncombined_even_newer[epochs_all_uncombined_even_newer['subID'] == i]
    fig, axs = plt.subplots(1, 2, layout='constrained', figsize=(12, 5))

    epochs = data['epoch'].unique()
    for epoch in epochs:
        data_epoch = data[data['epoch'] == epoch]
        axs[0].plot(data_epoch['time'], data_epoch['pupil_left'], label='pupil_left', alpha=0.6)
    axs[0].set_xlabel('Time')
    axs[0].set_ylabel('Pupil Size')
    axs[0].set_title('Pupil Left with plt')

    for epoch in epochs:
        data_epoch = data[data['epoch'] == epoch]
        axs[1].plot(data_epoch['time'], data_epoch['pupil_right'], label='pupil_right', alpha=0.6)
    axs[1].set_title('Pupil Right with plt')
    axs[1].set_xlabel('Time')
    axs[1].set_ylabel('Pupil Size')

    plt.suptitle(f'lineplot of all epochs for one subID {i}')
    plt.show()



# %%
# plotting all trials per subID in a plt plot for combined pupils
for i in good_partis:
    data = epochs_all_combined_nan_even_newer[epochs_all_combined_nan_even_newer['subID'] == i]
    fig, ax = plt.subplots(figsize=(10, 8))

    epochs = data['epoch'].unique()
    for idx, epoch in enumerate(epochs):
            data_epoch = data[data['epoch'] == epoch]
            ax.plot(data_epoch['time'], data_epoch['pupils'], label='pupils', alpha=0.5)
    ax.set_title(f'SubID {i}')
    ax.set_xlabel('Time')
    ax.set_ylabel('Pupil Size')
    plt.title(f'lineplot of all epochs of combined pupils for one subID {i}')
    plt.show()

# %%
# improved plt plot for uncombined pupils
# looking at a couple of epochs at a time
# RP15M5, REUNMA

for p in ['GJL7U8']: # good_partis[1:2]
    for i in range(220, 240, 20): #(10, 590, 10) -> for starting at 10 up to 590 in steps of 10
