# %% Load Metadata

df = pd.read_csv('../data/csv_files/df.csv')
good_partis = df['subID'].unique()

evoked_df_pos1_interpol_shifted = pd.read_csv('../data/csv_files/evoked_df_pos1_interpol_shifted.csv')


#%%
# if qt is used as backend the kernel crashes
mne.viz.set_browser_backend('matplotlib')

# %%
# creating evokeds without baseline and no seperation by load
ave_df_all = pd.DataFrame()

for i in good_partis:
    
    # reading epochs per participant
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Epochs_pos1"
    epoch_file = folder_path + "/" + i + "_pos1_interpol-epo.fif"
    pupil_epoch = mne.read_epochs(epoch_file, preload=True, verbose=None)
    # pupil_epoch.plot()

    # combining channels
    pupil_ix = mne.pick_channels(pupil_epoch.info["ch_names"], include=['pupil_left', 'pupil_right'])
    roi_dict = dict(pupils=pupil_ix)
    pupil_epochs_combined = mne.channels.combine_channels(pupil_epoch, roi_dict, method="mean")

    # averaging 
    ave = pupil_epochs_combined.average()

    # adding individual averaged data to dataframe including load and subID
    ave_df = ave.to_data_frame()
    ave_df['subID'] = i

    # concatenating to evoked_df_pos1_interpol
    ave_df_all = pd.concat([ave_df_all, ave_df])


ave_df_all = ave_df_all.reset_index()

ave_df_all.to_csv('../data/csv_files/ave_df_all.csv', index=False)
#pupil_df = pupil_epoch.to_data_frame()

#sns.lineplot(data=pupil_epoch, x='time', y='pupils', hue='subID')
# %%
# plot all participants averaged timelines on top of each other
# plot before baseline, seems like there are no outliers
with sns.plotting_context(context='paper', font_scale=1.5): 
    
    fig, ax = plt.subplots(figsize=(10,8))

    sns.lineplot(data=ave_df_all, x='time', y='pupils', hue='subID', errorbar='se', ax=ax)
plt.show()




