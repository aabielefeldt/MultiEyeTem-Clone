loads = [1, 2, 3]
for i in loads:
    with sns.plotting_context(context='paper', font_scale=1.5): 
    
        fig, ax = plt.subplots(figsize=(10,8))

        sns.lineplot(data=evoked_df_pos1_interpol_shifted[evoked_df_pos1_interpol_shifted['Load']==i], x='time', y='pupils', hue='subID', errorbar='se', ax=ax)
plt.show()
