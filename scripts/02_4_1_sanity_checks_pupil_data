# comparing seaborn plots (right and left eye) with matplotlib plot (right and left eye)

for i in good_partis[0:6]:
        
    data = epochs_all[epochs_all['subID']==i]

    fig, axs = plt.subplots(2, 2, layout='constrained', figsize=(12, 10))

    sns.lineplot(data=data, x='time', y='pupil_right', hue='epoch', errorbar='se', ax=axs[0, 0])
    axs[0, 0].set_title('Pupil Right with seaborn')
    axs[0, 0].set_xlabel('Time')
    axs[0, 0].set_ylabel('Pupil Size')
    sns.lineplot(data=data, x='time', y='pupil_left', hue='epoch', errorbar='se', ax=axs[0,1])
    axs[0, 1].set_title('Pupil Left with seaborn')
    axs[0, 1].set_xlabel('Time')
    axs[0, 1].set_ylabel('Pupil Size')

    epochs = data['epoch'].unique()
    for epoch in epochs:
        data_epoch = data[data['epoch'] == epoch]
        axs[1, 0].plot(data_epoch['time'], data_epoch['pupil_right'], alpha=0.5)
    axs[1, 0].set_title('Pupil Right raw by Epoch')
    axs[1, 0].set_xlabel('Time')
    axs[1, 0].set_ylabel('Pupil Size')

    epochs = data['epoch'].unique()
    # Bottom-right: pupil_left raw lines for each epoch (no error bars)
    for epoch in epochs:
        data_epoch = data[data['epoch'] == epoch]
        axs[1, 1].plot(data_epoch['time'], data_epoch['pupil_left'], alpha=0.5)
    axs[1, 1].set_title('Pupil Left raw by Epoch')
    axs[1, 1].set_xlabel('Time')
    axs[1, 1].set_ylabel('Pupil Size')
    
    fig.suptitle(f'SubID {i}', fontsize=16)
    plt.show()

