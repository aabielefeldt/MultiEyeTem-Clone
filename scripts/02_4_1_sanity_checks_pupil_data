# %%
######################

# Plotting pupil trace section and associated smoothed pupil trace and associated velocity plot

# === Parameters ===
ch_name = 'pupil_right'
sigma = 4  # Gaussian smoothing factor
t_start = 890
t_end = t_start + 20  # seconds

# === Get data and smooth ===
data = raw_8H3YTN.copy().pick(ch_name).get_data()[0]
times = raw_8H3YTN.times
sfreq = raw_8H3YTN.info['sfreq']

# Smooth the data
smoothed = gaussian_filter1d(data, sigma=sigma)

# Compute velocity (derivative of smoothed data)
velocity = np.gradient(smoothed) * sfreq
velocity_smoothed = gaussian_filter1d(velocity, sigma=3)

# === Crop to time window ===
mask = (times >= t_start) & (times <= t_end)
times_crop = times[mask]
data_crop = data[mask]
smoothed_crop = smoothed[mask]
velocity_crop = velocity_smoothed[mask]

# === Plot ===
fig, axs = plt.subplots(2, 1, figsize=(12, 6), sharex=True, gridspec_kw={'height_ratios': [2, 1]})

# Pupil trace
axs[0].plot(times_crop, data_crop, label='Raw Pupil Data', alpha=0.4, color='gray')
axs[0].plot(times_crop, smoothed_crop, label=f'Smoothed (σ={sigma})', color='blue')
axs[0].set_ylabel('Pupil Size')
axs[0].legend()
axs[0].grid(True)
axs[0].set_title(f'{ch_name} — Pupil Trace and Velocity (Time: {t_start}-{t_end}s)')

# Velocity trace
axs[1].plot(times_crop, velocity_crop, label='Smoothed Velocity', color='green')
axs[1].axhline(0, color='black', linestyle='--', linewidth=0.8)
axs[1].set_xlabel('Time (s)')
axs[1].set_ylabel('Velocity')
axs[1].legend()
axs[1].grid(True)

plt.tight_layout()
plt.show()






