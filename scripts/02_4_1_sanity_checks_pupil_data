# %%
# making annotated raws - loading raws from raw_cache annotating and saving in folder
# this takes 32 minutes for 10 participants :(

save_dir = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/raw_cache/raw_annots"
raw_cache_annot = {}
velocity_percentile = 99.5
for i in good_partis[0:10]:
        
    raw = raw_cache[i]

    raw_copy = raw.copy()
    
    raw_copy_annot = annotate_velocity_blinks(
        raw_copy,
        channel_names=('pupil_left', 'pupil_right'),
        velocity_percentile=99.5,
        margin_before=0.01,
        margin_after=0.01,
        max_duration=0.5,
        description='BAD_velo_blink',
        sfreq=None,
        sigma=4)
    save_path = os.path.join(save_dir, f"{i}_annot_raw.fif")
    raw_copy_annot.save(save_path, overwrite=True)
    
    raw_cache_annot[i] = raw_copy_annot


# %%
# renaming and merging annotations of consecutive blinks
save_dir = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/raw_cache/raw_annots"
raw_cache_renamed = {}
for i in good_partis[0:10]:
        
    raw = raw_cache_annot[i]

    raw_copy2 = raw.copy()

    raw_copy_renamed = merge_and_rename_annotations(
        raw_copy2,
        match=["BAD_velo_blink"],
        min_gap_sec=0.1,
        new_description="BAD_merged_blink",
        rename_original_to="blink_used_for_merged",
        channel_names=['pupil_right', 'pupil_left']
    )
    save_path = os.path.join(save_dir, f"{i}_annots_renamed_raw.fif")
    raw_copy_renamed.save(save_path, overwrite=True)
    
    raw_cache_renamed[i] = raw_copy_renamed
# %%
# interpolating from raw_cache and saving in folder
raw_cache_interpol = {}
save_dir = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/raw_cache/raw_interpols"
for i in good_partis[0:10]:
        
    raw = raw_cache_renamed[i]

    raw_copy = raw.copy()
    raw_copy_interpol = interpolate_blinks(raw_copy, buffer=[0.05, 0.05], match=["BAD_velo_blink", 'BAD_merged_blink'], interpolate_gaze=False, method="MonotonicCubicSpline")

    raw_cache_interpol[i] = raw_copy_interpol
    save_path = os.path.join(save_dir, f"{i}_interpol_merged_and_velo_raw.fif")
    raw_copy_interpol.save(save_path, overwrite=True)

#%%
# removing missing data

raw_cache_removed_missing = {}
save_dir = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/raw_cache/raw_removed_missing"
os.makedirs(save_dir, exist_ok=True)
for i in good_partis[0:10]:
        
    raw = raw_cache_interpol[i]

    raw_copy4 = raw.copy()
    raw_copy_removed = remove_missing_data(raw_copy4, channel_names=('pupil_left', 'pupil_right'), buffer=[0.15, 0.15])

    nan_annot = mne.preprocessing.annotate_nan(raw_copy_removed)
    raw_copy_removed.set_annotations(raw_copy_removed.annotations + nan_annot)
    raw_cache_removed_missing[i] = raw_copy_removed

    save_path = os.path.join(save_dir, f"{i}_removed_missing0.15_raw.fif")
    raw_copy_removed.save(save_path, overwrite=True)



