#%%
channel = 'pupil_left'
exclude_labels = ['saccade', 'fixation', 'BAD_blink', 'blink_used_for_merged'] # 'BAD_merged_blink', , 'BAD_velo_blink'

raw_to_use = raw_copy_annot.copy()

# Filter annotations for the specific channel and not excluded
ch_specific_annots = [
    ann for ann in raw_to_use.annotations
    if (
        (ann['ch_names'] is not None and channel in ann['ch_names']) and
        (ann['description'] not in exclude_labels)
    )
]

# Create new Annotations object
filtered_annot = mne.Annotations(
    onset=[a['onset'] for a in ch_specific_annots],
    duration=[a['duration'] for a in ch_specific_annots],
    description=[a['description'] for a in ch_specific_annots],
    orig_time=raw_to_use.annotations.orig_time,
    ch_names=[a['ch_names'] for a in ch_specific_annots]
)
tmin = 5790
tmax = tmin + 20
# Crop and apply annotations
raw_copy_plot = raw_to_use.copy().crop(tmin=tmin, tmax=tmax)
raw_copy_plot.set_annotations(filtered_annot)

# Plot
raw_copy_plot.plot(
    scalings=1e3,
    duration=1000.1,
    picks=[channel],
    title=f"Annotations for {channel} (excluding saccades/fixation)"
)

