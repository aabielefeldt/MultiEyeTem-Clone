# plot before baseline, seems like there are no outliers
with sns.plotting_context(context='paper', font_scale=1.5): 
    
    fig, ax = plt.subplots(figsize=(10,8))

    sns.lineplot(data=ave_df_all, x='time', y='pupils', hue='subID', errorbar='se', ax=ax)
plt.show()




