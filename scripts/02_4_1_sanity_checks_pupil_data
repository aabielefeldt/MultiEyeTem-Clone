raw_copy.plot(events=events_pos1, event_id=trigger_dict, scalings=1e3, show=False, show_options=True, duration=90.1, picks= ['pupil_left', 'pupil_right'])

# %%
# figureing out when an epoch happened to check that time out in the raw

epoch_index = 392

# Get the sample index of the event that triggered this epoch
event_sample = pupil_epoch.events[epoch_index, 0]

# Convert sample index to time in seconds
epoch_time = event_sample / raw.info['sfreq']

print(f"Epoch {epoch_index} starts at {epoch_time:.3f} seconds in raw data.")
# %%
raw_copy2 = raw.copy()
raw_copy2.crop(tmin=epoch_time-1, tmax=epoch_time+90)
# Filter annotations: keep only those with description "bad blink"
blink_annot = raw.annotations[raw.annotations.description == "BAD_blink"]

# Assign filtered annotations to the copied raw object
raw_copy2.set_annotations(blink_annot)
raw_copy2.plot(events=events_pos1, event_id=trigger_dict, scalings=1e3, show=False, show_options=True, duration=90, picks= ['pupil_left', 'pupil_right']) 

