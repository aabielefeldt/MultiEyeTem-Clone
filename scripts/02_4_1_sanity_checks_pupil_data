pupil_epoch.plot(n_epochs=4, events=True, scalings=1e3, event_id=trigger_dict)


# %%

data, times = raw['pupil_right']

plt.plot(times, data.T, label='pupils')

# Add blink annotation spans
for onset, duration, description in zip(raw.annotations.onset,
                                        raw.annotations.duration,
                                        raw.annotations.description):
    if description == 'BAD_blink':
        plt.axvspan(onset, onset + duration, color='red', alpha=0.3)

plt.xlabel('Time (s)')
plt.ylabel('Amplitude')
plt.title('EOG Signal with BAD_blink Annotations')
plt.legend()
plt.show()






