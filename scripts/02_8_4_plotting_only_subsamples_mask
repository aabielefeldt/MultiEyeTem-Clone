# %%
# Importsconda
import mne
import numpy as np
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

# %% 
# read evoked dataframe and associated significant results 
df = pd.read_csv('../data/csv_files/df.csv')
good_partis = df['subID'].unique()
mask_partis = df[df['mask']==1]['subID'].unique().tolist()
nomask_partis = df[df['mask']==0]['subID'].unique().tolist()

evoked_df_pos1_interpol_shifted = pd.read_csv('../data/csv_files/evoked_df_pos1_interpol_shifted.csv')
sig_results_pos1_interpol_shifted = pd.read_csv('../data/csv_files/sig_results_pos1_interpol_shifted.csv')

# Participants with time issue
issue_partis = ['REUNMA', '1UVQEK', '35T018', '4A2K27', '30K8XE', 'R8CW7K']

no_time_partis = good_partis[~np.isin(good_partis, issue_partis)].tolist()



# %%
# Subsample of only participants without time issue
evoked_df_no_time_partis_shifted = pd.read_csv('../data/csv_files/evoked_df_no_time_partis_shifted.csv')

# %% 

with sns.plotting_context(context='paper', font_scale=1.5): 
    
    # fig, ax = plt.subplots(figsize=(10,8))

    # #sns.lineplot(data=evoked_df_pos1_interpol_shifted[evoked_df_pos1_interpol_shifted['subID'].isin(no_time_partis)], hue='Load', palette='crest', x='time', y='pupils',  errorbar='se', ax=ax, legend='full') 
    # sns.lineplot(data=evoked_df_pos1_interpol_shifted[evoked_df_pos1_interpol_shifted['subID'].isin(mask_partis)], hue='Load', palette='crest', x='time', y='pupils',  errorbar='se', ax=ax, legend='full') 
    # sns.lineplot(data=evoked_df_pos1_interpol_shifted[evoked_df_pos1_interpol_shifted['subID'].isin(nomask_partis)], hue='Load',x='time', y='pupils', errorbar='se', ax=ax)
    # sns.despine(fig=fig, ax=None, top=True, right=True, left=False, bottom=False, offset=None, trim=False)
    
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 8), sharey=True)

    # Plot for participants WITH mask (Left Plot)
    sns.lineplot(
        data=evoked_df_pos1_interpol_shifted[evoked_df_pos1_interpol_shifted['subID'].isin(mask_partis)], 
        hue='Load', palette='crest', x='time', y='pupils',  
        errorbar='se', ax=ax1,
    )
    ax1.set_title('Masked Participants', y=1.2, fontsize=16)
    sns.despine(ax=ax1)

    ax1.axvline(0, color='black', alpha=0.33)
    ax1.axvline(1, color='black', alpha=0.66)
    ax1.axvline(2, color='black')  
    ax1.axvline(3, color='darkblue')  
    ax1.axvline(6.5, color='blue')  

    # Define y-coordinate for labels (as a fraction of the plot height)
    label_y = 1.05

    # Add labels above the vertical lines
    ax1.text(0, ax1.get_ylim()[1] * label_y, "object position 1", color='black', alpha=0.33, fontsize=10, ha='center', rotation=45)
    ax1.text(1, ax1.get_ylim()[1] * label_y, "object position 2", color='black', alpha=0.66, fontsize=10, ha='center', rotation=45)
    ax1.text(2, ax1.get_ylim()[1] * label_y, "object position 3", color='black', fontsize=10, ha='center', rotation=45)
    ax1.text(3, ax1.get_ylim()[1] * label_y, "onset delay", color='darkblue', fontsize=10, ha='center', rotation=45)
    ax1.text(6.5, ax1.get_ylim()[1] * label_y, "onset probe object", color='blue', fontsize=10, ha='center', rotation=45)


    # Plot for participants WITHOUT mask (Right Plot)
    sns.lineplot(
        data=evoked_df_pos1_interpol_shifted[evoked_df_pos1_interpol_shifted['subID'].isin(nomask_partis)], 
        hue='Load', x='time', y='pupils', 
        errorbar='se', ax=ax2, legend='full'
    )
    ax2.set_title('Non-Masked Participants', y=1.2, fontsize=16)
    sns.despine(ax=ax2)

    ax2.axvline(0, color='black', alpha=0.33)
    ax2.axvline(1, color='black', alpha=0.66)
    ax2.axvline(2, color='black')  
    ax2.axvline(3, color='darkblue')  
    ax2.axvline(6.5, color='blue')  

    # Define y-coordinate for labels (as a fraction of the plot height)
    label_y = 1.05

    # Add labels above the vertical lines
    ax2.text(0, ax2.get_ylim()[1] * label_y, "object position 1", color='black', alpha=0.33, fontsize=10, ha='center', rotation=45)
    ax2.text(1, ax2.get_ylim()[1] * label_y, "object position 2", color='black', alpha=0.66, fontsize=10, ha='center', rotation=45)
    ax2.text(2, ax2.get_ylim()[1] * label_y, "object position 3", color='black', fontsize=10, ha='center', rotation=45)
    ax2.text(3, ax2.get_ylim()[1] * label_y, "onset delay", color='darkblue', fontsize=10, ha='center', rotation=45)
    ax2.text(6.5, ax2.get_ylim()[1] * label_y, "onset probe object", color='blue', fontsize=10, ha='center', rotation=45)


    # Highlighting the baseline window
    baseline = (evoked_df_pos1_interpol_shifted.at[0, 'baseline_start'], evoked_df_pos1_interpol_shifted.at[0, 'baseline_end'])
    baseline_str = '_'.join(map(str, baseline))
    # Include window that was used for the baseline
    # maybe remove here because misleading with shifted data
    # ax.axvspan(baseline[0], baseline[1], ymin=0, ymax=1, color='blue', alpha=0.4)

    # Set x-axis to show all whole numbers within range
    x_ticks = np.arange(int(evoked_df_pos1_interpol_shifted['time'].min()), int(evoked_df_pos1_interpol_shifted['time'].max()) + 1, 1)
    ax2.set_xticks(x_ticks)
    ax2.set_xticklabels(x_ticks)

    # Increase font size of x and y tick labels
    ax2.tick_params(axis='x', labelsize=14)
    ax2.tick_params(axis='y', labelsize=14)

    # Adding a title
    plt.suptitle('Pupil dilation across conditions', y=1.15, fontsize = 20)
    # plt.title(f'Applied baseline {baseline}', y=1.25, color='blue', alpha=0.4)
    
    #Adding a legend
    ax1.legend(loc='lower right', fontsize=12)
    ax2.legend(loc='lower right', fontsize=12)


    # Save the figure
    name=f"pupil_fig_pos1_interpol_shifted_bl{baseline_str}_mask_vs_nomask2.png"
    figures_folder = '/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/figures'
    figure_filepath = os.path.join(figures_folder, name)

    plt.savefig(figure_filepath, bbox_inches = 'tight')
