# %%
# Importsconda
import mne
import numpy as np
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

# %% Load Metadata

df = pd.read_csv('../data/csv_files/df.csv')
good_partis = df['subID'].unique()

# %%
# if qt is used as backend the kernel crashes
mne.viz.set_browser_backend('matplotlib')

# %%
# appending all epochs into one list while:
# combining both pupil channels
# applying baseline
# seperating by condition
# cropping according to condition
# averaging epochs


evoked_df_only_correct = pd.DataFrame()

for i in ["Z16JQR"]:
    
    # reading epochs per participant
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Epochs_pos1"
    epoch_file = folder_path + "/" + i + "_pos1_interpol-epo.fif"
    pupil_epoch = mne.read_epochs(epoch_file, preload=True, verbose=None)
    
    # combining channels
    pupil_ix = mne.pick_channels(pupil_epoch.info["ch_names"], include=['pupil_left', 'pupil_right'])
    roi_dict = dict(pupils=pupil_ix)
    pupil_epochs_combined = mne.channels.combine_channels(pupil_epoch, roi_dict, method="mean")

    # applying baseline
    # pupil_epochs_combined_bl = pupil_epochs_combined.apply_baseline(baseline=(-0.1, 0))
    # baseline = pupil_epochs_combined.baseline

    # only using correct trials
    # pupil_epochs_correct = pupil_epochs_combined_bl['acc_trial_concrete_cued==1']

    # seperating per load condition
    #con1_epochs_pos1 = pupil_epochs_combined_bl["items_presented == 1"]
    #con1_epochs_correct = con1_epochs_pos1['acc_trial_concrete_cued==1']
    #con2_epochs_pos1 = pupil_epochs_combined_bl["items_presented == 2"]
    #con2_epochs_correct = con2_epochs_pos1['acc_trial_concrete_cued==1']
    #con3_epochs_pos1 = pupil_epochs_combined_bl["items_presented == 3"]
    #con3_epochs_correct = con3_epochs_pos1['acc_trial_concrete_cued==1']

    pupil_epoch_correct = pupil_epochs_combined['acc_trial_concrete_cued==0']

    # shortening the epochs based on condition (crop defaults to inclduing tmax)
    # con1_epochs_correct.crop(-0.1, 7)
    # con2_epochs_correct.crop(-0.1, 8)
    # con3_epochs_correct.crop(-0.1, 9)

    # averaging per load condition
    pupil_epoch_correct_ave = pupil_epoch_correct.average()
    # con2_ave_pos1 = con2_epochs_correct.average()
    # con3_ave_pos1 = con3_epochs_correct.average()

    # adding individual averaged data to dataframe including load and subID
    # con1_ave_df_pos1 = con1_ave_pos1.to_data_frame()
    # con1_ave_df_pos1['Load'] = 1
    # con1_ave_df_pos1['subID'] = i
    # con2_ave_df_pos1 = con2_ave_pos1.to_data_frame()
    # con2_ave_df_pos1['Load'] = 2
    # con2_ave_df_pos1['subID'] = i
    # con3_ave_df_pos1 = con3_ave_pos1.to_data_frame()
    # con3_ave_df_pos1['Load'] = 3
    # con3_ave_df_pos1['subID'] = i

    pupil_epoch_correct_ave_df = pupil_epoch_correct_ave.to_data_frame()

    # concatenating to evoked_df_only_correct
    # evoked_df_only_correct = pd.concat([evoked_df_only_correct, con1_ave_df_pos1])
    # evoked_df_only_correct = pd.concat([evoked_df_only_correct, con2_ave_df_pos1])
    # evoked_df_only_correct = pd.concat([evoked_df_only_correct, con3_ave_df_pos1])
    # evoked_df_only_correct['baseline_start'] = baseline[0]
    # evoked_df_only_correct['baseline_end'] = baseline[1]

pupil_epoch_correct_ave_df = pupil_epoch_correct_ave_df.reset_index()
display(pupil_epoch_correct_ave_df)
# evoked_df_only_correct.to_csv('../data/csv_files/evoked_df_only_correct.csv', index=False)

# %%
# Shifting

# shifting the conditions so that the epochs that are epoched on pos1 are time-locked to the test onset
evoked_df_only_correct_shifted = evoked_df_only_correct.copy()
evoked_df_only_correct_shifted.loc[evoked_df_only_correct_shifted['Load']==1, 'time'] +=2
evoked_df_only_correct_shifted.loc[evoked_df_only_correct_shifted['Load']==2, 'time'] +=1
evoked_df_only_correct_shifted.loc[evoked_df_only_correct_shifted['Load']==3, 'time'] +=0

evoked_df_only_correct_shifted.to_csv('../data/csv_files/evoked_df_only_correct_shifted.csv', index=False)

# %%
# Shifting

# shifting the conditions so that the epochs that are epoched on pos1 are time-locked to the test onset
evoked_df_no_time_partis_shifted = evoked_df_no_time_partis.copy()
evoked_df_no_time_partis_shifted.loc[evoked_df_no_time_partis_shifted['Load']==1, 'time'] +=2
evoked_df_no_time_partis_shifted.loc[evoked_df_no_time_partis_shifted['Load']==2, 'time'] +=1
evoked_df_no_time_partis_shifted.loc[evoked_df_no_time_partis_shifted['Load']==3, 'time'] +=0

evoked_df_no_time_partis_shifted.to_csv('../data/csv_files/evoked_df_no_time_partis_shifted.csv', index=False)
