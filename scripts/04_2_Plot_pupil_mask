import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# --------------------------------------------------
# custom layout:
# top row = 3 polar plots
# bottom row = 2 normal plots spanning full width
# --------------------------------------------------
def create_mixed_grid_3top_2bottom(style=PLOT_STYLE):
    fig_width = style["fig_width"]
    fig_height = compute_figure_height(nrows=2, style=style)

    fig = plt.figure(figsize=(fig_width, fig_height))

    left = style["left"]
    right = style["right"]
    bottom = style["bottom"]
    top = style["top"]
    wspace = style["wspace"]
    hspace = style["hspace"]

    usable_w = right - left
    usable_h = top - bottom

    row_h = (usable_h - hspace) / 2

    # top row: 3 columns
    top_w = (usable_w - 2 * wspace) / 3

    # bottom row: 2 columns spanning the same full width
    bottom_w = (usable_w - wspace) / 2

    y_top = top - row_h
    y_bottom = bottom

    axes = {}

    # top row
    for c in range(3):
        x0 = left + c * (top_w + wspace)
        axes[f"top_{c}"] = fig.add_axes([x0, y_top, top_w, row_h], projection="polar")

    # bottom row
    axes["bottom_0"] = fig.add_axes([left, y_bottom, bottom_w, row_h])
    axes["bottom_1"] = fig.add_axes([left + bottom_w + wspace, y_bottom, bottom_w, row_h])

    return fig, axes


# --------------------------------------------------
# main combined figure
# --------------------------------------------------
df = pd.read_csv('../data/csv_files/df.csv')
emms = pd.read_csv('../data/csv_files/emms.csv')

