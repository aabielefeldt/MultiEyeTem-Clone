    bar_base = ymin + 0.04 * y_range
    bar_step = 0.04 * y_range

    # draw one row per contrast
    for i, (_, row) in enumerate(sig_clusters.iterrows()):
        start = row['start_time']
        end = row['end_time']
        pval = row['p_value']

        ymin, ymax = ax.get_ylim()
