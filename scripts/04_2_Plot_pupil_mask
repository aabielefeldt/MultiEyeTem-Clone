# %%
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from matplotlib.lines import Line2D

# --------------------------------------------------
# data prep
# --------------------------------------------------
evoked_df_button_press = pd.read_csv('../data/csv_files/evoked_df_button_press.csv')
evoked_df_button_press["time"] = evoked_df_button_press["time"].round(3)

delay_start, delay_end = 3.0, 6.5
is_delay = evoked_df_button_press["time"].between(delay_start, delay_end, inclusive="both")

def delay_zscore_apply_all(g):
    delay_vals = g.loc[is_delay.loc[g.index], "pupils"].to_numpy()
    mu = np.nanmean(delay_vals)
    sd = np.nanstd(delay_vals, ddof=0)

    if not np.isfinite(sd) or sd == 0:
        return pd.Series(np.nan, index=g.index)

    return (g["pupils"] - mu) / sd

evoked_df_button_press["pupils_z_delay"] = (
    evoked_df_button_press
    .groupby("subID", group_keys=False)
    .apply(delay_zscore_apply_all)
)

df_cardinal_bias_acc = (
    df.groupby(['subID', 'dist_probe_to_cardinal'])['acc_trial_concrete_cued']
      .mean()
      .reset_index()
      .sort_values('dist_probe_to_cardinal')
)

df_cardinal_bias_acc_piv = (
    df_cardinal_bias_acc
    .pivot(index='subID', columns='dist_probe_to_cardinal', values='acc_trial_concrete_cued')
    .reset_index()
)

df_cardinal_bias_acc_piv['diff_card'] = df_cardinal_bias_acc_piv[3.25] - df_cardinal_bias_acc_piv[19.25]
diff_card_med = df_cardinal_bias_acc_piv['diff_card'].median()

diff_card_med_high = df_cardinal_bias_acc_piv[df_cardinal_bias_acc_piv['diff_card'] >= diff_card_med]['subID']
diff_card_med_low = df_cardinal_bias_acc_piv[df_cardinal_bias_acc_piv['diff_card'] < diff_card_med]['subID']

evoked_df_button_press['group'] = np.where(
    evoked_df_button_press['subID'].isin(diff_card_med_high), 'high', 'low'
)

evoked_df_button_press['bp_away'] = evoked_df_button_press['pressed_away_from_cardinal']
evoked_df_button_press['Load'] = evoked_df_button_press['items_presented']

sig_clusters_bias = pd.read_csv('../data/csv_files/cluster_results_bp_groups_load.csv')
sig_clusters_bias = sig_clusters_bias[sig_clusters_bias['p_value'] < 0.05]
sig_clusters_bias['group']='low'
delay_time_window = evoked_df_button_press[
    evoked_df_button_press['time'].between(delay_start, delay_end, inclusive='both')
].copy()

delay_time_window['bp_label'] = delay_time_window['bp_away'].map({
    0: 'towards',
    1: 'away'
})

# --------------------------------------------------
# plotting
# --------------------------------------------------
set_global_plot_style()

colors_load = sns.color_palette("flare", 3)
groups = ['high', 'low']                       # rows
items_levels = sorted(delay_time_window['items_presented'].unique())   # cols

# 2 rows x 3 columns
fig, axes = create_fixed_grid(nrows=2, ncols=3, sharex=True, sharey=True)

x_min = delay_time_window['time'].min()
x_max = delay_time_window['time'].max()

# choose common y ticks if you want fixed ones
y_ticks = np.arange(-1.0, 1.51, 0.5)
x_ticks = half_step_ticks(x_min, x_max, 0.5)

for row, group in enumerate(groups):
    for col, item in enumerate(items_levels):
        ax = axes[row, col]

        data_sub = delay_time_window[
            (delay_time_window['group'] == group) &
            (delay_time_window['items_presented'] == item)
        ]

        sns.lineplot(
            data=data_sub,
            x='time',
            y='pupils_z_delay',
            style='bp_label',
            style_order=['towards', 'away'],
            errorbar='se',
            color=colors_load[col],
            ax=ax
        )


        # titles on top row only
        title = f"Set size {item}" if row == 0 else None

        # y-label only on first col
        ylabel = 'pupil size (z-scored)' if col == 0 else ''

        # x-label only on bottom row
        xlabel = 'time (s)' if row == len(groups) - 1 else ''
        y_lim = (-1.0, 1.5)
        standardize_axis(
            ax,
            xlim=(x_min, x_max),
            ylim=y_lim,
            xticks=x_ticks,
            yticks=y_ticks,
            xlabel=xlabel,
            ylabel=ylabel,
            title=title,
            hide_left_labels=(col != 0),
            hide_bottom_labels=(row != len(groups) - 1),
            style=PLOT_STYLE
        )
        # optional significance bar if your cluster file has matching columns
        # adapt column names here if needed


        add_top_band(ax, text='delay', style=PLOT_STYLE)

        # remove seaborn auto-legend from each panel
        leg = ax.get_legend()
        if leg is not None:
            leg.remove()

        # row labels on the far left
        if col == 0:
            ax.annotate(
                f'{group} bias group',
                xy=(-0.4, 0.5),
                xycoords='axes fraction',
                ha='center',
                va='center',
                rotation=90,
                fontsize=PLOT_STYLE["title_size"]
            )
        cluster_sub = sig_clusters_bias[
            (sig_clusters_bias['group'] == group) &
            (sig_clusters_bias['load'] == item)
        ]

        for _, row_cluster in cluster_sub.iterrows():
            add_cluster_bar(
                ax,
                start=row_cluster['start_time'],
                end=row_cluster['end_time'],
                label=f"p = {row_cluster['p_value']:.3f}",
                style=PLOT_STYLE
            )
# shared legend
legend_handles = [
    Line2D([0], [0], color='black', lw=2, linestyle='-'),
    Line2D([0], [0], color='black', lw=2, linestyle='--')
]
legend_labels = ['towards', 'away']
left = axes[0, 0].get_position().x0
right = axes[0, -1].get_position().x1
center = (left + right) / 2
top = max(axes[0, i].get_position().y1 for i in range(len(items_levels)))
bottom = min(axes[1, i].get_position().y0 for i in range(len(items_levels)))
vcenter = (top + bottom) / 2
fig.legend(
    legend_handles,
    legend_labels,
    title='button press direction',
    loc='center',
    bbox_to_anchor=(center, vcenter),
    ncol=2,
    frameon=True
)
add_panel_labels(fig, axes)
plt.show()

# Save the figure
name=f"pupil_bias_new_fixed_settings.png"
figures_folder = '/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/figures'
figure_filepath = os.path.join(figures_folder, name)

save_figure(fig, figure_filepath)

