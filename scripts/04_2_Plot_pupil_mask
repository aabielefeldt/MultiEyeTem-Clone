# trying to get them to fucking align


import os
import math
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from matplotlib.lines import Line2D

# =========================================================
# GLOBAL STYLE / LAYOUT SETTINGS
# =========================================================

A4_SHORT_IN = 8.27   # short side of A4 in inches
A4_LONG_IN = 11.69   # long side of A4 in inches

PLOT_STYLE = {
    # figure / axes geometry
    "fig_width": A4_SHORT_IN,      # always span short side of A4
    "panel_height": 2.6,           # fixed height in inches for one row of plots

    # fixed axes rectangle in figure coordinates
    # these control where the plotting region starts/ends
    "left": 0.14,
    "right": 0.98,
    "bottom": 0.07,
    "top": 0.90,
    "wspace": 0.06,
    "hspace": 0.12,

    # fonts
    "font_scale": 1.0,
    "title_size": 10,
    "label_size": 9,
    "tick_size": 8,
    "legend_size": 8,
    "legend_title_size": 9,
    "annotation_size": 8,

    # top band
    "top_band_frac": 0.07,         # upper 7% of axes
    "top_band_color": "gray",
    "top_band_alpha": 0.15,

    # export
    "dpi": 300,
}


# =========================================================
# GLOBAL RC PARAMS
# =========================================================

def set_global_plot_style(style=PLOT_STYLE):
    """Set consistent fonts and base matplotlib/seaborn style."""
    sns.set_theme(style="ticks", context="paper")
    plt.rcParams.update({
        "font.size": style["tick_size"],
        "axes.titlesize": style["title_size"],
        "axes.labelsize": style["label_size"],
        "xtick.labelsize": style["tick_size"],
        "ytick.labelsize": style["tick_size"],
        "legend.fontsize": style["legend_size"],
        "legend.title_fontsize": style["legend_title_size"],
        "figure.dpi": style["dpi"],
        "savefig.dpi": style["dpi"],
    })


# =========================================================
# FIGURE HEIGHT CALCULATION
# =========================================================

def compute_figure_height(
    nrows=1,
    panel_height=None,
    top=None,
    bottom=None,
    hspace=None,
    style=PLOT_STYLE
):
    """
    Compute figure height so each panel has identical fixed height.

    panel_height is in inches.
    """
    if panel_height is None:
        panel_height = style["panel_height"]
    if top is None:
        top = style["top"]
    if bottom is None:
        bottom = style["bottom"]
    if hspace is None:
        hspace = style["hspace"]

    usable_frac = top - bottom
    total_panel_height = nrows * panel_height
    total_hspace_in = (nrows - 1) * (hspace * panel_height)

    fig_height = (total_panel_height + total_hspace_in) / usable_frac
    return fig_height


# =========================================================
# FIXED AXES CREATION
# =========================================================

def create_fixed_grid(
    nrows=1,
    ncols=1,
    sharex=False,
    sharey=False,
    style=PLOT_STYLE
):
    """
    Create a figure with axes placed at fixed positions.

    This guarantees that added labels/annotations do not shift the
    plotting areas around between figures.
    """
    fig_width = style["fig_width"]
    fig_height = compute_figure_height(
        nrows=nrows,
        panel_height=style["panel_height"],
        top=style["top"],
        bottom=style["bottom"],
        hspace=style["hspace"],
        style=style
    )

    fig = plt.figure(figsize=(fig_width, fig_height))

    left = style["left"]
    right = style["right"]
    bottom = style["bottom"]
    top = style["top"]
    wspace = style["wspace"]
    hspace = style["hspace"]

    usable_w = right - left
    usable_h = top - bottom

    ax_w = (usable_w - (ncols - 1) * wspace) / ncols
    ax_h = (usable_h - (nrows - 1) * hspace) / nrows

    axes = np.empty((nrows, ncols), dtype=object)

    for r in range(nrows):
        for c in range(ncols):
            x0 = left + c * (ax_w + wspace)
            y0 = top - (r + 1) * ax_h - r * hspace

            if r == 0 and c == 0:
                ax = fig.add_axes([x0, y0, ax_w, ax_h])
            else:
                sharex_ax = axes[0, c] if sharex else None
                sharey_ax = axes[r, 0] if sharey else None

                # if both requested, prefer sharing with row/column anchor
                ax = fig.add_axes(
                    [x0, y0, ax_w, ax_h],
                    sharex=sharex_ax,
                    sharey=sharey_ax
                )

            axes[r, c] = ax

    return fig, axes


# =========================================================
# AXES STANDARDIZATION
# =========================================================

def standardize_axis(
    ax,
    xlim=None,
    ylim=None,
    xticks=None,
    yticks=None,
    xlabel=None,
    ylabel=None,
    title=None,
    hide_left_labels=False,
    hide_bottom_labels=False,
    style=PLOT_STYLE
):
    """Apply standardized axis formatting."""
    if xlim is not None:
        ax.set_xlim(*xlim)
    if ylim is not None:
        ax.set_ylim(*ylim)
    if xticks is not None:
        ax.set_xticks(xticks)
    if yticks is not None:
        ax.set_yticks(yticks)
    if xlabel is not None:
        ax.set_xlabel(xlabel)
    if ylabel is not None:
        ax.set_ylabel(ylabel)
    if title is not None:
        ax.set_title(title, pad=8)

    if hide_left_labels:
        ax.tick_params(axis="y", labelleft=False)
        ax.set_ylabel("")

    if hide_bottom_labels:
        ax.tick_params(axis="x", labelbottom=False)
        ax.set_xlabel("")

    ax.tick_params(axis="both", labelsize=style["tick_size"])
    sns.despine(ax=ax)


# =========================================================
# TOP GREY BAND (UPPER 7% OF AXES)
# =========================================================

def add_top_band(ax, text=None, x=None, style=PLOT_STYLE):
    """
    Add a grey band occupying the upper fixed fraction of the axes.
    Uses x in data coordinates and y in axes coordinates.
    """
    y1 = 1.0
    y0 = 1.0 - style["top_band_frac"]
    trans = ax.get_xaxis_transform()

    xmin, xmax = ax.get_xlim()

    ax.fill_between(
        [xmin, xmax],
        y0, y1,
        transform=trans,
        color=style["top_band_color"],
        alpha=style["top_band_alpha"],
        zorder=0
    )

    if text is not None:
        if x is None:
            x = (xmin + xmax) / 2
        ax.text(
            x, (y0 + y1) / 2,
            text,
            transform=trans,
            ha="center",
            va="center",
            fontsize=style["annotation_size"],
            color="black"
        )


def add_top_band_segments(ax, segments, style=PLOT_STYLE):
    """
    Add labelled segments inside the top band.

    segments: list of tuples [(x0, x1, label), ...]
    """
    y1 = 1.0
    y0 = 1.0 - style["top_band_frac"]
    trans = ax.get_xaxis_transform()

    for x0, x1, label in segments:
        ax.fill_between(
            [x0, x1],
            y0, y1,
            transform=trans,
            color=style["top_band_color"],
            alpha=style["top_band_alpha"],
            zorder=0
        )
        ax.text(
            (x0 + x1) / 2, (y0 + y1) / 2,
            label,
            transform=trans,
            ha="center",
            va="center",
            fontsize=style["annotation_size"],
            color="black"
        )


# =========================================================
# COMMON HELPERS
# =========================================================

def half_step_ticks(xmin, xmax, step=0.5):
    """Return clean ticks aligned to the requested step."""
    factor = 1 / step
    start = math.ceil(xmin * factor) / factor
    stop = math.floor(xmax * factor) / factor
    return np.arange(start, stop + step, step)


def integer_ticks(xmin, xmax):
    """Return integer ticks spanning the visible range."""
    return np.arange(math.ceil(xmin), math.floor(xmax) + 1, 1)


def add_cluster_bar(ax, start, end, label=None, y_frac=0.03, color="red", lw=2.2,
                    text_offset_frac=0.03, style=PLOT_STYLE):
    """Add a significance cluster bar near the bottom of the current y-limits."""
    ymin, ymax = ax.get_ylim()
    yr = ymax - ymin
    y = ymin + y_frac * yr

    ax.hlines(y=y, xmin=start, xmax=end, color=color, linewidth=lw, alpha=0.8)

    if label is not None:
        ax.text(
            (start + end) / 2,
            y + text_offset_frac * yr,
            label,
            ha="center",
            va="bottom",
            fontsize=style["annotation_size"],
            color="black"
        )


def save_figure(fig, filepath, style=PLOT_STYLE):
    """
    Save without bbox_inches='tight' so panel geometry stays fixed.
    """
    fig.savefig(filepath, dpi=style["dpi"])

def add_panel_labels(fig, axes, labels=None, x_offset=0.04, y_offset=0.032, style=PLOT_STYLE):
    """
    Add bold panel labels (A, B, C, ...) to axes.
    Works with:
      - dict of axes
      - 1D/2D numpy array of axes
      - list/tuple of axes
    """
    import numpy as np

    if isinstance(axes, dict):
        axes_list = list(axes.values())
    else:
        axes_list = list(np.array(axes, dtype=object).ravel())

    if labels is None:
        labels = [chr(ord("A") + i) for i in range(len(axes_list))]

    for label, ax in zip(labels, axes_list):
        bbox = ax.get_position()
        fig.text(
            bbox.x0 - x_offset,
            bbox.y1 + y_offset,
            label,
            fontsize=style["title_size"] + 4,
            fontweight="bold",
            ha="left",
            va="bottom"
        )


