# Final combined plot
# %%
import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# ---------- helper ----------
def add_load_markers(ax, data, x="time", y="pupils_z_delay", hue="Load"):
    handles, labels = ax.get_legend_handles_labels()
    color_map = {}
    for h, lab in zip(handles, labels):
        try:
            key = int(lab)
        except ValueError:
            key = lab
        color_map[key] = h.get_color()

    m = data.groupby([hue, x], as_index=False)[y].mean()

    for load, times in marker_times.items():
        mm = m[m[hue].eq(load) & m[x].isin(times)]

        for i, (_, row) in enumerate(mm.iterrows(), start=1):
            ax.scatter(
                row[x], row[y],
                s=160,
                marker="o",
                color=colors_load[i-1],
                edgecolor="white",
                linewidth=1,
                zorder=10
            )

            ax.text(
                row[x], row[y],
                str(i),
                color="white",
                ha="center",
                va="center",
                fontsize=8,
                weight="bold",
                zorder=11
            )

# ---------- data ----------
start_time = 3.0
end_time = 6.5
delay_time_window = evoked_df_shifted[
    (evoked_df_shifted['time'] >= start_time) &
    (evoked_df_shifted['time'] <= end_time)
]

sig_clusters = pd.read_csv('../data/csv_files/cluster_results_mask_vs_nomask.csv')
sig_clusters = sig_clusters[sig_clusters['p_value'] < 0.05]

colors_load = sns.color_palette("flare", 3)
colors_mask = sns.color_palette("husl", 2)

mask_data = evoked_df_shifted[evoked_df_shifted["subID"].isin(mask_partis)]
nomask_data = evoked_df_shifted[evoked_df_shifted["subID"].isin(nomask_partis)]

# ---------- figure ----------
with sns.plotting_context(context='paper', font_scale=1.1):
    fig, axes = plt.subplots(
        1, 3,
        figsize=(8.27, 2.9)
    )

    fig.subplots_adjust(
        left=0.12,
        right=0.98,
        bottom=0.15,
        top=0.88,
        wspace=0.30,
        hspace=0.30
    )

    ax1, ax2, ax3 = axes
    # share y-axis between first two plots
    ax2.sharey(ax1)
    # =========================
    # Panel 1: Mask
    # =========================
    sns.lineplot(
        data=mask_data,
        hue='Load',
        x='time',
        y='pupils_z_delay',
        errorbar='se',
        ax=ax1,
        palette=colors_load
    )
    add_load_markers(ax1, mask_data)
    sns.despine(ax=ax1)

    x_min = evoked_df_shifted['time'].min()
    x_max = evoked_df_shifted['time'].max()
    ax1.set_xlim(x_min, x_max)

    x_ticks = np.arange(
        np.ceil(x_min),
        np.floor(x_max) + 1,
        1
    )
    ax1.set_xticks(x_ticks)

    ax1.axvspan(3, 3.1, color=colors_mask[1], alpha=0.3)
    ax1.text(3.02, ax1.get_ylim()[1] * 0.75, "mask\ndisplay",
             color=colors_mask[1], alpha=0.9, fontsize=8)

    ax1.axvline(3, color='black', alpha=0.5, lw=1)
    ax1.axvline(6.5, color='black', alpha=0.5, lw=1)

    ax1.set_title('Mask', pad=10, fontsize=13)
    ax1.set_ylabel('pupil size (z-scored)')
    ax1.set_xlabel('time (s)')

    ax1.autoscale(enable=True, axis='y', tight=True)
    ymin, ymax = ax1.get_ylim()
    ax1.set_ylim(ymin, ymax + 0.12 * (ymax - ymin))

    trans1 = ax1.get_xaxis_transform()
    ax1.fill_between([x_min, x_max], 0.93, 0.99, transform=trans1,
                     color='gray', alpha=0.15, zorder=0)
    ax1.text(1.3, 0.96, "encoding", transform=trans1,
             ha='center', va='center', fontsize=8)
    ax1.text(4.75, 0.96, "delay", transform=trans1,
             ha='center', va='center', fontsize=8)
    ax1.text(7.8, 0.96, "probe", transform=trans1,
             ha='center', va='center', fontsize=8)

    ax1.legend(title='set size', loc='lower right', fontsize=8, title_fontsize=9)

    # =========================
    # Panel 2: No mask
    # =========================
    sns.lineplot(
        data=nomask_data,
        hue='Load',
        x='time',
        y='pupils_z_delay',
        errorbar='se',
        ax=ax2,
        palette=colors_load
    )
    add_load_markers(ax2, nomask_data)
    sns.despine(ax=ax2)

    ax2.set_xlim(x_min, x_max)
    ax2.set_xticks(x_ticks)

    ax2.axvline(3, color='black', alpha=0.5, lw=1)
    ax2.axvline(6.5, color='black', alpha=0.5, lw=1)

    ax2.set_title('No mask', pad=10, fontsize=13)
    ax2.set_xlabel('time (s)')
    ax2.set_ylabel('')

    ax2.autoscale(enable=True, axis='y', tight=True)
    ymin, ymax = ax2.get_ylim()
    ax2.set_ylim(ymin, ymax + 0.12 * (ymax - ymin))

    trans2 = ax2.get_xaxis_transform()
    ax2.fill_between([x_min, x_max], 0.93, 0.99, transform=trans2,
                     color='gray', alpha=0.15, zorder=0)
    ax2.text(1.3, 0.96, "encoding", transform=trans2,
             ha='center', va='center', fontsize=8)
    ax2.text(4.75, 0.96, "delay", transform=trans2,
             ha='center', va='center', fontsize=8)
    ax2.text(7.8, 0.96, "probe", transform=trans2,
             ha='center', va='center', fontsize=8)

    ax2.legend(title='set size', loc='lower right', fontsize=8, title_fontsize=9)

    # =========================
    # Panel 3: Mask vs no mask during delay
    # =========================
    sns.lineplot(
        data=delay_time_window,
        hue='mask',
        x='time',
        y='pupils_z_delay',
        errorbar='se',
        ax=ax3,
        palette=colors_mask
    )
    sns.despine(ax=ax3)

    dx_min = delay_time_window['time'].min()
    dx_max = delay_time_window['time'].max()
    ax3.set_xlim(dx_min, dx_max)

    delay_ticks = np.arange(
        np.ceil(dx_min * 2) / 2,
        np.floor(dx_max * 2) / 2 + 0.5,
        0.5
    )
    ax3.set_xticks(delay_ticks)

    ax3.axvline(3, color='black', alpha=0.5, lw=1)
    ax3.axvline(6.5, color='black', alpha=0.5, lw=1)

    ax3.set_title('Mask vs no mask', pad=10, fontsize=13)
    ax3.set_xlabel('time (s)')
    ax3.set_ylabel('')

    ax3.autoscale(enable=True, axis='y', tight=True)
    ymin, ymax = ax3.get_ylim()
    y_range = ymax - ymin
    ax3.set_ylim(ymin - 0.12 * y_range, ymax + 0.10 * y_range)

    ymin, ymax = ax3.get_ylim()
    y_range = ymax - ymin
    y_bar = ymin + 0.03 * y_range

    for _, row in sig_clusters.iterrows():
        start = row['start_time']
        end = row['end_time']

        ax3.hlines(
            y=y_bar,
            xmin=start,
            xmax=end,
            color='red',
            alpha=0.7,
            linewidth=2.2
        )

        ax3.text(
            (start + end) / 2,
            y_bar + 0.03 * y_range,
            'p < .001',
            ha='center',
            va='bottom',
            fontsize=8
        )

    trans3 = ax3.get_xaxis_transform()
    ax3.fill_between([dx_min, dx_max], 0.93, 0.99, transform=trans3,
                     color='gray', alpha=0.15, zorder=0)
    ax3.text((dx_min + dx_max) / 2, 0.96, "delay", transform=trans3,
             ha='center', va='center', fontsize=8)

    ax3.legend(title='mask', loc='center right', fontsize=8, title_fontsize=9)

    ax1.annotate(
        '.',
        xy=(-0.4, 0.5),
        xycoords='axes fraction',
        ha='center',
        va='center',
        rotation=90,
        fontsize=12,
        color = 'white'
    )

    # ---------- final layout ----------
    for ax in axes:
        ax.tick_params(axis='both', labelsize=8)

    # plt.tight_layout(rect=[0, 0, 1, 0.92])

    # save
    name = "pupil_combined_mask_row_a4.png"
    figures_folder = '/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/figures'
    figure_filepath = os.path.join(figures_folder, name)
    plt.savefig(figure_filepath, dpi=300) # , bbox_inches='tight'

    plt.show()
