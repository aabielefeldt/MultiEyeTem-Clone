        # horizontal significance bar
        ax.hlines(
            y=y_bar,
            xmin=start,
            xmax=end,
            color='red',
            alpha=0.7,
            linewidth=2.5
        )

        ax.text(
            (start + end) / 2,
            y_bar + 0.02 * (ymax - ymin),
            f"p <.001",
            ha='center',
            va='bottom',
            fontsize=9
        )


