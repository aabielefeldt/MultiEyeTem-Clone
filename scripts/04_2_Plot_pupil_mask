        data=nomask_data, 
        hue='Load', x='time', y='pupils_z_delay', 
        errorbar='se', ax=ax2, legend='full', palette=colors_load
    )

    add_load_markers(ax1, mask_data)
    add_load_markers(ax2, nomask_data)

    sns.despine(ax=ax1)
    sns.despine(ax=ax2)

    x_min = evoked_df_shifted['time'].min()
    x_max = evoked_df_shifted['time'].max()
    ax1.set_xlim(x_min, x_max)
    ax2.set_xlim(x_min, x_max)

