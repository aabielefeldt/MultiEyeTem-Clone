import seaborn as sns
import matplotlib.pyplot as plt
from scipy.stats import zscore

# %% 
# read evoked dataframe and associated significant results 
df = pd.read_csv('../data/csv_files/df.csv')
good_partis = df['subID'].unique()
mask_partis = df[df['mask']==1]['subID'].unique().tolist()
nomask_partis = df[df['mask']==0]['subID'].unique().tolist()

# evoked_df_pos1_interpol_shifted = pd.read_csv('../data/csv_files/evoked_df_pos1_interpol_shifted.csv')
# sig_results_pos1_interpol_shifted = pd.read_csv('../data/csv_files/sig_results_pos1_interpol_shifted.csv')

# # Participants with time issue
# issue_partis = ['REUNMA', '1UVQEK', '35T018', '4A2K27', '30K8XE', 'R8CW7K']

# no_time_partis = good_partis[~np.isin(good_partis, issue_partis)].tolist()
# cluster_results_mask_vs_nomask = pd.read_csv('../data/csv_files/cluster_results_mask_vs_nomask.csv')


evoked_df_shifted = pd.read_csv('../data/csv_files/evoked_df_load_shifted.csv')

evoked_df_shifted["time"] = evoked_df_shifted["time"].round(3)
# then use x="time_r" in the helper + lineplot, and marker times as exact values
#%%

delay_start, delay_end = 3, 6.5   # adjust if needed (inclusive/exclusive is up to you)

# Boolean mask for delay period
is_delay = evoked_df_shifted["time"].between(delay_start, delay_end, inclusive="both")

def delay_zscore_apply_all(g):
    # compute mean/sd from delay only, apply to all rows of that subject
    delay_vals = g.loc[is_delay.loc[g.index], "pupils"].to_numpy()

    mu = np.nanmean(delay_vals)
    sd = np.nanstd(delay_vals, ddof=0)

    # avoid division-by-zero if sd == 0 or all NaN
    if not np.isfinite(sd) or sd == 0:
        return pd.Series(np.nan, index=g.index)

    return (g["pupils"] - mu) / sd

evoked_df_shifted["pupils_z_delay"] = (
    evoked_df_shifted
    .groupby("subID", group_keys=False)
    .apply(delay_zscore_apply_all)
)


# Z-score within each subject (across all times and trials)
evoked_df_shifted['pupils_z'] = evoked_df_shifted.groupby('subID')['pupils'].transform(
    lambda x: zscore(x, nan_policy='omit')
)
# an evoked where I used the full time of the encoding period until delay (differing lengths for load conditions) as the baseline
#evoked_df_shifted_full_trial_bl = pd.read_csv('../data/csv_files/evoked_df_shifted_full_trial_bl.csv')

# %%
# Subsample of only participants without time issue
#evoked_df_no_time_partis_shifted = pd.read_csv('../data/csv_files/evoked_df_no_time_partis_shifted.csv')

#%%
marker_times = {
    1: [2],
    2: [1, 2],
    3: [0, 1, 2]
}

def add_load_markers(ax, data, x="time", y="pupils_z_delay", hue="Load"):

    # Get line colors (for circle fills)
    handles, labels = ax.get_legend_handles_labels()
    color_map = {}
    for h, lab in zip(handles, labels):
        try:
            key = int(lab)
        except ValueError:
            key = lab
        color_map[key] = h.get_color()

    # Mean timecourse
    m = data.groupby([hue, x], as_index=False)[y].mean()

    for load, times in marker_times.items():

        mm = m[m[hue].eq(load) & m[x].isin(times)]

        for i, (_, row) in enumerate(mm.iterrows(), start=1):

            # Circle (Load color)
            ax.scatter(
                row[x], row[y],
                s=160,
                marker="o",
                color=colors_load[i-1],
                edgecolor="white",
                linewidth=1,
                zorder=10
            )

            # Number (position color)
            ax.text(
                row[x], row[y],
                str(i),
                color="white",
                ha="center",
                va="center",
                fontsize=9,
                weight="bold",
                zorder=11
            )


# %% 
colors_load = sns.color_palette("flare", 3)

with sns.plotting_context(context='paper', font_scale=1.5): 
    
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 8), sharey=True)

    # Plot for participants WITH mask (Left Plot)
    mask_data = evoked_df_shifted[evoked_df_shifted["subID"].isin(mask_partis)]
    sns.lineplot(
        data=mask_data, 
        hue='Load', x='time', y='pupils',  
        errorbar='se', ax=ax1, palette=colors_load
    )
    
    # Plot for participants WITHOUT mask (Right Plot)
    nomask_data = evoked_df_shifted[evoked_df_shifted["subID"].isin(nomask_partis)]
    sns.lineplot(
        data=nomask_data, 
        hue='Load', x='time', y='pupils', 
        errorbar='se', ax=ax2, legend='full', palette=colors_load
    )

    add_load_markers(ax1, mask_data)
    add_load_markers(ax2, nomask_data)

    sns.despine(ax=ax1)
    sns.despine(ax=ax2)

    # Add mask time
    ax1.axvspan(3, 3.1, color='blue', alpha=0.15)
    ax1.text(3, 1.1, "mask \ndisplay", color='blue', alpha=0.5, fontsize=10)

    # Add probe
    ylim = ax1.get_ylim()[1] 
    ax1.axvline(3, color='black', alpha=0.5)
    ax1.axvline(6.5, color='black', alpha=0.5)
    ax2.axvline(3, color='black', alpha=0.5)
    ax2.axvline(6.5, color='black', alpha=0.5)
    

    # Set x-axis to show all whole numbers within range
    x_ticks = np.arange(int(evoked_df_shifted['time'].min()), int(evoked_df_shifted['time'].max()) + 1, 1)
    ax2.set_xticks(x_ticks)
    ax2.set_xticklabels(x_ticks)
    ax1.set_xticks(x_ticks)
    ax1.set_xticklabels(x_ticks)

    ax1.set_title('Mask', y=1.1, fontsize=16)
    ax2.set_title('No mask', y=1.1, fontsize=16)

    ax1.set_ylabel('pupil size (z-scored)')
    ax1.set_xlabel('time (s)')
    ax2.set_xlabel('time (s)')

    # Increase font size of x and y tick labels
    ax2.tick_params(axis='x', labelsize=14)
    ax2.tick_params(axis='y', labelsize=14)

    ax1.autoscale(enable=True, axis='y', tight=True)
    ax2.autoscale(enable=True, axis='y', tight=True)

    ax1.text(1.3, 2.3, "encoding", color='black', alpha=0.8, fontsize=10, ha='center', clip_on=False)
    ax1.text(6.5+1.3, 2.3, "probe", color='black', alpha=0.8, fontsize=10, ha='center', clip_on=False)
    ax1.text(3+1.75, 2.3, "delay", color='black', alpha=0.8, fontsize=10, ha='center', clip_on=False)
    ax1.axhspan(2.25, 2.4, transform=ax1.transAxes, color='gray', alpha=0.15, clip_on=False)

    ax2.text(1.3, 2.3, "encoding", color='black', alpha=0.8, fontsize=10, ha='center', clip_on=False)
    ax2.text(6.5+1.3, 2.3, "probe", color='black', alpha=0.8, fontsize=10, ha='center', clip_on=False)
    ax2.text(3+1.75, 2.3, "delay", color='black', alpha=0.8, fontsize=10, ha='center', clip_on=False)
    ax2.axhspan(2.25, 2.4, transform=ax1.transAxes,  color='gray', alpha=0.15, clip_on=False)
    # Adding a title
    # plt.suptitle('Pupil dilation across conditions', y=1.15, fontsize = 20)
    # plt.title(f'Applied baseline {baseline}', y=1.25, color='blue', alpha=0.4)
    
    #Adding a legend
    plt.legend()
    ax1.legend(loc='lower right', fontsize=12)
    ax2.legend(loc='lower right', fontsize=12)


    # Save the figure
    name=f"pupil_load_mask_vs_nomask.png"
    figures_folder = '/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/figures'
    figure_filepath = os.path.join(figures_folder, name)

    plt.savefig(figure_filepath, bbox_inches = 'tight')


