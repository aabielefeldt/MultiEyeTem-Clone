    ax1.set_xticks(x_ticks)
    ax1.set_xticklabels(x_ticks)

    ax1.set_title('Mask', y=1.05, fontsize=12)
    ax2.set_title('No mask', y=1.05, fontsize=12)

    ax1.set_ylabel('pupil size (z-scored)')
    ax1.set_xlabel('time (s)')
    ax2.set_xlabel('time (s)')

    # Increase font size of x and y tick labels
    ax2.tick_params(axis='x', labelsize=14)
    ax2.tick_params(axis='y', labelsize=14)

    ax1.autoscale(enable=True, axis='y', tight=True)
    ax2.autoscale(enable=True, axis='y', tight=True)

    ax1.text(1.3, 6.1, "encoding", color='black', alpha=0.8, fontsize=10, ha='center', clip_on=False)
    ax1.text(6.5+1.3, 6.1, "probe", color='black', alpha=0.8, fontsize=10, ha='center', clip_on=False)
    ax1.text(3+1.75, 6.1, "delay", color='black', alpha=0.8, fontsize=10, ha='center', clip_on=False)
    ax1.axhspan(6, 6.38, transform=ax1.transAxes, color='gray', alpha=0.15, clip_on=False)

    ax2.text(1.3,  6.1, "encoding", color='black', alpha=0.8, fontsize=10, ha='center', clip_on=False)
    ax2.text(6.5+1.3, 6.1, "probe", color='black', alpha=0.8, fontsize=10, ha='center', clip_on=False)
    ax2.text(3+1.75,  6.1, "delay", color='black', alpha=0.8, fontsize=10, ha='center', clip_on=False)
    ax2.axhspan(6, 6.38, transform=ax1.transAxes,  color='gray', alpha=0.15, clip_on=False)
    # Adding a title
    # plt.suptitle('Pupil dilation across conditions', y=1.15, fontsize = 20)
    # plt.title(f'Applied baseline {baseline}', y=1.25, color='blue', alpha=0.4)
    
    #Adding a legend
    plt.legend()
    ax1.legend(title='set size', loc='lower right', fontsize=8, title_fontsize=9)
    ax2.legend(title='set size', loc='lower right', fontsize=8, title_fontsize=9)



    # Save the figure
    name=f"pupil_load_mask_vs_nomask.png"
    figures_folder = '/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/figures'
    figure_filepath = os.path.join(figures_folder, name)

    plt.savefig(figure_filepath, bbox_inches = 'tight')


