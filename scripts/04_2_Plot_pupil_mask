# assumes these helpers already exist from your helper module:
# - set_global_plot_style
# - PLOT_STYLE
# - compute_figure_height
# - save_figure

# --------------------------------------------------
# fixed mixed layout: 2 rows x 3 cols, top row polar
# --------------------------------------------------
def create_mixed_grid_2x3_top_polar(style=PLOT_STYLE):
    fig_width = style["fig_width"]
    fig_height = compute_figure_height(nrows=2, style=style)

    fig = plt.figure(figsize=(fig_width, fig_height))

    left = style["left"]
    right = style["right"]
    bottom = style["bottom"]
    top = style["top"]
    wspace = style["wspace"]
    hspace = style["hspace"]

    usable_w = right - left
    usable_h = top - bottom

    ax_w = (usable_w - 2 * wspace) / 3
    ax_h = (usable_h - hspace) / 2

    y_toprow = top - ax_h
    y_bottomrow = bottom

    axes = np.empty((2, 3), dtype=object)

    # top row: polar
    for c in range(3):
        x0 = left + c * (ax_w + wspace)
        axes[0, c] = fig.add_axes([x0, y_toprow, ax_w, ax_h], projection='polar')

    # bottom row: normal cartesian
    for c in range(3):
        x0 = left + c * (ax_w + wspace)
        axes[1, c] = fig.add_axes([x0, y_bottomrow, ax_w, ax_h])

    return fig, axes


# --------------------------------------------------
# helper: consistent polar formatting
# --------------------------------------------------
def standardize_polar_axis(
    ax,
    title=None,
    rlim=None,
    rticks=None,
    legend_title=None,
    style=PLOT_STYLE
):
    if title is not None:
        ax.set_title(title, pad=10, fontsize=style["title_size"])

    if rlim is not None:
        ax.set_rlim(*rlim)

    if rticks is not None:
        ax.set_yticks(rticks)

    ax.set_theta_zero_location("E")
    ax.set_theta_direction(1)
    ax.grid(True)
    ax.tick_params(axis='both', labelsize=style["tick_size"])


# --------------------------------------------------
# helper: polar line plot by set size
# --------------------------------------------------
def plot_polar_by_load(
    ax,
    data,
    angle_col,
    value_col,
    load_col="items_presented",
    loads=(1,2,3),
    colors=None,
    overall_value=None,
    overall_label=None,
    title=None,
    rlim=None,
    rticks=None,
    rorigin=None,
    legend_title=None,
    style=PLOT_STYLE
):

    if colors is None:
        colors = sns.color_palette("flare", len(loads))

    # sorted orientations and close circle
    oris = np.sort(data[angle_col].dropna().unique())
    oris_closed = np.append(oris, oris[0])

    thetas = []
    values_by_load = {load: [] for load in loads}

    overall_vals = [] if overall_value is None else np.full(len(oris_closed), overall_value)

    for ori in oris_closed:

        theta = np.radians(ori)
        thetas.append(theta)
        for load in loads:

            val = data.loc[
                (data[angle_col] == ori) &
                (data[load_col] == load),
                value_col
            ].mean()

            values_by_load[load].append(val)

        if overall_value is None:
            overall_vals.append(data.loc[data[angle_col] == ori, value_col].mean())

    # scatter points
    for load_i, load in enumerate(loads):
        for theta, val in zip(thetas, values_by_load[load]):
            ax.plot(theta, val, 'o', color=colors[load_i], ms=3)

    # connecting lines
    if overall_label is not None:
        ax.plot(thetas, overall_vals, linestyle='dashed', color='pink', label=overall_label)

    for load_i, load in enumerate(loads):
        ax.plot(thetas, values_by_load[load], '-', color=colors[load_i], label=f'{load}')

    # formatting
    if title is not None:
        ax.set_title(title, pad=10, fontsize=style["title_size"])

    if rlim is not None:
        ax.set_rlim(*rlim)

    if rticks is not None:
        ax.set_yticks(rticks)

    if rorigin is not None:
        ax.set_rorigin(rorigin)

    ax.set_theta_zero_location("N")
    ax.set_theta_direction(-1)

    ax.grid(True)
    ax.tick_params(axis='both', labelsize=7, pad=-3)

    handles, labels = ax.get_legend_handles_labels()
    by_label = dict(zip(labels, handles))

    ax.legend(
        by_label.values(),
        by_label.keys(),
        loc="center",
        frameon=False,
        fontsize=style["legend_size"],
        title=legend_title,
        title_fontsize=style["legend_title_size"]
    )


