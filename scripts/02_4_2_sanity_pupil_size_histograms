#%%
# Histograms with new epochs (new interpolation and nan)
histo_all = pd.DataFrame()

for i in ['8H3YTN']:
    
    # reading epochs per participant
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Epochs_improved_blink_interpolation"
    epoch_file = folder_path + "/" + i + "_new_interpol_and_nan-epo.fif"
    pupil_epoch = mne.read_epochs(epoch_file, preload=True, verbose=None)

    # combining channels
    pupil_ix = mne.pick_channels(pupil_epoch.info["ch_names"], include=['pupil_left', 'pupil_right'])
    roi_dict = dict(pupils=pupil_ix)

    pupil_epochs_combined = mne.channels.combine_channels(pupil_epoch, roi_dict, method="mean")
    pupil_epochs_combined_df = pupil_epochs_combined.to_data_frame()
    pupil_epochs_combined_df['subID'] = i

    histo_all = pd.concat([histo_all, pupil_epochs_combined_df])

    pupil_epochs_df = pupil_epoch.to_data_frame()

    plt.figure()
    plt.title(f'SubID {i} - distribution of pupil size within epochs')
    sns.histplot(data=pupil_epochs_df, bins=100, stat='density', x='pupil_right', legend=True)

    # Set fixed axis limits
    plt.xlim(0, 2e9)
    plt.ylim(0, 6e-9)
    plt.show()

    # Save the figure
    # name=f"pupil_size_histogram_{i}_new_blink_interpolation.png"
    # figures_folder = '/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/figures/pupil_size'
    # figure_filepath = os.path.join(figures_folder, name)

    # plt.savefig(figure_filepath, bbox_inches = 'tight')

plt.figure()
plt.title(f'distribution of pupil size within epochs all subIDs')
sns.histplot(data=histo_all, bins=100, stat='density', x='pupils', legend=True)
plt.show()

