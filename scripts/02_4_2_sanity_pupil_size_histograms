# Blink statistics

tokeep = ['BAD_NAN', 'blink_used_for_merged', 'merged_blink_interp', 'velo_blink_interp']

annots_all = []

for i in good_partis:
    # read epochs
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Epochs_even_newer"
    epoch_file = folder_path + "/" + i + "_even_newer-epo.fif"
    pupil_epoch = mne.read_epochs(epoch_file, preload=True, verbose=None)

    for idx in range(len(pupil_epoch)):
        annots = pupil_epoch[idx].annotations
        filtered_annots = annots[np.isin(annots.description, tokeep)]

        if len(filtered_annots) == 0:
            continue

        meta = pupil_epoch[idx].metadata
        epoch_number = meta['trial'].item()
        items_presented = meta['items_presented'].item()
        subID = meta['subID'].item()

        for onset, duration, description, ch_names in zip(filtered_annots.onset,
                                                filtered_annots.duration,
                                                filtered_annots.description,
                                                filtered_annots.ch_names):
            annots_all.append((onset, duration, description, ch_names, epoch_number, items_presented, subID))


# Convert to a structured NumPy array or DataFrame at the end
anno_df_all = pd.DataFrame(annots_all, columns=[
    'onset', 'duration', 'description', 'ch_names',
    'epoch_number', 'items_presented', 'subID'
])
display(anno_df_all)
