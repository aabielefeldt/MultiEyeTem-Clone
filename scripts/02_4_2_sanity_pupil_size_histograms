blink_annot = raw.annotations[np.isin(raw.annotations.description, [ "BAD_long_blink"])] # "blink",

# Assign filtered annotations to the copied raw object
raw_copy.set_annotations(blink_annot)

raw_copy.plot(events=events_pos1, event_id=trigger_dict, scalings=1e3, show=False, show_options=True, duration=200, picks= ['pupil_left', 'pupil_right'])

