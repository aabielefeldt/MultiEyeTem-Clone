# %%
# Importsconda
import mne
import pandas as pd
import numpy as np
from pupil_utils import apply_baseline_nan_aware
from IPython.display import display
# %% Load Metadata

df = pd.read_csv('../data/csv_files/df.csv')
good_partis = df['subID'].unique()

# %%
### appending all epochs into one list while:
# combining both pupil channels (using nanmean)
# applying baseline
# seperating by condition
# cropping according to condition
# averaging epochs (using nanmean)

# and then shifting so that delay onset is the same for all conditions



##########
# this is still combining the pupils first right?
########
drop_log_rows = []

evoked_list = []

for i in good_partis:
    
    # reading epochs per participant
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Epochs_even_newer"
    epoch_file = folder_path + "/" + i + "_even_newer-epo.fif"
    pupil_epoch = mne.read_epochs(epoch_file, preload=True, verbose=None)

    # applying baseline per eye and nan aware while dropping any epochs where the baseline period was nan in both eyes
    pupil_epoch_bl = apply_baseline_nan_aware(pupil_epoch, bmin=-0.1, bmax=0.0)
    baseline = pupil_epoch_bl.baseline
    
    # counting dropped epochs
    sum_dropped = sum('BAD_baseline_nan_both_eyes' in entry for entry in pupil_epoch_bl.drop_log)
    drop_log_rows.append({'subID': i, 'sum_dropped': sum_dropped})

    # combining channels
    pupil_ix = mne.pick_channels(pupil_epoch_bl.info["ch_names"], include=['pupil_left', 'pupil_right'])
    roi_dict = dict(pupils=pupil_ix)
    combine_nanmean = lambda data: np.nanmean(data, axis=1)
    pupil_epochs_combined_bl = mne.channels.combine_channels(pupil_epoch_bl, roi_dict, method=combine_nanmean)

    # seperating per load condition
    con1_epochs = pupil_epochs_combined_bl["items_presented == 1"]
    con2_epochs = pupil_epochs_combined_bl["items_presented == 2"]
    con3_epochs = pupil_epochs_combined_bl["items_presented == 3"]

    # shortening the epochs based on condition (crop defaults to inclduing tmax)
    con1_epochs.crop(-0.1, 7)
    con2_epochs.crop(-0.1, 8)
    con3_epochs.crop(-0.1, 9)

    # averaging per load condition
    # leading to error because there are some epochs that are only nan for pupils?
    evoked_nan_mean = lambda x: np.nanmean(x, axis=0)
    con1_ave = con1_epochs.average(method=evoked_nan_mean)
    con2_ave = con2_epochs.average(method=evoked_nan_mean)
    con3_ave = con3_epochs.average(method=evoked_nan_mean)

    # adding individual averaged data to dataframe including load and subID
    con1_ave_df = con1_ave.to_data_frame(scalings=1)
    con1_ave_df['Load'] = 1
    con1_ave_df['subID'] = i
    con2_ave_df = con2_ave.to_data_frame(scalings=1)
    con2_ave_df['Load'] = 2
    con2_ave_df['subID'] = i
    con3_ave_df = con3_ave.to_data_frame(scalings=1)
    con3_ave_df['Load'] = 3
    con3_ave_df['subID'] = i

    # extending evoked list
    evoked_list.extend([con1_ave_df, con2_ave_df, con3_ave_df])


drop_log_df = pd.DataFrame(drop_log_rows)
evoked_df_load = pd.concat(evoked_list, ignore_index=True)

# evoked_df['baseline_start'] = baseline[0]
# evoked_df['baseline_end'] = baseline[1]

drop_log_df.to_csv('../data/csv_files/drop_log_df_evoked_load.csv', index=False)
evoked_df_load.to_csv('../data/csv_files/evoked_df_load.csv', index=False)

# %%

# shifting the conditions so that the epochs that are epoched on pos1 are time-locked to the test onset
evoked_df_load_shifted = evoked_df_load.copy()
evoked_df_load_shifted.loc[evoked_df_load_shifted['Load']==1, 'time'] +=2
evoked_df_load_shifted.loc[evoked_df_load_shifted['Load']==2, 'time'] +=1
evoked_df_load_shifted.loc[evoked_df_load_shifted['Load']==3, 'time'] +=0

# %%
mask_partis = df[df['mask']==1]['subID'].unique().tolist()
nomask_partis = df[df['mask']==0]['subID'].unique().tolist()
# Adding column for mask
evoked_df_load_shifted['mask'] = evoked_df_load_shifted['subID'].apply(
    lambda x: 1 if x in mask_partis else 0)

# also include rounding here
evoked_df_load_shifted['time'] = evoked_df_load_shifted['time'].round(3)

# saving
evoked_df_load_shifted.to_csv('../data/csv_files/evoked_df_load_shifted.csv', index=False)


# %%
