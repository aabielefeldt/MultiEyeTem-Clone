# %%
# Importsconda
import mne
import numpy as np
import pandas as pd
from datetime import datetime
import pingouin as pg
import seaborn as sns
import matplotlib.pyplot as plt

# %% Load Metadata

df = pd.read_csv('../data/df.csv')
good_partis = df['subID'].unique()
new_partis = np.delete(good_partis, np.where(good_partis == ['KJN4WD']))

# %%
# if qt is used as backend the kernel crashes
# this can probably be deleted once run, but might just keep in in to be safe
mne.viz.set_browser_backend('matplotlib')




# %%


#  JUST FOR NOW - DELETed THE DIFFERENTLY SAMPLED EPOCH FROM THE FOLDER, copy folder still has it

# appending all epochs into one list and combining both pupil channels
epochs_list = []

for i in new_partis:
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem//multieyetem/data/Epochs_data_2024-02-29_13:54"

    epoch_file = folder_path + "/" + i + "-epo.fif"

    pupil_epochs = mne.read_epochs(epoch_file, proj=True, preload=True, verbose=None)

    pupil_ix = mne.pick_channels(pupil_epochs.info["ch_names"], include=['pupil_left', 'pupil_right'])

    roi_dict = dict(pupils=pupil_ix)

    pupil_epochs_combined = mne.channels.combine_channels(pupil_epochs, roi_dict, method="mean")

    epochs_list.append(pupil_epochs_combined)
    


# %%
# so far this is not plotting the average of all participants but the average of each one individually

# Is this concatenating them after each other? And if yes is this still averaging them on top of each other?
# it probably is because they are still on the same timecourse

# Combine epoched data from all participants
combined_epochs_all = mne.concatenate_epochs(epochs_list)

# Calculate the average across all participants
average_epochs = combined_epochs_all.average()

average_epochs.plot()


# %% 

# seperating by condition -> then in the next step taking the average?

# CONDITION 1

# could also do the following with the same effect but seems to take longer??:

# combined_epochs_all['items_presented == 1'].average().plot()




con1_epochs = []

for i in epochs_list:

    pupil_epoch = i
    con1_epoch = pupil_epoch["items_presented == 1"]

    con1_epochs.append(con1_epoch)

combined_epochs_con1 = mne.concatenate_epochs(con1_epochs)

con1_ave = combined_epochs_con1.average()
# the dataframe is already the average over all participants
con1_ave_df = con1_ave.to_data_frame()
con1_ave_df['Load'] = 1

fig=con1_ave.plot()

# %%

# CONDITION 2

con2_epochs = []

for i in epochs_list:

    pupil_epoch = i
    con2_epoch = pupil_epoch["items_presented == 2"]

    con2_epochs.append(con2_epoch)

combined_epochs_con2 = mne.concatenate_epochs(con2_epochs)

con2_ave = combined_epochs_con2.average()
con2_ave_df = con2_ave.to_data_frame()
con2_ave_df['Load'] = 2
fig=con2_ave.plot()


# %%

# CONDITION 3

con3_epochs = []

for i in epochs_list:

    pupil_epoch = i
    con3_epoch = pupil_epoch["items_presented == 3"]

    con3_epochs.append(con3_epoch)

combined_epochs_con3 = mne.concatenate_epochs(con3_epochs)

con3_ave = combined_epochs_con3.average()
con3_ave_df = con3_ave.to_data_frame()
con3_ave_df['Load'] = 3
fig=con3_ave.plot()


#%%

all_con_ave_df = [con1_ave_df, con2_ave_df, con3_ave_df]
all_con_ave_df = pd.concat(all_con_ave_df)


# %% 

# combined plot showing all conditions overlapping

evokeds_list = [con1_ave, con2_ave, con3_ave]

conds = ("1", "2", "3")

evks = dict(zip(conds, evokeds_list))

mne.viz.plot_compare_evokeds(evks, picks="pupil", combine=combine)


# %%

# statistics on the dataframes?

anova_result = pg.anova(data=all_con_ave_df, dv='pupils', between='Load')
anova_result

