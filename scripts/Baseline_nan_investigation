# Importsconda
import mne
import pandas as pd
import numpy as np
# %% Load Metadata

df = pd.read_csv('../data/csv_files/df.csv')
good_partis = df['subID'].unique()


# %%
#functions

import numpy as np
from mne.utils import logger, verbose
nan_means_custom_function = []
@verbose
def rescale_nanaware(data, times, baseline, mode="mean", copy=True, picks=None, verbose=None):
    """Rescale (baseline correct) data, ignoring NaNs in baseline window.

    Drop-in replacement for mne.baseline.rescale, but uses np.nanmean/std.
    Also prints the computed baseline mean for inspection.
    """
    if copy:
        data = data.copy()
    if verbose is not False:
        from mne.baseline import _log_rescale
        msg = _log_rescale(baseline, mode)
        logger.info(msg)

    if baseline is None or data.shape[-1] == 0:
        return data

    bmin, bmax = baseline
    if bmin is None:
        imin = 0
    else:
        imin = np.where(times >= bmin)[0]
        if len(imin) == 0:
            raise ValueError(f"bmin is too large ({bmin}), it exceeds the largest time value")
        imin = int(imin[0])
    if bmax is None:
        imax = len(times)
    else:
        imax = np.where(times <= bmax)[0]
        if len(imax) == 0:
            raise ValueError(f"bmax is too small ({bmax}), it is smaller than the smallest time value")
        imax = int(imax[-1]) + 1
    if imin >= imax:
        raise ValueError(f"Bad rescaling slice ({imin}:{imax}) from time values {bmin}, {bmax}")

    # === nan-aware mean and std ===

    mean = np.nanmean(data[..., imin:imax], axis=-1, keepdims=True)
    mean_orig = np.mean(data[..., imin:imax], axis=-1, keepdims=True)
    # print('mean(s):', mean)
    #mean = np.mean(data[..., imin:imax], axis=-1, keepdims=True)
    # Debug/inspection printout
    #print(f"Baseline correction using mean (ignoring NaNs): shape={mean.shape}, values≈{np.mean(mean)}")
    #print('number of nans in data', np.isnan(data).sum(axis=(0, 2)))

    print('number of nans when using nan mean', np.isnan(mean).sum(axis=(0, 2)))
    print('number of nans when using nan mean', np.isnan(mean_orig).sum(axis=(0, 2)))

    nan_means_custom_function.append({'subID': i, 'nan_mean': np.isnan(mean).sum(axis=(0, 2)), 'orig_mean': np.isnan(mean_orig).sum(axis=(0, 2))})
    print(nan_means_custom_function)
    if mode == "mean":
        def fun(d, m):
            d -= m
    elif mode == "ratio":
        def fun(d, m):
            d /= m
    elif mode == "logratio":
        def fun(d, m):
            d /= m
            np.log10(d, out=d)
    elif mode == "percent":
        def fun(d, m):
            d -= m
            d /= m
    elif mode == "zscore":
        def fun(d, m):
            d -= m
            d /= np.nanstd(d[..., imin:imax], axis=-1, keepdims=True)
    elif mode == "zlogratio":
        def fun(d, m):
            d /= m
            np.log10(d, out=d)
            d /= np.nanstd(d[..., imin:imax], axis=-1, keepdims=True)
    else:
        raise ValueError(f"Unknown mode {mode}")

    if picks is None:
        fun(data, mean)
    else:
        for pi in picks:
            fun(data[..., pi, :], mean[..., pi, :])

    return data


# %%
# appending all epochs into one list while:
# combining both pupil channels (using nanmean)
# applying baseline
# seperating by condition
# cropping according to condition
# averaging epochs (using nanmean)

# and then shifting so that delay onset is the same for all conditions


evoked_df = pd.DataFrame()

for i in good_partis:
    
    # reading epochs per participant
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Epochs_even_newer"
    epoch_file = folder_path + "/" + i + "_even_newer-epo.fif"
    pupil_epoch = mne.read_epochs(epoch_file, preload=True, verbose=None)

    # print(pupil_epoch.to_data_frame().isna().sum())
    print(" NaNs in original epochs:", np.isnan(pupil_epoch.get_data()).any())
    # combining channels
    pupil_ix = mne.pick_channels(pupil_epoch.info["ch_names"], include=['pupil_left', 'pupil_right'])
    roi_dict = dict(pupils=pupil_ix)
    combine_nanmean = lambda data: np.nanmean(data, axis=1)
    pupil_epochs_combined = mne.channels.combine_channels(pupil_epoch, roi_dict, method=combine_nanmean)

    print(" NaNs in combined epochs:", np.isnan(pupil_epochs_combined.get_data()).any())
    # applying baseline
    # pupil_epochs_combined_bl = pupil_epochs_combined.apply_baseline(baseline=(-0.1, 0))
    # baseline = pupil_epochs_combined.baseline


    baseline=(-0.1, 0)
    pupil_epochs_combined._data = rescale_nanaware(
        pupil_epochs_combined._data,
        pupil_epochs_combined.times,
        baseline=baseline,
        mode="mean",
        copy=False,
        picks=pupil_epochs_combined._detrend_picks,
    )

    pupil_epochs_combined_bl = pupil_epochs_combined

    print(" NaNs in baselined epochs:", np.isnan(pupil_epochs_combined_bl.get_data()).any())
    # seperating per load condition
    con1_epochs = pupil_epochs_combined_bl["items_presented == 1"]
    con2_epochs = pupil_epochs_combined_bl["items_presented == 2"]
    con3_epochs = pupil_epochs_combined_bl["items_presented == 3"]

    # shortening the epochs based on condition (crop defaults to inclduing tmax)
    con1_epochs.crop(-0.1, 7)
    con2_epochs.crop(-0.1, 8)
    con3_epochs.crop(-0.1, 9)

    # averaging per load condition
    # leading to error because there are some epochs that are only nan for pupils?
    evoked_nan_mean = lambda x: np.nanmean(x, axis=0)
    con1_ave = con1_epochs.average(method=evoked_nan_mean)
    con2_ave = con2_epochs.average(method=evoked_nan_mean)
    con3_ave = con3_epochs.average(method=evoked_nan_mean)

    # adding individual averaged data to dataframe including load and subID
    con1_ave_df = con1_ave.to_data_frame()
    con1_ave_df['Load'] = 1
    con1_ave_df['subID'] = i
    con2_ave_df = con2_ave.to_data_frame()
    con2_ave_df['Load'] = 2
    con2_ave_df['subID'] = i
    con3_ave_df = con3_ave.to_data_frame()
    con3_ave_df['Load'] = 3
    con3_ave_df['subID'] = i

    # concatenating to evoked_df
    evoked_df = pd.concat([evoked_df, con1_ave_df])
    evoked_df = pd.concat([evoked_df, con2_ave_df])
    evoked_df = pd.concat([evoked_df, con3_ave_df])
    evoked_df['baseline_start'] = baseline[0]
    evoked_df['baseline_end'] = baseline[1]

# evoked_df = evoked_df.reset_index()

# evoked_df.to_csv('../data/csv_files/evoked_df.csv', index=False)

# %%

# shifting the conditions so that the epochs that are epoched on pos1 are time-locked to the test onset
evoked_df_shifted = evoked_df.copy()
evoked_df_shifted.loc[evoked_df_shifted['Load']==1, 'time'] +=2
evoked_df_shifted.loc[evoked_df_shifted['Load']==2, 'time'] +=1
evoked_df_shifted.loc[evoked_df_shifted['Load']==3, 'time'] +=0



# %%
