# %%

# new evoked creation with baselining per channel first and then nan sensitive combining of channels

# %%
import mne
import pandas as pd
import numpy as np

# Load metadata
df = pd.read_csv('../data/csv_files/df.csv')
good_partis = df['subID'].unique()

drop_log_rows = []
evoked_df = pd.DataFrame()

# ---- params ----
bmin, bmax = -0.1, 0.0  # baseline window

for i in good_partis:
    # read epochs per participant (2 channels: 'pupil_left', 'pupil_right')
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Epochs_even_newer"
    epoch_file = folder_path + "/" + i + "_even_newer-epo.fif"
    pupil_epoch = mne.read_epochs(epoch_file, preload=True, verbose=None)

    # indices of the two eye channels (robust even if channel order changes)
    ch_names = pupil_epoch.ch_names
    ix_left  = ch_names.index('pupil_left')
    ix_right = ch_names.index('pupil_right')
    eye_idx = [ix_left, ix_right]

    # get data & times
    data = pupil_epoch.get_data()        # shape (E, 2, T)
    times = pupil_epoch.times

    # baseline indices
    imin = np.where(times >= bmin)[0][0]
    imax = np.where(times <= bmax)[0][-1] + 1

    # --- compute per-eye baseline means (NaN-aware) ---
    bl_mean = np.nanmean(data[:, eye_idx, imin:imax], axis=-1, keepdims=True)  # (E,2,1)
    bl_mean_s = bl_mean.squeeze(-1)  # (E,2)

    # --- drop epochs where BOTH eyes have baseline fully NaN ---
    both_nan = np.all(np.isnan(bl_mean_s), axis=1)  # (E,)
    bad_epoch_indices = np.where(both_nan)[0]
    if bad_epoch_indices.size > 0:
        pupil_epoch.drop(bad_epoch_indices, reason='BAD_baseline_nan_both_eyes')
        drop_log_rows.append({
            'subID': i,
            'num_bad_epochs': int(bad_epoch_indices.size),
            'bad_epoch_indices': bad_epoch_indices.tolist(),
        })
        # refresh after drop
        data = pupil_epoch.get_data()
        # recompute baseline means since E changed
        bl_mean = np.nanmean(data[:, eye_idx, imin:imax], axis=-1, keepdims=True)
        bl_mean_s = bl_mean.squeeze(-1)

    # --- subtract baseline per eye where finite; else null that eye for the whole epoch ---
    E = data.shape[0]
    for e in range(E):
        # left eye
        if np.isfinite(bl_mean_s[e, 0]):
            data[e, ix_left, :] = data[e, ix_left, :] - bl_mean[e, 0, 0]
        else:
            data[e, ix_left, :] = np.nan
        # right eye
        if np.isfinite(bl_mean_s[e, 1]):
            data[e, ix_right, :] = data[e, ix_right, :] - bl_mean[e, 1, 0]
        else:
            data[e, ix_right, :] = np.nan

    # write back baselined data
    pupil_epoch._data = data

    # --- combine eyes with nanmean into single 'pupils' channel ---
    roi_dict = dict(pupils=eye_idx)
    combine_nanmean = lambda x: np.nanmean(x, axis=1)  # average across the 2 eye channels
    pupil_epochs_combined_bl = mne.channels.combine_channels(
        pupil_epoch, roi_dict, method=combine_nanmean
    )
    # store baseline window for provenance
    pupil_epochs_combined_bl.baseline = (bmin, bmax)

    # --- separate by condition ---
    con1_epochs = pupil_epochs_combined_bl["items_presented == 1"]
    con2_epochs = pupil_epochs_combined_bl["items_presented == 2"]
    con3_epochs = pupil_epochs_combined_bl["items_presented == 3"]

    # --- crop by condition (tmax inclusive by default) ---
    con1_epochs.crop(-0.1, 7)
    con2_epochs.crop(-0.1, 8)
    con3_epochs.crop(-0.1, 9)

    # --- average per condition (NaN-aware) ---
    evoked_nan_mean = lambda x: np.nanmean(x, axis=0)
    con1_ave = con1_epochs.average(method=evoked_nan_mean)
    con2_ave = con2_epochs.average(method=evoked_nan_mean)
    con3_ave = con3_epochs.average(method=evoked_nan_mean)

    # --- collect into tidy DF ---
    con1_ave_df = con1_ave.to_data_frame()
    con1_ave_df['Load'] = 1
    con1_ave_df['subID'] = i

    con2_ave_df = con2_ave.to_data_frame()
    con2_ave_df['Load'] = 2
    con2_ave_df['subID'] = i

    con3_ave_df = con3_ave.to_data_frame()
    con3_ave_df['Load'] = 3
    con3_ave_df['subID'] = i

    evoked_df = pd.concat([evoked_df, con1_ave_df, con2_ave_df, con3_ave_df], ignore_index=True)

# summarize drops
drop_log_df = pd.DataFrame(drop_log_rows, columns=['subID', 'num_bad_epochs', 'bad_epoch_indices'])

# clean index
evoked_df = evoked_df.reset_index(drop=True)

# %%
# shifting the conditions so that the epochs that are epoched on pos1 are time-locked to the test onset
evoked_df_shifted = evoked_df.copy()
evoked_df_shifted.loc[evoked_df_shifted['Load']==1, 'time'] +=2
evoked_df_shifted.loc[evoked_df_shifted['Load']==2, 'time'] +=1
evoked_df_shifted.loc[evoked_df_shifted['Load']==3, 'time'] +=0



# %%
mask_partis = df[df['mask']==1]['subID'].unique().tolist()
nomask_partis = df[df['mask']==0]['subID'].unique().tolist()
# Adding column for mask
evoked_df_shifted['mask'] = evoked_df_shifted['subID'].apply(
    lambda x: 1 if x in mask_partis else 0)



