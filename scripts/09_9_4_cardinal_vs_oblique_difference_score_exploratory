# %%
# difference scores (cardinal_diff_score) grouped by load × mask
# using permutation_cluster_1samp_test

results_diff = {}

for mask_val in df_card_diffs_per_t['mask'].unique():
    for load_val in df_card_diffs_per_t['load'].unique():
        
        subset = df_card_diffs_per_t[
            (df_card_diffs_per_t['mask'] == mask_val) &
            (df_card_diffs_per_t['load'] == load_val)
        ]
        
        # Pivot: subjects × timepoints
        X = subset.pivot(index='subID', columns='time',
                         values='cardinal_diff_score').to_numpy()
        
        times = subset['time'].unique()
        times.sort()

        # Cluster permutation test (one-sample t-test vs 0)
        T_obs, clusters, cluster_p_values, H0 = permutation_cluster_1samp_test(
            X,
            n_permutations=5000,
            threshold=2.0,   # use t-distribution cutoff automatically
            tail=0,           # two-tailed test
            out_type='mask',
            verbose=True
        )

        print(cluster_p_values)
        
        results_diff[(mask_val, load_val)] = (T_obs, clusters, cluster_p_values, times)
        
        # Plot
        plt.figure(figsize=(10, 5))
        plt.plot(times, T_obs, label="Observed t-values")
        plt.axhline(0, color='black', linestyle='--')
        
        # Highlight significant clusters
        for i_c, c in enumerate(clusters):
            if cluster_p_values[i_c] < 0.05:
                plt.axvspan(times[c][0], times[c][-1], color='red', alpha=0.3)
        
        plt.title(f"Mask={mask_val}, Load={load_val} | Cluster Permutation (Diff vs 0)")
        plt.xlabel("Time")
        plt.ylabel("t-statistic")
        plt.legend()
        plt.show()



# %%
# collapsing load conditions and just comparing diff scores between mask and no mask


all_summaries = []

for mask_val in [0, 1]:
    # Take only this mask group's difference scores
    dfm = df_card_diffs_per_t[df_card_diffs_per_t['mask'] == mask_val]

    # Build subject×time matrices per load
    P1 = dfm[dfm['load'] == 1].pivot(index='subID', columns='time', values='cardinal_diff_score')
    P2 = dfm[dfm['load'] == 2].pivot(index='subID', columns='time', values='cardinal_diff_score')
    P3 = dfm[dfm['load'] == 3].pivot(index='subID', columns='time', values='cardinal_diff_score')

    # Align subjects and timepoints across all three loads
    common_subs = P1.index.intersection(P2.index).intersection(P3.index)
    common_times = P1.columns.intersection(P2.columns).intersection(P3.columns)
    common_times = np.array(sorted(common_times))  # ensure increasing order

    X1 = P1.loc[common_subs, common_times].to_numpy()
    X2 = P2.loc[common_subs, common_times].to_numpy()
    X3 = P3.loc[common_subs, common_times].to_numpy()

    # Average across loads per subject & time (equal weight for each load)
    X_mean = np.nanmean(np.stack([X1, X2, X3], axis=0), axis=0)  # shape: (n_subjects, n_times)

    print(f"Running 1-sample cluster test vs 0 for mask={mask_val} on averaged (across loads) difference scores...")
    T_obs, clusters, cluster_p_values, H0 = permutation_cluster_1samp_test(
        X_mean,
        n_permutations=5000,   # increase if you want finer p-values
        threshold=2.0,        # data-driven t-threshold
        tail=0,                # two-tailed (diff could be >0 or <0)
        out_type='mask',
        verbose=True
    )
    print(cluster_p_values)

    # Summarize significant clusters and store
    alpha = 0.05
    for i_c, c in enumerate(clusters):
        p = float(cluster_p_values[i_c])
        if p < alpha:
            # c is a boolean mask over time
            t_vals = T_obs[c]
            mean_t = float(np.mean(t_vals))
            start_t = float(times[c][0])
            end_t   = float(times[c][-1])

            all_summaries.append({
                "mask": mask_val,
                "cluster_id": i_c + 1,
                "start_time": start_t,
                "end_time": end_t,
                "p_value": p,
                "mean_t": mean_t,
                "direction": "cardinal > oblique" if mean_t > 0 else "oblique > cardinal"
            })

    # Plot T_obs with significant clusters shaded
    plt.figure(figsize=(10, 5))
    plt.plot(times, T_obs, label="t-values")
    plt.axhline(0, color='k', linestyle='--', linewidth=0.8)
    for i_c, c in enumerate(clusters):
        if cluster_p_values[i_c] < alpha:
            plt.axvspan(times[c][0], times[c][-1], color='red', alpha=0.3)
    plt.title(f"Diff scores (cardinal − oblique), averaged across loads | mask={mask_val}")
    plt.xlabel("Time (s)")
    plt.ylabel("t-statistic")
    plt.legend()
    plt.tight_layout()
    plt.show()

# Save cluster summaries
cluster_df = pd.DataFrame(all_summaries)
cluster_df.to_csv("cluster_diffscore_avgAcrossLoads_perMask.csv", index=False)
print("Saved:", "cluster_diffscore_avgAcrossLoads_perMask.csv")
print(cluster_df)

