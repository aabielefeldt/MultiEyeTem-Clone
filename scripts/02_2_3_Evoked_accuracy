
# %%
# Importsconda
import mne
import pandas as pd
import numpy as np
from pupil_utils import apply_baseline_nan_aware

# %% Load Metadata

df = pd.read_csv('../data/csv_files/df.csv')
good_partis = df['subID'].unique()

# %%
# if qt is used as backend the kernel crashes
# mne.viz.set_browser_backend('matplotlib')

# %%
# appending all epochs into one list while:
# combining both pupil channels
# applying baseline
# seperating by condition and accuracy
# cropping according to condition
# averaging epochs
drop_log_rows = []
evoked_list = []
len_epochs = []

for i in good_partis: 
    # reading epochs per participant 
    folder_path = "/mnt/home/bielefeldt/MPIB-SRT/879-multieyetem/multieyetem/data/Epochs_even_newer" 
    epoch_file = folder_path + "/" + i + "_even_newer-epo.fif" 
    pupil_epoch = mne.read_epochs(epoch_file, preload=True, verbose=None) 

    # applying baseline per eye and nan aware while dropping any epochs where the baseline period was nan in both eyes
    pupil_epoch_bl = apply_baseline_nan_aware(pupil_epoch, bmin=-0.1, bmax=0.0)
    baseline = pupil_epoch_bl.baseline
    
    # counting dropped epochs
    sum_dropped = sum('BAD_baseline_nan_both_eyes' in entry for entry in pupil_epoch_bl.drop_log)
    drop_log_rows.append({'subID': i, 'sum_dropped': sum_dropped})

    # combining channels
    pupil_ix = mne.pick_channels(pupil_epoch_bl.info["ch_names"], include=['pupil_left', 'pupil_right'])
    roi_dict = dict(pupils=pupil_ix)
    combine_nanmean = lambda data: np.nanmean(data, axis=1)
    pupil_epochs_combined_bl = mne.channels.combine_channels(pupil_epoch_bl, roi_dict, method=combine_nanmean)

    # seperating per load and accuracy condition 
    con1_epochs_pos1 = pupil_epochs_combined_bl["items_presented == 1"] 
    con1_epochs_correct = con1_epochs_pos1["acc_trial_concrete_cued == 1"] 
    con1_epochs_false = con1_epochs_pos1["acc_trial_concrete_cued == 0"] 
    con2_epochs_pos1 = pupil_epochs_combined_bl["items_presented == 2"] 
    con2_epochs_correct = con2_epochs_pos1["acc_trial_concrete_cued == 1"] 
    con2_epochs_false = con2_epochs_pos1["acc_trial_concrete_cued == 0"] 
    con3_epochs_pos1 = pupil_epochs_combined_bl["items_presented == 3"] 
    con3_epochs_correct = con3_epochs_pos1["acc_trial_concrete_cued == 1"] 
    con3_epochs_false = con3_epochs_pos1["acc_trial_concrete_cued == 0"] 
    
    len_epochs.append({'subID': i, 
                       'len_1_c': (con1_epochs_correct.__len__()),
                       'len_1_f': (con1_epochs_false.__len__()),
                       'len_2_c': (con2_epochs_correct.__len__()),
                       'len_2_f': (con2_epochs_false.__len__()),
                       'len_3_c': (con3_epochs_correct.__len__()),
                       'len_3_f': (con3_epochs_false.__len__())})
    # shortening the epochs based on condition (crop defaults to inclduing tmax) 
    con1_epochs_correct.crop(-0.1, 7) 
    con2_epochs_correct.crop(-0.1, 8) 
    con3_epochs_correct.crop(-0.1, 9) 
    con1_epochs_false.crop(-0.1, 7) 
    con2_epochs_false.crop(-0.1, 8) 
    con3_epochs_false.crop(-0.1, 9) 

    # averaging per load condition 
    evoked_nan_mean = lambda x: np.nanmean(x, axis=0) 
    con1_ave_correct = con1_epochs_correct.average(method=evoked_nan_mean) 
    con2_ave_correct = con2_epochs_correct.average(method=evoked_nan_mean) 
    con3_ave_correct = con3_epochs_correct.average(method=evoked_nan_mean) 
    con1_ave_false = con1_epochs_false.average(method=evoked_nan_mean) 
    con2_ave_false = con2_epochs_false.average(method=evoked_nan_mean) 
    con3_ave_false = con3_epochs_false.average(method=evoked_nan_mean) 

    # adding individual averaged data to dataframe including load and subID 
    # Correct trials 
    con1_ave_df_correct = con1_ave_correct.to_data_frame(scalings=1) 
    con1_ave_df_correct['Load'] = 1 
    con1_ave_df_correct['subID'] = i 
    con1_ave_df_correct['accuracy'] = 'correct' 
    con2_ave_df_correct = con2_ave_correct.to_data_frame(scalings=1) 
    con2_ave_df_correct['Load'] = 2 
    con2_ave_df_correct['subID'] = i 
    con2_ave_df_correct['accuracy'] = 'correct' 
    con3_ave_df_correct = con3_ave_correct.to_data_frame(scalings=1) 
    con3_ave_df_correct['Load'] = 3 
    con3_ave_df_correct['subID'] = i 
    con3_ave_df_correct['accuracy'] = 'correct' 

    # False trials 
    con1_ave_df_false = con1_ave_false.to_data_frame(scalings=1) 
    con1_ave_df_false['Load'] = 1 
    con1_ave_df_false['subID'] = i 
    con1_ave_df_false['accuracy'] = 'false' 
    con2_ave_df_false = con2_ave_false.to_data_frame(scalings=1) 
    con2_ave_df_false['Load'] = 2 
    con2_ave_df_false['subID'] = i 
    con2_ave_df_false['accuracy'] = 'false' 
    con3_ave_df_false = con3_ave_false.to_data_frame(scalings=1) 
    con3_ave_df_false['Load'] = 3 
    con3_ave_df_false['subID'] = i 
    con3_ave_df_false['accuracy'] = 'false' 

    # extending evoked list
    evoked_list.extend([con1_ave_df_correct, con2_ave_df_correct, con3_ave_df_correct, con1_ave_df_false, con2_ave_df_false, con3_ave_df_false])

drop_log_df = pd.DataFrame(drop_log_rows)

evoked_df_accuracy = pd.concat(evoked_list, ignore_index=True)

# evoked_df_accuracy['baseline_start'] = baseline[0] 
# evoked_df_accuracy['baseline_end'] = baseline[1] 
drop_log_df.to_csv('../data/csv_files/drop_log_df_evoked_accuracy.csv', index=False)
evoked_df_accuracy.to_csv('../data/csv_files/evoked_df_accuracy.csv', index=False)
#%%
acc_trials_num_per_epoch = pd.DataFrame(len_epochs)
acc_trials_num_per_epoch.to_csv('../data/csv_files/acc_trials_num_per_epoch.csv', index=False)
# %%
# Shifting

# shifting the conditions so that the epochs that are epoched on pos1 are time-locked to the test onset
evoked_df_accuracy_shifted = evoked_df_accuracy.copy()
evoked_df_accuracy_shifted.loc[evoked_df_accuracy_shifted['Load']==1, 'time'] +=2
evoked_df_accuracy_shifted.loc[evoked_df_accuracy_shifted['Load']==2, 'time'] +=1
evoked_df_accuracy_shifted.loc[evoked_df_accuracy_shifted['Load']==3, 'time'] +=0

# %%
# adding mask to the evoked dataframe
mask_partis = df[df['mask']==1]['subID'].unique().tolist()
nomask_partis = df[df['mask']==0]['subID'].unique().tolist()

evoked_df_accuracy_shifted['mask'] = evoked_df_accuracy_shifted['subID'].apply(
    lambda x: 1 if x in mask_partis else 0)

# also include rounding here
evoked_df_accuracy_shifted['time'] = evoked_df_accuracy_shifted['time'].round(3)
evoked_df_accuracy_shifted.to_csv('../data/csv_files/evoked_df_accuracy_shifted.csv', index=False)

# %%
